12/11/2025 17:19:25 - Swati Dongare (Work notes)
DECLARE @LoggedOnTerminal int
        ,	@LoggedOnPharmacy int
        ,	@eMMSupplyNoteTypeID int
        ,	@ShowAll bit
    
    SELECT @LoggedOnTerminal  = LocationID FROM Session WHERE SessionID = @CurrentSessionID
    SELECT @LoggedOnPharmacy = icwsys.fStockholdingByChildLocation(@LoggedOnTerminal)
    SELECT @eMMSupplyNoteTypeID = NoteTypeID FROM NoteType WHERE [Description] = 'eMMSupply'
    
    IF EXISTS (	SELECT TOP 1 1 
                FROM
                    Location
                    JOIN Ward ON Location.LocationID = Ward.LocationID
                WHERE
                    Location.LocationID_Parent = @LoggedOnPharmacy
                )
    BEGIN
        SET @ShowAll = 0
    END
    ELSE
    BEGIN
        SET @ShowAll = 1
    END
    
    --Prescriptions which 
    -- Are Active
    -- Have an active Supply Request
    -- Have been clinically checked
    -- Were made for a patient who is in a ward which is supplied by the pharmacy the user is in.
    
    SELECT
            Request.RequestID
        ,	L.[Description] + ' - '
            +	upper(Person.Surname) + ', '
            +	isnull(Person.Forename + ' ', '')
            +	isnull('(' + convert(varchar(10), Patient.DOB, 103) + ')', '') 
            +	' - '
            +	Request.[Description] AS [Description]
        ,	convert(varchar(10), Note.CreatedDate, 103) + ' ' + convert(varchar(5), Note.CreatedDate, 108) AS 'Date'
        ,	CASE
                WHEN eMMSupply.Priority = 1 THEN '**PRIORITY** '
                ELSE ''
            END
            +	'by ' + Entity.[Description] 
            +	isnull(' - ' + eMMSupply.Comments, '')
            +CASE
                WHEN RS.Discharge = 1 THEN '(TTO - NOT to be continued)'
                WHEN RS.DischargeContinue = 1 THEN '(TTO - to be continued)'
                WHEN RS.DischargeGP = 1 THEN '(TTO - to be continued by GP)'
                WHEN RS.DischargeHospital = 1 THEN '(TTO - to be continued by Hospital)'
                ELSE '(Not for discharge)'
            END AS 'Status'
        ,	Request.TableID
        ,	Request.RequestTypeID
        ,	'' + RT.[Description] AS 'RequestType'
        ,	0 + RS.Mortal AS 'Mortal'
        ,	0 + RS.[Request Cancellation] AS 'Cancelled'
        ,	0 + RS.[Attached Note] AS 'AttachedNotesExist'
        ,	0 + RS.Responses AS 'Responses'
        ,	0 + RS.Complete AS 'FullyResulted'
        ,	0 + EO.EpisodeID AS 'EpisodeID'
        ,	0 + P.ProductID AS 'ProductID'
        ,	CASE 
				WHEN pct.[Description] = 'Homely Remedy' THEN 1
				ELSE 0
			END AS 'HomelyRemedy'
    FROM
        Request 
        JOIN RequestStatus RS ON Request.RequestID = RS.RequestID
        LEFT JOIN Prescription P ON Request.RequestID = P.RequestID
		LEFT JOIN GenericPrescription GP ON Request.RequestID = GP.RequestID
        JOIN PrescriptionCreationType PCT ON P.PrescriptionCreationTypeID = PCT.PrescriptionCreationTypeID
        LEFT JOIN ProductOrder PO ON Request.RequestID = PO.RequestID
        JOIN RequestType RT ON Request.RequestTypeID = RT.RequestTypeID
        JOIN EpisodeOrder EO ON Request.RequestID = EO.RequestID
        JOIN Episode E ON EO.EpisodeID = E.EpisodeID
        JOIN EpisodeLocation EL ON E.EpisodeID = EL.EpisodeID
        JOIN Ward ON EL.LocationID = Ward.LocationID
        JOIN Location L ON EL.LocationID = L.LocationID
        JOIN Person ON E.EntityID = Person.EntityID
        JOIN Patient ON Person.EntityID = Patient.EntityID
        JOIN RequestLinkAttachedNote RLAN ON Request.RequestID = RLAN.RequestID
        JOIN Note ON RLAN.NoteID = Note.NoteID
        JOIN AttachedNote AN ON Note.NoteID = AN.NoteID
        JOIN eMMSupply ON Note.NoteID = eMMSupply.NoteID
        JOIN Entity ON Note.ENtityID = Entity.EntityID
    WHERE
		RS.eMMSupply__NoteID <> 0
		AND
        RS.eMMSupply = 1 --Active Supply Request	
        AND --Not Expired
            (
                (P.StopDate IS NULL
                OR
                (
                    datediff(day, getdate(), P.StopDate) >= 0
                ))
				OR
				(GP.StopDate_GenericPrescription IS NULL
				OR
				(
					datediff(day, getdate(), GP.StopDate_GenericPrescription) >= 0
				))
            )
        AND RS.[Request Cancellation] = 0
        AND EL.Active = 1
        AND RS.Screen = 1
        AND AN.Enabled = 1
        AND Note.NoteTypeID = @eMMSupplyNoteTypeID
        AND (
                @ShowAll = 1
                OR
                [icwsys].fStockholdingByChildLocation(L.locationid) = @LoggedOnPharmacy
            )
        AND (
				P.RequestID IS NOT NULL 
				OR
				GP.RequestID IS NOT NULL
				OR
				PO.RequestID IS NOT NULL
			)
    ORDER BY
            eMMSupply.Priority DESC
        ,	Note.CreatedDate
    FOR XML AUTO

