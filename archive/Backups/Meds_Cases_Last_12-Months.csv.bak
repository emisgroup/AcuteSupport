select distinct ([user]) as 'Auditlog Identifier', 
u.Username as 'Login Username',
concat(p.forename, ' ' , p.surname) as 'Actual Name',
max(al.CreatedDate) as 'Timestamp'
from auditlog al
join [user] u on al.EntityID_User = u.EntityID
join Person p on al.EntityID_User = p.EntityID
where createddate between GETDATE()-1 and GETDATE()
and dataxml like '%locationid%'
and al.locationid = 0
and [table] not like '%sessionattribute%'
group by al.[user], u.Username, p.Forename,p.Surname
order by Timestamp desc

