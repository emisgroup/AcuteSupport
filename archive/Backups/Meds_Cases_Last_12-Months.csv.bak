                         SpecialtyID, AdminOrder
FROM            v_Fact_ResponseActivity
    ) [Fact_ResponseActivity]
    LEFT OUTER JOIN (
        SELECT
            [Product].[Product] [Product],
            [Product].[ProductID] [ProductID],
            [Fact_Prescription].[PrescriptionID] [Prescription],
            [Fact_Prescription].[PrescriptionID] [PrescriptionID],
            [ProductRoute].[ProductRoute] [ProductRoute],
            [ProductRoute].[ProductRouteProductRouteDesc] [ProductRouteProductRouteDesc],
            [Patient].[NHSNumber] [NHSNumber],
            [Patient].[Patient3] [Patient3],
            [Patient].[Patient1] [Patient1],
            [Product].[Product1] [Product1],
            [Product].[ProductProductDesc] [ProductProductDesc],
            [Patient].[Patient] [Patient],
            [Patient].[CaseNumber] [CaseNumber],
            [Fact_Episode].[Name] [Name],
            [Fact_Episode].[CaseNumber] [CaseNumber2],
            [Fact_Episode].[NHSNumber] [NHSNumber2],
            [PrescriptionCreationType].[PrescriptionCreationDesc] [PrescriptionCreationDesc],
            [Fact_Prescription].[PrescriptionID] [PrescriptionID2]
        FROM
            (
                SELECT        PrescriptionID, PrescriptionID_Original, EpisodeID, ProductID, PrescriptionStartDateID, PrescriptionStartTimeID, PrescriptionStopDateID, 
                         PrescriptionStopTimeID, ProductRouteID, ScheduleID, PrescriptionCreationTypeID, PrescriptionTypeID, PrescribedByID, OwnerID, PatientID, 
                         PrescriptionStartDateTime, PrescriptionStopDateTime, InOnFormulary, PatientOwn, SelfAdmin, SupervisedAdmin, duration, DurationLow, Rate, RateMin, 
