23/07/2025 17:55:34 - Swati Dongare (Work notes)
DECLARE
        @CurrentSessionID int
    ,   @EpisodeID int
    ,   @UserID int
    ,   @TerminalID int
    ,   @ParentID int
    ,   @FirstRow int
    ,   @LastRow int
	,   @Ward int
    
    

    Set @CurrentSessionID = 20434298
    Select @EpisodeID = [PrimaryKey] From State s Join [Table] t on s.TableID = t.TableID Where s.SessionID=20434298 and t.Description = 'Episode'
    Select  @UserID = EntityID From Session where SessionID = 20434298
    Set @TerminalID = NULL
    Set @ParentID = NULL
    Set @FirstRow = 1
    Set @LastRow = 20
	set @Ward =15043

------------------------------------------ End Variables - Do not paste text above this line back into Worklist Editor -----------------------------------------------------

SELECT @Ward = -1 WHERE @Ward IS NULL
	IF @Ward = ''
	BEGIN
		SELECT TOP 1
				0 AS 'ID'
			,	'ERROR: Please select a Ward above' AS 'Text'
			,	'' AS 'Date'
			,	'' AS 'Status'
			,	'Request' AS 'class'
		RETURN
	END


	DELETE
		SessionAttribute
	WHERE
		SessionID = @CurrentSessionID
		AND Attribute IN ('ScheduledDrugAdmin_SelectedWard', 'ScheduledDrugAdmin_SelectedConsultant')
  
	IF @CurrentSessionID > 0
	BEGIN
		INSERT SessionAttribute (SessionID, Attribute, Value)
		SELECT @CurrentSessionID, 'ScheduledDrugAdmin_SelectedWard', convert(varchar(12), @Ward)
	END

	DECLARE @AliasGroup_PPI varchar(128)
	  ,  @AliasGroup_SPI varchar(128)

	SELECT 
		@AliasGroup_PPI = Setting.Value
	FROM
		Setting
	WHERE 
			Setting.[System] = 'General' 
		AND Setting.[Section] = 'PatientEditor' 
		AND Setting.[Key] = 'PrimaryPatientIdentifier' 
		AND Setting.RoleID = 0
   
   
	SELECT 
		@AliasGroup_SPI = Setting.Value
	FROM
		Setting
	WHERE 
			Setting.[System] = 'General' 
		AND Setting.[Section] = 'PatientEditor' 
		AND Setting.[Key] = 'SecondaryPatientIdentifier' 
		AND Setting.RoleID = 0
    
	DECLARE @DisplayName_PPI varchar(128)
	  ,  @DisplayName_SPI varchar(128)
  
	SELECT @DisplayName_PPI = DisplayName FROM AliasGroup WHERE [Description] = @AliasGroup_PPI
	SELECT @DisplayName_SPI = DisplayName FROM AliasGroup WHERE [Description] = @AliasGroup_SPI

	DECLARE @Now datetime
	SELECT @Now = dateadd(minute, -1, getdate())

	DECLARE @MaxDurationMinutes int
	SELECT 
		@MaxDurationMinutes = Value 
	FROM 
		Setting 
	WHERE
		[System] = 'OCS' 
		AND [Section] = 'DrugAdministration' 
		AND [Key] = 'MaxDurationMinutes'    

	DECLARE @MaxMinutesEarly int
	SELECT 
		@MaxMinutesEarly = Value 
	FROM 
		Setting 
	WHERE
		[System] = 'OCS'
		AND [Section] = 'DrugAdministration'
		AND [Key] = 'MaxMinutesEarly'   

	-- 83316 Start
	DECLARE @AdministerLifeTimeEpisode int
	SELECT 
		@AdministerLifeTimeEpisode = Value 
	FROM 
		Setting 
	WHERE
		[System] = 'OCS' 
		AND [Section] = 'DrugAdministration' 
		AND [Key] = 'AdministerLifeTimeEpisode'    
	-- 83316 End 
    
	CREATE TABLE #Patients
	(
		EntityID int,
		RequestID int,
		RequestType__Description varchar(50),
		WardID int,
		EpisodeID int,
		EpisodeID_Parent int
	)
	
	IF @Ward = -1
	BEGIN
	  -- Search by open episodes first (when there is no ward speicified) to make the more complex joins on a smaller recordset
		INSERT INTO #Patients
		SELECT Episode.EntityID, RequestStatus.RequestID,RequestStatus.RequestType__Description, -1, Episode.EpisodeID, Episode.EpisodeID_Parent
		FROM Episode
		JOIN EpisodeOrder ON Episode.EpisodeID = EpisodeOrder.EpisodeID
		JOIN RequestStatus WITH (FORCESEEK) ON EpisodeOrder.RequestID = RequestStatus.RequestID
		JOIN Request ON EpisodeOrder.RequestID = Request.RequestID
		JOIN RequestType ON Request.RequestTypeID = RequestType.RequestTypeID
		WHERE Episode.EndDate IS NULL
		AND (@AdministerLifeTimeEpisode = 1 or (@AdministerLifeTimeEpisode <> 1 and Episode.EpisodeID_Parent > 0)) -- 83316
		AND RequestType.Description IN ('Standard Prescription', 'Doseless Prescription', 'Infusion Prescription', 'Enteral Prescription', 'Generic Prescription', 'Order Set') -- We only need prescriptions, we check the admins later
		END
	ELSE
	BEGIN
		-- Search by ward and open episode first to make the more complex joins on a smaller recordset
		INSERT INTO #Patients
		SELECT Episode.EntityID, RequestStatus.RequestID,RequestStatus.RequestType__Description, Ward.LocationID, Episode.EpisodeID, Episode.EpisodeID_Parent
		FROM Ward
		JOIN EpisodeLocation ON Ward.LocationID = EpisodeLocation.LocationID AND  EpisodeLocation.Active = 1  
		JOIN Episode ON EpisodeLocation.EpisodeID = Episode.EpisodeID
		JOIN EpisodeOrder ON Episode.EpisodeID = EpisodeOrder.EpisodeID
		JOIN RequestStatus WITH (FORCESEEK) ON EpisodeOrder.RequestID = RequestStatus.RequestID
		JOIN Request ON EpisodeOrder.RequestID = Request.RequestID
		JOIN RequestType ON Request.RequestTypeID = RequestType.RequestTypeID
		WHERE Ward.LocationID = @Ward AND Episode.EndDate IS NULL
		AND (@AdministerLifeTimeEpisode = 1 or (@AdministerLifeTimeEpisode <> 1 and Episode.EpisodeID_Parent > 0)) -- 83316
		AND RequestType.Description IN ('Standard Prescription', 'Doseless Prescription', 'Infusion Prescription', 'Enteral Prescription', 'Generic Prescription', 'Order Set') -- We only need prescriptions, we check the admins later
		END

	CREATE TABLE #Results 
	(	EntityID int,
		ID int,
		Surname varchar(256),
		Forename varchar(256),
		PrimaryAlias varchar(256),
		SecondaryAlias varchar(256),
		DOB datetime,
		[Date] varchar(256),
		[Status] varchar(256),
		Class varchar(256),
		Query  varchar(256),
		[Rowcount] int,
		[RowNumber] int
	)  

	Insert into #Results
		SELECT  #Patients.EntityID,
				#Patients.EpisodeID AS 'ID'
			,   null--Person.Surname
			,	null--Person.Forename
			,	null--isnull(' (' + icwsys.fFormatID(EntityAlias.Alias, AliasGroup.Format) + ')', ' (' + @DisplayName_PPI + ' unknown)') 
			,	null--isnull(' (' + icwsys.fFormatID(EA_SPI.Alias, AG_SPI.Format) + ')', ' (' + @DisplayName_SPI + ' unknown)')  
			,	null--Patient.DOB
			, '' AS 'Date'
			,   
				CASE  
					WHEN Sum(Convert(int,isnull(DSSChemicalItem.CDCupboard,0))) > 0 THEN 'CDC | '
					WHEN Sum(Convert(int,isnull(DSSChemicalItem.CDCupboard,0))) = 0 AND Sum(Convert(int,isnull(LocalChemicalItem.CDCupboard,0))) > 0 THEN 'CDC | '
					ELSE ''      
				END       
			+
            CASE
                WHEN CONVERT(bit, max(PrescriptionInfusion.RequestID)) = 1 THEN 'INJ | '
                WHEN CONVERT(bit, max(PrescriptionEnteral.RequestID)) = 1 THEN 'Enteral | '
                ELSE ''
            END       
			+  CASE
					WHEN  SUM(LatestResponse.InProgress) + SUM(LatestResponse.Due) = COUNT(*) THEN  
					CASE
					WHEN SUM(LatestResponse.Due) > 0 THEN
					'Next Due: ' + convert(varchar(8), min(Request_Admin.RequestDate), 3) + ' ' + convert(varchar(5), min(Request_Admin.RequestDate), 8)
					ELSE
					'InProgress '
					END
					ELSE
					' Overdue since: ' + convert(varchar(8), min(Request_Admin.RequestDate), 3) + ' ' + convert(varchar(5), min(Request_Admin.RequestDate), 8)
					END
				AS  'Status'
			,   'Episode' AS 'Class'
			,   'Doses' AS 'Query'
			,   count(*) over() AS 'Rowcount'
			,   row_number() over(ORDER BY min(Request_Admin.RequestDate)) AS 'RowNumber'
		FROM #Patients
			JOIN RequestStatus ON #Patients.RequestID = RequestStatus.RequestID
			LEFT JOIN Prescription ON RequestStatus.RequestID = Prescription.RequestID
			LEFT JOIN PrescriptionInfusion ON Prescription.RequestID = PrescriptionInfusion.RequestID
			LEFT JOIN PrescriptionEnteral ON Prescription.RequestID = PrescriptionEnteral.RequestID
			LEFT JOIN GenericPrescription ON RequestStatus.RequestID = GenericPrescription.RequestID
			JOIN Request Request_Admin ON RequestStatus.RequestID = Request_Admin.RequestID_Parent
			JOIN RequestType ON Request_Admin.RequestTypeID = RequestType.RequestTypeID
			LEFT JOIN Response ON Request_Admin.RequestID = Response.RequestID
			--JOIN Episode ON RequestStatus.EpisodeOrder__EpisodeID = Episode.EpisodeID
			--JOIN Person ON Episode.EntityID = Person.EntityID
			--JOIN Patient ON Episode.EntityID = Patient.EntityID
			--JOIN EpisodeLocation ON Episode.EpisodeID = EpisodeLocation.EpisodeID
			--JOIN Location ON EpisodeLocation.LocationID = Location.LocationID
			--JOIN LocationType ON Location.LocationTypeID = LocationType.LocationTypeID
        
			-- LEFT JOIN
			  -- EntityAlias
			  -- JOIN AliasGroup ON EntityAlias.AliasGroupID = AliasGroup.AliasGroupID AND AliasGroup.[Description] = @AliasGroup_PPI
			-- ON Episode.EntityID = EntityAlias.EntityID AND EntityAlias.[Default] = 1
    
			-- LEFT JOIN
			  -- EntityAlias EA_SPI
			  -- JOIN AliasGroup AG_SPI ON EA_SPI.AliasGroupID = AG_SPI.AliasGroupID AND AG_SPI.[Description] = @AliasGroup_SPI
			-- ON Episode.EntityID = EA_SPI.EntityID AND EA_SPI.[Default] = 1
        
			LEFT JOIN Product on Product.ProductID = Prescription.ProductID
			LEFT JOIN Ingredient on Ingredient.RequestID = Prescription.RequestID
			LEFT JOIN ProductType on ProductType.ProductTypeID = Product.ProductTypeID
        
			LEFT JOIN (SELECT 
				ProductLinkDSSLegalClassification.DSSLegalClassificationID,
				ProductLinkDSSLegalClassification.ProductID, 
				ProductLinkDSSLegalClassification.ProductRouteID,
				DSSLegalClassification.CDCupboard
			  FROM  ProductLinkDSSLegalClassification 
				LEFT JOIN ProductRoute ON ProductRoute.ProductRouteID = ProductLinkDSSLegalClassification.ProductRouteID
				JOIN DSSLegalClassification on DSSLegalClassification.DSSLegalClassificationID = ProductLinkDSSLegalClassification.DSSLegalClassificationID
			  WHERE DSSLegalClassification.CDCupboard = 1
			  ) DSSChemicalItem ON DSSChemicalItem.ProductID = Ingredient.ProductID
			  AND (Prescription.ProductRouteID = DSSChemicalItem .ProductRouteID OR DSSChemicalItem .ProductRouteID = 0)
          
			LEFT JOIN (SELECT 
				ControlledDrugsLocalVariation.ControlledDrugsLocalVariationID,
				ControlledDrugsLocalVariation.ProductID, 
				ControlledDrugsLocalVariation.ProductRouteID,
				ControlledDrugsLocalVariation.CDCupboard
			  FROM  ControlledDrugsLocalVariation 
				LEFT JOIN ProductRoute ON ProductRoute.ProductRouteID = ControlledDrugsLocalVariation.ProductRouteID
			  WHERE ControlledDrugsLocalVariation.CDCupboard = 1
			) LocalChemicalItem ON LocalChemicalItem.ProductID = Ingredient.ProductID
				AND (Prescription.ProductRouteID = LocalChemicalItem.ProductRouteID OR LocalChemicalItem.ProductRouteID = 0)

			OUTER APPLY	
		   (	
				SELECT TOP 1                
				CASE
				WHEN AdministrationInfusion_Action IN ( 'Started', 'FluidChange', 'FlowRateChange' ) THEN   
					 1 
                ELSE 0 END
				AS InProgress,
				CASE
				WHEN AdministrationInfusion_Action IN ( 'Started', 'FluidChange', 'FlowRateChange' ) THEN
                                    0 
                WHEN Due_RequestDate < @Now 
                    THEN 0
					ELSE 1
					END
				AS Due FROM 
				(
				SELECT		TOP 1                
				AdministrationInfusion.[Action] 
				AS AdministrationInfusion_Action,
				Response.RequestID
                FROM		Response
                    JOIN		Administration ON Response.ResponseID = Administration.ResponseID
                    JOIN		DrugAdministrationResponse ON Response.ResponseID = DrugAdministrationResponse.ResponseID
                    JOIN		Entity Administrator ON Response.EntityID = Administrator.EntityID
                    LEFT JOIN	AdministrationInfusion ON Administration.ResponseID = AdministrationInfusion.ResponseID
                WHERE		Response.RequestID =  Request_Admin.RequestID
                ORDER BY	Response.ResponseID DESC
				)Infusion
													
				RIGHT JOIN 

				(
				SELECT TOP 1 
				Request_Admin.RequestDate  AS Due_RequestDate,
				Request_Due.RequestID AS Due_RequestID
				FROM Request Request_Due 
				WHERE  Request_Due.RequestID = Request_Admin.RequestID
				)Dues 
				ON Infusion.RequestID=Dues.Due_RequestID
			) LatestResponse

		   OUTER APPLY
			 (
				SELECT TOP 1
						isnull(Rx_Orderset.PRN, GRx_Orderset.PRN) AS 'PRN'
					,	isnull(Rx_Orderset.ScheduleID_Administration, GRx_Orderset.ScheduleID_Administration) AS 'ScheduleID_Administration'
					,	Orderset.ContentsAreOptions
				FROM
					Orderset 
					JOIN Request R_Orderset ON Orderset.RequestID = R_Orderset.RequestID_Parent
					LEFT JOIN Prescription Rx_Orderset ON R_Orderset.RequestID = Rx_Orderset.RequestID
					LEFT JOIN GenericPrescription GRx_Orderset ON Orderset.RequestID = GRx_Orderset.RequestID
				WHERE
					Orderset.RequestID = Request_Admin.RequestID_Parent
					AND Orderset.ContentsAreOptions = 1
					AND NOT (
								Rx_Orderset.RequestID IS NULL
								AND GRx_Orderset.RequestID IS NULL
							)
			 ) OptionsOrdersetPrescription
			LEFT JOIN DrugAdministrationResponse ON Response.ResponseID = DrugAdministrationResponse.ResponseID
			LEFT JOIN Request OO_Pres ON DrugAdministrationResponse.RequestID_Prescription = OO_Pres.RequestID
			LEFT JOIN RequestType OO_Pres_Type ON OO_Pres.RequestTypeID = OO_Pres_Type.RequestTypeID
			LEFT JOIN PrescriptionInfusion OO_PInf ON OO_Pres.RequestID = OO_PInf.RequestID
			LEFT JOIN PrescriptionEnteral OO_PEnt ON OO_Pres.RequestID = OO_PEnt.RequestID
		WHERE  
			-- EpisodeLocation.Active = 1
			-- AND Episode.EndDate IS NULL
			-- AND EpisodeLocation.LocationID = @LocationID_Ward
			-- AND LocationType.[Description] IN ('Ward', 'Outpatient Location')
			RequestType.[Description] IN ('Drug Administration', 'Doseless Administration', 'Infusion Administration', 'Enteral Administration', 'Generic Prescription Administration')
			-- AND (@AdministerLifeTimeEpisode = 1 or (@AdministerLifeTimeEpisode <> 1 and Episode.EpisodeID_Parent > 0)) -- 83316
			-- AND Episode.EndDate IS NULL
			AND (
					(
						--DUE
						Request_Admin.RequestDate > @Now    --| Has a request in the future
						AND datediff(minute, @Now, Request_Admin.RequestDate) <= @MaxMinutesEarly
						AND Response.RequestID IS NULL  --| which doesn't have a response
						AND coalesce(Prescription.PRN, GenericPrescription.PRN, OptionsOrdersetPrescription.PRN, 0) = 0 -- Exclude all PRN doses
					)
					OR
					(
						--Rate-based infusions and Long Duration Infusions
						(
							RequestStatus.RequestType__Description = 'Infusion Prescription'
							OR OO_Pres_Type.[Description] = 'Infusion Prescription'
							OR RequestStatus.RequestType__Description = 'Enteral Prescription'
							OR OO_Pres_Type.[Description] = 'Enteral Prescription'
						)
						AND (
								--It's in progress (the [Description of the most recent Response] is not 'Infusion Ended')
								(
									Response.ShortDescription IN ('C', 'F', 'S')
									AND 
											Response.ResponseID =  (
																	 SELECT max(SubResponse.ResponseID)
																	 FROM
																	   Response SubResponse
																	 WHERE
																	   Request_Admin.RequestID = SubResponse.RequestID
																   )
								)
								--OR Response.ResponseID IS NULL
                               
							)
				   )
					OR
					(
						--Overdue
						Request_Admin.RequestDate < @Now    --| Has a request in the past
						AND datediff(day, Request_Admin.RequestDate, @Now) <= 30 --overdue by less than one month
						AND Response.RequestID IS NULL  --| which doesn't have a response
						AND coalesce(Prescription.PRN, GenericPrescription.PRN, OptionsOrdersetPrescription.PRN, 0) = 0 -- Exclude all PRN doses
					)
                
				)
		GROUP BY #Patients.EntityID,
				#Patients.EpisodeID
				
		UPDATE #Results
		SET Surname = Person.Surname,
			Forename = Person.Forename,
		PrimaryAlias = isnull(' (' + icwsys.fFormatID(EntityAlias.Alias, AliasGroup.Format) + ')', ' (' + @DisplayName_PPI + ' unknown)') ,
		SecondaryAlias = isnull(' (' + icwsys.fFormatID(EA_SPI.Alias, AG_SPI.Format) + ')', ' (' + @DisplayName_SPI + ' unknown)'),
		DOB = Patient.DOB  
		FROM #Results
			JOIN Person ON #Results.EntityID = Person.EntityID
			JOIN Patient ON #Results.EntityID = Patient.EntityID
		LEFT JOIN
		 EntityAlias
		 JOIN AliasGroup ON EntityAlias.AliasGroupID = AliasGroup.AliasGroupID AND AliasGroup.[Description] = @AliasGroup_PPI
		ON #Results.EntityID = EntityAlias.EntityID AND EntityAlias.[Default] = 1
    
		LEFT JOIN
		 EntityAlias EA_SPI
		 JOIN AliasGroup AG_SPI ON EA_SPI.AliasGroupID = AG_SPI.AliasGroupID AND AG_SPI.[Description] = @AliasGroup_SPI
		ON #Results.EntityID = EA_SPI.EntityID AND EA_SPI.[Default] = 1
        
	Declare @PatientData AS PatientMatchingTableType

	Insert into @PatientData
	Select Distinct ID, Surname ,Forename, DOB from #Results

	Select   r.ID
			, Surname + ', ' + Forename  + PrimaryAlias  + SecondaryAlias  
			  + isnull(' - ' + convert(varchar(10), DOB, 103), '') AS 'Text'
			,   '' AS 'Date'
			,  isnull(r.[Status], '') 
			   + CASE when isnull(r.[Status],'') <> '' and isnull(pd.[Status], '') <> '' 
					  Then ' | '
					  Else ''
				 END
			   + isnull(pd.[Status], '') AS 'Status'
			,   Class
			,   Query
			,   [Rowcount]
			,   RowNumber
	FROM #Results r
	Inner Join GetPatientMatchingStatus(@PatientData) pd on r.ID = pd.ID
	WHERE 
		r.RowNumber BETWEEN @FirstRow AND @LastRow
	ORDER BY
		r.RowNumber
	DROP TABLE #Patients
	DROP TABLE #Results

