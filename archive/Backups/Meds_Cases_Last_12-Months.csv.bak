20/08/2025 14:12:29 - Muhammed Rashik Rahman (Work notes)
select sum(Difference) as TotalofDiffrence
from(
SELECT
DATEPART(YEAR, ms.timestamp) as 'Year',
DATEPART(MONTH, ms.timestamp) as 'month',
DATEPART(DAY, ms.timestamp) as 'day',
DATEPART(HOUR, ms.timestamp) as 'Perhour',
DATEPART(MINUTE, ms.timestamp) as 'minute' ,
--count(distinct m.MessageGuid) as 'received',
count (distinct case when  i.name = 'PASReceiver' and [StatusID] = 8 then m.MessageGuid end) as 'received',
count (distinct case when  i.name = 'ICWMsgProcessor' and [StatusID] = 12 then m.MessageGuid end) as 'processed',
COUNT(DISTINCT CASE WHEN i.name = 'PASReceiver' AND [StatusID] = 8 THEN m.MessageGuid END) -
COUNT(DISTINCT CASE WHEN i.name = 'ICWMsgProcessor' AND [StatusID] = 12 THEN m.MessageGuid END) AS 'Difference'
FROM MESSAGESTATUS MS (nolock)
JOIN MESSAGE M (nolock)ON M.MESSAGEGUID = MS.MESSAGEGUID
JOIN INTERFACECOMPONENT I (nolock)ON I.INTERFACECOMPONENTID = MS.INTERFACECOMPONENTID and i.name = 'PASReceiver' or i.name = 'ICWMsgProcessor'--may need to amend i.name, search interfacecomponent table
where ms.Timestamp > '2025-08-20 10:00:00.000' and ms.Timestamp < '2025-08-20 13:00:00.000' and [StatusID] in (8,12)
group by
DATEPART(YEAR, ms.timestamp),
DATEPART(MONTH, ms.timestamp),
DATEPART(DAY, ms.timestamp),
DATEPART(HOUR, ms.timestamp),
DATEPART(MINUTE, ms.timestamp)

) as subquery

