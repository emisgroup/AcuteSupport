SELECT u.EntityID,u.Username,e.Description AS [Name],
MAX(l.DateTime) AS LastSuccessfulLogin
FROM [User] u
JOIN Entity e ON e.EntityID = u.EntityID
JOIN LoginAttempt l ON l.Username = u.Username
WHERE u.Deleted <> 1
  AND l.Success = 1
  AND l.DateTime >= DATEADD(YEAR, -1, GETDATE())
GROUP BY u.EntityID, u.Username,e.Description
ORDER BY LastSuccessfulLogin DESC;

11/05/2026 12:19:30 - Muhammed Rashik Rahman (Work notes)
SELECT
    u.EntityID,
    u.Username,
    e.Description AS [Name],
    MAX(l.DateTime) AS LastLoginTry
FROM [User] u
JOIN Entity e
    ON e.EntityID = u.EntityID
JOIN LoginAttempt l
    ON l.Username = u.Username
WHERE u.Deleted <> 1
  AND l.DateTime >= DATEADD(MONTH, -6, GETDATE())
GROUP BY
    u.EntityID,
    u.Username,
    e.Description

order by LastLoginTry desc

