select l.locationid,l.description,lt.description as LocationType,lp.description as ParentLocation, ltp.description as ParentLocationType,lp.locationid as ParentLocationID from location l
join location lp on lp.locationid=l.locationid_parent
join locationtype lt on lt.locationtypeid = l.locationtypeid
join locationtype ltp on ltp.locationtypeid = lp.locationtypeid
where l.locationid = 14 or l.locationtypeid in (7,6)
order by lt.description desc

select l.locationid,l.description,lt.description as LocationType,lp.description as ParentLocation, ltp.description as ParentLocationType,lp.locationid as ParentLocationID
from location l
join location lp on lp.locationid=l.locationid_parent
join locationtype lt on lt.locationtypeid = l.locationtypeid
join locationtype ltp on ltp.locationtypeid = lp.locationtypeid
where l.locationtypeid in (4)
order by lp.description desc

