26/09/2025 11:57:55 - Swati Dongare (Work notes)
USE [EHSC_HAP_LIVE]
GO

/****** Object:  View [icwsys].[vMostRecentReviewRequest]    Script Date: 26/09/2025 11:41:39 ******/
SET ANSI_NULLS ON
GO

SET QUOTED_IDENTIFIER ON
GO



CREATE VIEW [icwsys].[vMostRecentReviewRequest]
AS
    SELECT 
          rr.ReviewRequestID
        , rr.RequestID
        , rr.ReviewDate
        , rr.AlertStartDate
        , rr.CompletionDate
        , rr.CreatedEntityID
        , CASE WHEN rr.CompletionDate IS NULL THEN 0 ELSE 1 END 'Complete'
        , CASE WHEN rr.CompletionDate IS NULL AND DATEDIFF(s, rr.ReviewDate, GETDATE()) < 0  AND (DATEDIFF(s, rr.AlertStartDate, GETDATE()) < 0 OR DATEDIFF(s, rr.AlertStartDate, GETDATE()) IS NULL) THEN 1 ELSE 0 END 'Pending'
        , CASE WHEN rr.CompletionDate IS NULL AND DATEDIFF(s, rr.ReviewDate, GETDATE()) < 0  AND DATEDIFF(s, rr.AlertStartDate, GETDATE()) > 0 THEN 1 ELSE 0 END 'Due'
        , CASE WHEN rr.CompletionDate IS NULL AND DATEDIFF(s, rr.ReviewDate, GETDATE()) > 0 THEN 1 ELSE 0 END 'OverDue'
		from icwsys.ReviewRequest rr
		left join icwsys.ReviewRequest  rrnewer
		on rr.RequestID = rrnewer.RequestID and rr.ReviewRequestID < rrnewer.ReviewRequestID
		where rrnewer.RequestID is null



GO

26/09/2025 11:57:44 - Swati Dongare (Work notes)
Worklist : ---AGH Inpatient History PMR This Episode


 DECLARE
        @CurrentSessionID int
    ,   @EpisodeID int
    ,   @UserID int
    ,   @TerminalID int 
    ,   @ParentID int
    ,   @FirstRow int
    ,   @LastRow int
    

    

    Set @CurrentSessionID = 15269960
    Select @EpisodeID = [PrimaryKey] From State s Join [Table] t on s.TableID = t.TableID Where s.SessionID=16746916 and t.Description = 'Episode'
    Select  @UserID = EntityID From Session where SessionID = 15269960
    Set @TerminalID = 111
    Set @ParentID = NULL
    Set @FirstRow = 1
    Set @LastRow = 20

------------------------------------------ End Variables - Do not paste text above this line back into Worklist Editor -----------------------------------------------------

IF @EpisodeID = -1
BEGIN
    RETURN
END

DECLARE @CancelledCutOff int
SELECT @CancelledCutOff = InpatientCancelledCutoff FROM icwsys.fASCGenericPrescribingSettingsByChildLocation(@TerminalID)
print 'cutoff= ' print @CancelledCutOff

DECLARE @ShowIndicatorWhenFormulary bit
SELECT
@ShowIndicatorWhenFormulary = case when value = 'true' then 1 else 0 end
FROM 
	Setting
WHERE
	[System] = 'ICW'
AND
	[Section] = 'Prescribing'
AND
	[Key] = 'ShowIndicatorWhenFormulary'

SELECT *
FROM
(
  SELECT
          InnerResults.*
      ,   row_number() over(ORDER BY InnerResults.Weighting, InnerResults.OrderBy1, InnerResults.OrderBy2) AS 'RowNumber'
      ,   count(*) OVER () AS 'Rowcount'
  FROM
  (
  
      SELECT
              Request.RequestID AS 'ID'
          ,   Request.[Description] + CASE
                    -- Standalone items, show Treatment Plan name if they're in a TP but not part of a cycle.
                    WHEN Parent.RequestID IS NULL AND PlannedItem.RequestID_Finalised IS NULL THEN ''
                    WHEN Parent.RequestID IS NULL AND PlannedItem.RequestID_Finalised IS NOT NULL THEN ' FROM: ' + TreatmentPlan.Description
        
                    -- Not in a Treatment Plan, show ""FROM ORDERSET"" + Parent description
                    WHEN Grandparent.RequestID IS NULL THEN ' FROM ORDERSET: ' + Parent.[Description]
                    
                    --In a treatment plan, so show Grandparent and parent details
                    ELSE ' FROM: ' + Grandparent.[Description] + ', ' + Parent.[Description]
                  END AS 'Text'
          ,   icwsys.fASCPMRDate(Request.RequestID) AS 'Date'
          ,   icwsys.fASCCurrentPMRStatus(Request.RequestID)
			  + icwsys.fIsFormularyIndicatorFromFlags(Request.IsFormulary, ot.IsFormulary, @ShowIndicatorWhenFormulary, ' | ') AS 'Status'
          ,   'Request' AS 'Class'
          ,   CASE
                  WHEN RequestStatus.RequestType__Description = 'Enteral Prescription' THEN 12 --Dietary products
                  WHEN RequestStatus.RequestType__Description = 'PN Prescription' THEN 8 --Fluids and electrolytes
                  WHEN Ingredient.Description_Drug = 'TPN' THEN 8 -- Fluids and Electrolytes
                  WHEN TM.DrugChartFluid = 1 AND icwsys.fIsRequestFluidAndElectrolytes(Request.RequestID) = 1 THEN 8
                  WHEN TM.DrugChartBlood = 1 OR icwsys.fIsDrugChartBlood(Ingredient.ProductID) = 1 THEN 10
				  WHEN Prescription.IsIfRequired = 1 AND Prescription.ScheduleID_Administration = 0 THEN 2 --Single Dose
                  WHEN isnull(Prescription.PRN, GenericPrescription.PRN) = 0 AND isnull(Prescription.ScheduleID_Administration, GenericPrescription.ScheduleID_Administration) = 0 THEN 2 --Single Dose
                  WHEN isnull(Prescription.PRN, GenericPrescription.PRN) = 0 THEN 4 --Regular Scheduled Meds
                  WHEN RequestStatus.RequestType__Description = 'Product Order' THEN 4 --Show Product orders in Scheduled Meds
                  WHEN isnull(Prescription.PRN, GenericPrescription.PRN) = 1 THEN 6 -- PRNs (both WHEN and IF)
                  ELSE 99
              END AS 'Weighting'
          ,   Ingredient.Description_Drug AS 'OrderBy1'
          ,   Request.RequestDate AS 'OrderBy2'
          ,   CASE WHEN icwsys.fSupplyRequestsExists(Request.RequestID, 1) = 1 THEN 'Supply Requests' ELSE '' END AS 'Query'
      FROM
          Request
          JOIN RequestStatus ON Request.RequestID = RequestStatus.RequestID
          LEFT JOIN EpisodeOrder eo on eo.RequestID = Request.RequestID
		  LEFT JOIN OrderTemplateWithFormularyFlag ot on ot.OrderTemplateID = eo.OrderTemplateID
		  LEFT JOIN Request Parent ON Request.RequestID_Parent = Parent.RequestID AND Request.RequestID_Parent > 0
          LEFT JOIN Request GrandParent ON Parent.RequestID_Parent = GrandParent.RequestID AND Parent.RequestID_Parent > 0 -- Cycle if part of an Orderset
		  LEFT JOIN Orderset ON Parent.RequestID = Orderset.RequestID AND Orderset.ContentsAreOptions = 1
		  LEFT JOIN Ingredient ON Request.RequestID = Ingredient.RequestID
          LEFT JOIN Prescription ON Request.RequestID = Prescription.RequestID
          LEFT JOIN GenericPrescription ON Request.RequestID = GenericPrescription.RequestID
          LEFT JOIN PrescriptionInfusion ON Request.RequestID = PrescriptionInfusion.RequestID
          JOIN Schedule ON isnull(Prescription.ScheduleID_Administration, GenericPrescription.ScheduleID_Administration) = Schedule.ScheduleID

          LEFT JOIN 
              PlannedItem
              JOIN TreatmentPlan ON PlannedItem.TreatmentPlanID = TreatmentPlan.TreatmentPlanID
          ON Request.RequestID = PlannedItem.RequestID_Finalised
    OUTER APPLY (
        SELECT TOP 1 DrugChartBlood, DrugChartFluid from icwsys.TherapeuticMoiety
          JOIN icwsys.fProductComposition(Ingredient.ProductID) c on c.ProductID = TherapeuticMoiety.ProductID  
    ) TM
        LEFT JOIN vMostRecentReviewRequest mrrr on Request.RequestID = mrrr.RequestID
      WHERE
          RequestStatus.EpisodeOrder__EpisodeID = @EpisodeID
          AND Orderset.RequestID IS NULL -- Exclude anything in an Options Orderset
          AND RequestStatus.RequestType__Description IN ('Standard Prescription', 'Infusion Prescription', 'Doseless Prescription', 'Generic Prescription', 'Product Order', 'Enteral Prescription', 'PN Prescription')
          AND (
                Ingredient.PrimaryIngredient = 1
                OR Ingredient.RequestID IS NULL --Free-text Prescriptions
              )
          AND (
                  (datediff(hour, RequestStatus.Request_Cancellation__CreatedDate, getdate()) >= @CancelledCutOff
                  OR RequestStatus.Expired = 1) AND (mrrr.Complete is null OR mrrr.Complete = 1)
  
          )
      UNION ALL

SELECT
            OS.RequestID AS 'ID'
        ,   OS.[Description] AS 'Text'
        ,   icwsys.fASCPMRDate(OS.RequestID) AS 'Date'
        ,   icwsys.fASCCurrentPMRStatus(OS.RequestID)
			+ icwsys.fIsFormularyIndicatorFromFlags(OS.IsFormulary, ot.IsFormulary, @ShowIndicatorWhenFormulary, ' | ') AS 'Status'
        ,   'Request' AS 'Class'
        ,   CASE
                WHEN TM.DrugChartFluid = 1 AND icwsys.fIsRequestFluidAndElectrolytes(Request.RequestID) = 1 THEN 8
                WHEN TM.DrugChartBlood = 1 OR icwsys.fIsDrugChartBlood(FirstIngredient.ProductID) = 1 THEN 10
				WHEN Prescription.IsIfRequired = 1 AND Prescription.ScheduleID_Administration = 0 THEN 2 --Single Dose
                WHEN isnull(Prescription.PRN, GenericPrescription.PRN) = 0 AND isnull(Prescription.ScheduleID_Administration, GenericPrescription.ScheduleID_Administration) = 0 THEN 2 --Single Dose
                WHEN isnull(Prescription.PRN, GenericPrescription.PRN) = 0 THEN 4 --Regular Scheduled Meds             
                WHEN isnull(Prescription.PRN, GenericPrescription.PRN) = 1 THEN 6 -- PRNs (both WHEN and IF)
                ELSE 12--Others
            END AS 'Weighting'
        ,   OS.[Description] AS 'OrderBy1'
        ,   Request.RequestDate AS 'OrderBy2'
        ,	'Options Orderset Contents' AS 'Query'
    FROM
        Orderset
        JOIN Request OS ON Orderset.RequestID = OS.RequestID
        JOIN RequestStatus ON OS.RequestID = RequestStatus.RequestID
        LEFT JOIN EpisodeOrder eo on eo.RequestID = OS.RequestID
		LEFT JOIN OrderTemplateWithFormularyFlag ot on ot.OrderTemplateID = eo.OrderTemplateID
        -- Find one of the prescriptions, to use for getting Schedule information etc
        CROSS APPLY (
                        SELECT TOP 1
                            Child.RequestID
                        FROM
                            Request Child
                            JOIN RequestType RT_Child ON Child.RequestTypeID = RT_Child.RequestTypeID
                        WHERE
                            Child.RequestID_Parent = Orderset.RequestID
                            AND RT_Child.[Description] IN ('Standard Prescription', 'Doseless Prescription', 'Infusion Prescription', 'Enteral Prescription', 'Generic Prescription')
                    ) FirstPrescription
        
        JOIN Request ON FirstPrescription.RequestID = Request.RequestID
            
        
        LEFT JOIN Prescription ON FirstPrescription.RequestID = Prescription.RequestID
        LEFT JOIN GenericPrescription ON FirstPrescription.RequestID = GenericPrescription.RequestID
    CROSS APPLY (
        SELECT TOP 1 Ingredient.ProductID from icwsys.Ingredient where Ingredient.RequestID = FirstPrescription.RequestID
    ) FirstIngredient
    OUTER APPLY (
        SELECT TOP 1 DrugChartBlood, DrugChartFluid from icwsys.TherapeuticMoiety
          JOIN icwsys.fProductComposition(FirstIngredient.ProductID) c on c.ProductID = TherapeuticMoiety.ProductID  
    ) TM
    LEFT JOIN vMostRecentReviewRequest mrrr on Request.RequestID = mrrr.RequestID
    WHERE
        RequestStatus.EpisodeOrder__EpisodeID = @EpisodeID
        AND Orderset.ContentsAreOptions = 1
        AND (
                  (datediff(hour, RequestStatus.Request_Cancellation__CreatedDate, getdate()) >= @CancelledCutOff
                  OR RequestStatus.Expired > 0) AND (mrrr.Complete is null OR mrrr.Complete = 1)
          )


      UNION ALL

      SELECT
              0 AS ID
          ,   'ONCE ONLY MEDICATION' AS 'Text'
          ,   '' AS 'Date'
          ,   '' AS 'Status'
          ,   'Header' AS 'Class'
          ,   1 AS 'Weighting'
          ,   NULL AS 'OrderBy1'
          ,   NULL AS 'OrderBy2'
          ,	 NULL AS 'Query'
          
      UNION ALL
      
      SELECT
              0 AS ID
          ,   'REGULAR MEDICATION' AS 'Text'
          ,   '' AS 'Date'
          ,   '' AS 'Status'
          ,   'Header' AS 'Class'
          ,   3 AS 'Weighting'
          ,   NULL AS 'OrderBy1'
          ,   NULL AS 'OrderBy2'
          ,	 NULL AS 'Query'
          
      UNION ALL
      SELECT
              0 AS ID
          ,   'AS REQUIRED MEDICATION' AS 'Text'
          ,   '' AS 'Date'
          ,   '' AS 'Status'
          ,   'Header' AS 'Class'
          ,   5 AS 'Weighting'
          ,   NULL AS 'OrderBy1'
          ,   NULL AS 'OrderBy2'
          ,	 NULL AS 'Query'
          
          UNION
      SELECT
              0 AS ID
          ,   'FLUIDS AND ELECTROLYTES' AS 'Text'
          ,   '' AS 'Date'
          ,   '' AS 'Status'
          ,   'Header' AS 'Class'
          ,   7 AS 'Weighting'
          ,   NULL AS 'OrderBy1'
          ,   NULL AS 'OrderBy2' 
          ,	 NULL AS 'Query'   
          
          UNION
      SELECT
              0 AS ID
          ,   'BLOOD PRODUCTS' AS 'Text'
          ,   '' AS 'Date'
          ,   '' AS 'Status'
          ,   'Header' AS 'Class'
          ,   9 AS 'Weighting'
          ,   NULL AS 'OrderBy1'
          ,   NULL AS 'OrderBy2' 
          ,	 NULL AS 'Query'   
         
        UNION
    SELECT
            0 AS ID
        ,   'ENTERAL' AS 'Text'
        ,   '' AS 'Date'
        ,   '' AS 'Status'
        ,   'Header' AS 'Class'
        ,   11 AS 'Weighting'
        ,   NULL AS 'OrderBy1'
        ,   NULL AS 'OrderBy2'
        ,   NULL AS 'OrderBy3'
    ) InnerResults
) Results
WHERE
    Results.RowNumber BETWEEN @FirstRow AND @LastRow
ORDER BY
    Results.RowNumber

