22/10/2025 11:39:21 - Muhammed Rashik Rahman (Work notes)
WITH AllHours AS (
    SELECT TOP (72)
        DATEADD(HOUR, ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) - 1, DATEADD(HOUR, -6, GETDATE())) AS HourStart
    FROM master.dbo.spt_values
),
ReceivedCounts AS (
    SELECT
        DATEPART(YEAR, ms.timestamp) AS [Year],
        DATEPART(MONTH, ms.timestamp) AS [Month],
        DATEPART(DAY, ms.timestamp) AS [Day],
        DATEPART(HOUR, ms.timestamp) AS [Hour],
        COUNT(DISTINCT m.MessageGuid) AS [Received]
    FROM MESSAGESTATUS ms (NOLOCK)
    JOIN MESSAGE m (NOLOCK) ON m.MessageGuid = ms.MessageGuid
    JOIN INTERFACECOMPONENT i (NOLOCK) ON i.InterfaceComponentID = ms.InterfaceComponentID AND i.InterfaceComponentID = 2
    WHERE ms.Timestamp >= DATEADD(HOUR, -6, GETDATE()) AND ms.Timestamp < GETDATE()
    GROUP BY
        DATEPART(YEAR, ms.timestamp),
        DATEPART(MONTH, ms.timestamp),
        DATEPART(DAY, ms.timestamp),
        DATEPART(HOUR, ms.timestamp)
),
ProcessedCounts AS (
    SELECT
        DATEPART(YEAR, ms.timestamp) AS [Year],
        DATEPART(MONTH, ms.timestamp) AS [Month],
        DATEPART(DAY, ms.timestamp) AS [Day],
        DATEPART(HOUR, ms.timestamp) AS [Hour],
        COUNT(DISTINCT m.MessageGuid) AS [Processed]
    FROM MESSAGESTATUS ms (NOLOCK)
    JOIN MESSAGE m (NOLOCK) ON m.MessageGuid = ms.MessageGuid
    JOIN INTERFACECOMPONENT i (NOLOCK) ON i.InterfaceComponentID = ms.InterfaceComponentID AND i.InterfaceComponentID = 4
    WHERE ms.Timestamp >= DATEADD(HOUR, -6, GETDATE()) AND ms.Timestamp < GETDATE()
    GROUP BY
        DATEPART(YEAR, ms.timestamp),
        DATEPART(MONTH, ms.timestamp),
        DATEPART(DAY, ms.timestamp),
        DATEPART(HOUR, ms.timestamp)
)
SELECT
    DATEPART(YEAR, ah.HourStart) AS [Year],
    DATEPART(MONTH, ah.HourStart) AS [Month],
    DATEPART(DAY, ah.HourStart) AS [Day],
    DATEPART(HOUR, ah.HourStart) AS [Hour],
    ISNULL(rc.Received, 0) AS [Received],
    ISNULL(pc.Processed, 0) AS [Processed]
FROM AllHours ah
LEFT JOIN ReceivedCounts rc ON
    DATEPART(YEAR, ah.HourStart) = rc.Year AND
    DATEPART(MONTH, ah.HourStart) = rc.Month AND
    DATEPART(DAY, ah.HourStart) = rc.Day AND
    DATEPART(HOUR, ah.HourStart) = rc.Hour
LEFT JOIN ProcessedCounts pc ON
    DATEPART(YEAR, ah.HourStart) = pc.Year AND
    DATEPART(MONTH, ah.HourStart) = pc.Month AND
    DATEPART(DAY, ah.HourStart) = pc.Day AND
    DATEPART(HOUR, ah.HourStart) = pc.Hour
ORDER BY ah.HourStart;

