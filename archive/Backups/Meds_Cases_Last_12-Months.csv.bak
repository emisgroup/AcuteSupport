--Ran below all counts were over 900+ reprints checked KB0075642 and the days were already down to 4 days of reprints

SELECT COUNT(SiteID), SiteID, s.SiteNumber
FROM PharmacyStoresReprint psr(nolock)
join [Site] s on s.LocationID = psr.SiteID
where Category like 'orders' --change this to the type your looking at whether its orders, requistions or delivery notes can find more info on these by looking in the SP pWPharmacyTidyReprints
group by SiteID, s.SiteNumber

SELECT COUNT(SiteID), SiteID, s.SiteNumber
FROM PharmacyStoresReprint psr(nolock)
join [Site] s on s.LocationID = psr.SiteID
where Category like 'delnotes' --change this to the type your looking at whether its orders, requistions or delivery notes can find more info on these by looking in the SP pWPharmacyTidyReprints
group by SiteID, s.SiteNumber

--Ran the below scripts which showed the reprints had not cleared down for nearly 21 days which is why
--it had got too many of each

select * from pharmacystoresreprint where category = 'orders' and SiteID = '15'
select * from pharmacystoresreprint where category = 'orders' and SiteID = '19'
select * from pharmacystoresreprint where category = 'delnotes' and SiteID = '15'
select * from pharmacystoresreprint where category = 'delnotes' and SiteID = '19'

--to fix this i ran the sp below


exec pWPharmacyTidyReprints

