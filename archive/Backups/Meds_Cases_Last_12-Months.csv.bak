USE [EHSC_HAP_LIVE]
GO
/****** Object:  StoredProcedure [icwsys].[peMMClinicalCheckingWorkListQuery]    Script Date: 18/02/2026 13:57:25 ******/
SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO

ALTER PROCEDURE [icwsys].[peMMClinicalCheckingWorkListQuery]
(
		@CurrentSessionID	int
	,	@Ward				int
	,	@Ward_Group			int
)
AS
BEGIN
	--Parameter-sniffing protection. Use the @Use_ versions in the rest of the SP
	DECLARE @Use_CurrentSessionID	int
	DECLARE @Use_Ward				int
	DECLARE @Use_Ward_Group			int

	SET @Use_CurrentSessionID = 20638249
	SET @Use_Ward = ISNULL(@Ward, -1)
	SET @Use_Ward_Group = ISNULL(@Ward_Group, -1)
	-- end of parameter sniffing stuff

	DECLARE @LocationID							int
	DECLARE @AliasGroup_PPI						varchar(128)
	DECLARE @AliasGroup_SPI						varchar(128)
	DECLARE @DisplayName_PPI					varchar(128)
	DECLARE @DisplayName_SPI					varchar(128)
	DECLARE @SupplyRequestText					varchar(20)
	DECLARE @AwaitingInterventionText 			varchar(30)
	DECLARE @AwaitingClinicalCheckText			varchar(30)
	DECLARE @PriorityText						varchar(10)
	DECLARE @ClinicalCheckAgainstClosedEpisodes	int
	DECLARE @StatusTextSeperator				varchar(5)
	DECLARE @DisplaySingleDoseCompleteXDays		int
	DECLARE @IncludeClosedFromDate				datetime
	DECLARE @StartDate							datetime
	DECLARE @EndDate							datetime
	DECLARE @IncludeCompletedSingleDosesForClinicalChecking	bit
	SELECT	@LocationID = LocationID
	FROM	icwsys.[Session]
	WHERE	SessionID = 20638249

	SELECT	@AliasGroup_PPI = Setting.Value
	FROM	icwsys.Setting
	WHERE	[System] = 'General'
	  AND	Section = 'PatientEditor'
	  AND	[Key] = 'PrimaryPatientIdentifier'

	SELECT	@AliasGroup_SPI = Setting.Value
	FROM	icwsys.Setting
	WHERE	Setting.[System] = 'General'
	  AND	Setting.[Section] = 'PatientEditor'
	  AND	Setting.[Key] = 'SecondaryPatientIdentifier'
	  AND	Setting.RoleID = 0

	SELECT	@DisplayName_PPI = DisplayName
	FROM	icwsys.AliasGroup
	WHERE	[Description] = @AliasGroup_PPI

	SELECT	@DisplayName_SPI = DisplayName
	FROM	icwsys.AliasGroup
	WHERE	[Description] = @AliasGroup_SPI

	SELECT	@AwaitingInterventionText = AwaitingInterventionText
		,	@PriorityText = PriorityText
		,	@SupplyRequestText = SupplyRequestText
		,	@StatusTextSeperator = StatusTextSeperator
		,	@ClinicalCheckAgainstClosedEpisodes = ClinicalCheckAgainstClosedEpisodes
		,	@DisplaySingleDoseCompleteXDays = DisplaySingleDoseCompleteXDays
		,	@AwaitingClinicalCheckText = AwaitingClinicalCheckText
		,	@IncludeCompletedSingleDosesForClinicalChecking = IncludeCompletedSingleDosesForClinicalChecking
	FROM	icwsys.eMMDefaults
	WHERE	eMMDefaults.LocationID_Parent = icwsys.feMMSettingsByChildLocation(@LocationID)

	SELECT	@IncludeClosedFromDate =	CASE
											WHEN @ClinicalCheckAgainstClosedEpisodes IS NULL THEN
												NULL
											WHEN @ClinicalCheckAgainstClosedEpisodes = 0 THEN
												DATEADD(dd, DATEDIFF(dd, -1, GETDATE()), 0)
											ELSE
												DATEADD(dd, DATEDIFF(dd, @ClinicalCheckAgainstClosedEpisodes, GETDATE()), 0)
										END

	IF  @DisplaySingleDoseCompleteXDays IS NOT NULL
		SET @StartDate = DATEADD(dd, DATEDIFF(dd, @DisplaySingleDoseCompleteXDays, GETDATE()), 0)
	ELSE
		SET @StartDate = GETDATE()

	SET @EndDate = DATEADD(ms, -3, DATEADD(dd, DATEDIFF(dd, 0, GETDATE()) + 1, 0))

	CREATE TABLE #FromWorkflow(RequestID int)
	
	INSERT #FromWorkflow
	SELECT DISTINCT
		ItemID
	FROM icwsys.ClinicalChecking_ClinicalChecking
	UNION
	SELECT DISTINCT
		ItemID
	FROM icwsys.ClinicalChecking_Intervention
		UNION
	SELECT DISTINCT
		ItemID
	FROM icwsys.ClinicalChecking_Suspended
		UNION
	SELECT DISTINCT
		ItemID
	FROM icwsys.ClinicalChecking_Review

	CREATE TABLE #Request ( RequestID int )

	INSERT		#Request
	SELECT		r.RequestID
	FROM		#FromWorkflow r
	  JOIN		icwsys.EpisodeOrder eo on eo.RequestID = r.requestId
	  JOIN		icwsys.Episode e ON eo.EpisodeID = e.EpisodeID
	  JOIN		icwsys.EpisodeLocation el ON e.EpisodeID = el.EpisodeID AND el.Active = 1
	  JOIN		icwsys.Ward w ON el.LocationID = w.LocationID
	  JOIN		icwsys.Episode [Lifetime] ON e.EntityID = [Lifetime].EntityID AND [Lifetime].EpisodeID_Parent = 0
	WHERE
			(		@ClinicalCheckAgainstClosedEpisodes IS NULL
					OR	e.EndDate IS NULL
					OR	e.EndDate >= @IncludeClosedFromDate
				)
	  AND		(		@Use_Ward = -1
					OR	el.LocationID = @Use_Ward
				)
	  AND		(		w.WardGroupID = @Use_Ward_Group
					OR	@Use_Ward_Group = -1
				)
	  AND		[Lifetime].EndDate IS NULL

	CREATE TABLE #FromWorkflowComplete(RequestID int)
	
	INSERT #FromWorkflowComplete
	SELECT DISTINCT
		ItemID
	FROM icwsys.ClinicalChecking_ClinicalCheckingComplete
	UNION
	SELECT DISTINCT
		ItemID
	FROM icwsys.ClinicalChecking_InterventionComplete
		UNION
	SELECT DISTINCT
		ItemID
	FROM icwsys.ClinicalChecking_SuspendedComplete
		UNION
	SELECT DISTINCT
		ItemID
	FROM icwsys.ClinicalChecking_ReviewComplete

	--start Bug 204151 - eMM Clinical Checking screen times out - peMMClinicalCheckingWorkListQuery query [10.16/2017.2]
	IF @IncludeCompletedSingleDosesForClinicalChecking = 1
	BEGIN
	INSERT		#Request
	SELECT		r.RequestID
	FROM		#FromWorkflowComplete r
	  JOIN		icwsys.Prescription p ON r.RequestID = p.RequestID
	  JOIN		icwsys.EpisodeOrder eo on eo.RequestID = r.requestId
	  JOIN		icwsys.Episode e ON eo.EpisodeID = e.EpisodeID
	  JOIN		icwsys.EpisodeLocation el ON e.EpisodeID = el.EpisodeID AND el.Active = 1
	  JOIN		icwsys.Ward w ON el.LocationID = w.LocationID
	  LEFT JOIN	icwsys.PrescriptionDoseless pd ON p.RequestID = pd.RequestID
	OUTER APPLY	(	SELECT		TOP 1
								Response.[Description]
							,	ISNULL(icwsys.fDateAndTime2DateTime(Administration.AdministeredDate, Administration.AdministeredTime), Response.ResponseDate) AS 'AdministeredDateTime'
					FROM		icwsys.Response
								JOIN icwsys.DrugAdministrationResponse ON Response.ResponseID = DrugAdministrationResponse.ResponseID
								JOIN icwsys.Administration ON Response.ResponseID = Administration.ResponseID
					WHERE		p.RequestID = DrugAdministrationResponse.RequestID_Prescription
					ORDER BY	Response.ResponseID
				) Latest
	  JOIN		icwsys.Episode [Lifetime] ON e.EntityID = [Lifetime].EntityID AND [Lifetime].EpisodeID_Parent = 0
	WHERE		
	  p.ScheduleID_Administration = 0
	  AND		p.PRN = 0
	  AND		(		pd.RequestID IS NULL
					OR	pd.NoDoseInfo = 0
				)
	  AND		ISNULL(Latest.AdministeredDateTime, p.StartDate ) BETWEEN @StartDate AND @EndDate
	  AND		(		@ClinicalCheckAgainstClosedEpisodes IS NULL
					OR	e.EndDate IS NULL
					OR	e.EndDate >= @IncludeClosedFromDate
				)
	  AND		(		@Use_Ward = -1
					OR	el.LocationID = @Use_Ward
				)
	  AND		(		w.WardGroupID = @Use_Ward_Group
					OR	@Use_Ward_Group = -1
				)
	  AND		[Lifetime].EndDate IS NULL
	END --end bug 204151 - eMM Clinical Checking screen times out - peMMClinicalCheckingWorkListQuery query [10.16/2017.2]
	SELECT		Request.EntityID_Patient
			,	MIN(Request.Screen) as Screen --part of fix for bug 202567 - eMM Clinical Checking screen does not indicate specifically which patients need a Clinical check [10.16/2017.2]
			,	MAX(Request.EpisodeID) AS EpisodeID
			,	MAX(Request.LocationID) AS LocationID
			,	MAX(CAST(ems.[Priority] AS int)) AS Priority_Supply
			,	MIN(RequestStatus.eMMSupply__CreatedDate) AS CreatedDate_Supply
			,	MIN(RequestStatus.eMMIntervention__CreatedDate) AS CreatedDate_eMMIntervention
			,	CASE 
					WHEN MIN(mrrr.Complete) = 1 THEN
						NULL
					ELSE
						MIN(mrrr.Complete)
				END AS ReviewComplete
			,	MAX(	CASE 
							WHEN icwsys.feMMSuspensionStatus(Request.RequestID) <> '' THEN
								1
							ELSE
								0
						END
					) AS Suspended
	INTO		#Patients
	FROM		#Request Temp_Request
	  JOIN		icwsys.eMM_PMR Request ON Temp_Request.RequestID = Request.RequestID
	  LEFT JOIN	( icwsys.RequestLinkAttachedNote ran
		JOIN	  icwsys.Note ON Ran.NoteID = Note.NoteID
		JOIN	  icwsys.entity ON note.entityid = entity.entityid
		JOIN	  icwsys.emmsupply ems ON note.noteid = ems.noteid
		JOIN	  icwsys.AttachedNote AN ON Note.NoteID = AN.NoteID AND AN.[Enabled] = 1
				) ON Request.RequestID = ran.RequestID
	  JOIN		icwsys.RequestStatus ON Request.RequestID = RequestStatus.RequestID
	  LEFT JOIN vMostRecentReviewRequest mrrr ON Request.RequestID = mrrr.RequestID
	GROUP BY	Request.EntityID_Patient

	CREATE TABLE #Result	(	SortID		int IDENTITY(0, 1) NOT NULL
							,	id			int UNIQUE
							,	EntityID	int
							,	Surname		varchar(256)	COLLATE DATABASE_DEFAULT
							,	Forename	varchar(256)	COLLATE DATABASE_DEFAULT
							,	DOB			datetime
							,	[Text]		varchar(1024)	COLLATE DATABASE_DEFAULT
							,	Location	varchar(256)	COLLATE DATABASE_DEFAULT
							,	[Status]	varchar(256)	COLLATE DATABASE_DEFAULT
							)

	INSERT		#Result     (	id
							,	EntityID
							,	Surname
							,	Forename
							,	DOB
							,	[Text]
							,	Location
							,	[Status]
							)
	SELECT		Episode.EpisodeID
			,	Person.EntityID
			,	UPPER(Person.Surname)
			,   ISNULL(Person.Forename, '')
			,	Patient.DOB
			,	UPPER(Person.Surname) + ', ' + ISNULL(Person.Forename,'') + ' '
				+ ISNULL(CONVERT(varchar(50), Patient.DOB, 106) + ' (' + icwsys.fNHSAge(Patient.DOB, GETDATE()) + ')', '') + ' '
				+ ISNULL(Gender.[Description], 'Unknown') + @StatusTextSeperator
				+ ISNULL(@DisplayName_PPI + ' ' + icwsys.fFormatID(EntityAlias.Alias, AliasGroup.Format)+ @StatusTextSeperator, '')
				+ ' ' + ISNULL(@DisplayName_SPI + ' ' + icwsys.fFormatID(EA_Case.Alias, AG_Case.Format), '')
			,	Location.[Description]
			,	icwsys.fASCTrimStatuseMM	(	CASE
													WHEN Request.CreatedDate_Supply IS NOT NULL AND Request.Priority_Supply = 1 THEN
														@PriorityText
													ELSE
														''
												END
												+	CASE
														WHEN Request.CreatedDate_Supply IS NOT NULL THEN
															@SupplyRequestText + ' '
															+ ISNULL(CONVERT(varchar(12), Request.CreatedDate_Supply, 106) + ' ' + CONVERT(varchar(5), Request.CreatedDate_Supply, 108), '')
													ELSE
														''
													END
												+	CASE --part of fix for bug 202567 - eMM Clinical Checking screen does not indicate specifically which patients need a Clinical check [10.16/2017.2]
														WHEN Request.Screen = 0 THEN
														 @StatusTextSeperator + @AwaitingClinicalCheckText
														 ELSE
														 ''
													 END
												+	CASE
														WHEN Request.CreatedDate_eMMIntervention IS NOT NULL THEN
															@StatusTextSeperator + @AwaitingInterventionText
															+ CONVERT(varchar(12), Request.CreatedDate_eMMIntervention, 106)
														ELSE
															''
													END
												+	CASE
														WHEN Request.ReviewComplete = 0 THEN
															@StatusTextSeperator + 'Review outstanding'
														ELSE
															''
													END
												+	CASE
														WHEN Request.Suspended = 1 THEN
															@StatusTextSeperator + 'Suspended Rx'
														ELSE
															''
													END
												, @StatusTextSeperator
											) AS [Status]
	FROM		#Patients Request
	  JOIN		Episode ON Request.EpisodeID = Episode.EpisodeID
	  JOIN		EpisodeType ept ON ept.EpisodeTypeID = Episode.EpisodeTypeID
	  JOIN		Person ON Episode.EntityID = Person.EntityID
	  JOIN		Patient ON Episode.EntityID = Patient.EntityID
	  LEFT JOIN	Gender  ON Patient.GenderID = Gender.GenderID
	  JOIN		Location ON Request.LocationID = Location.LocationID
	  LEFT JOIN	( EntityAlias
		JOIN	  AliasGroup ON EntityAlias.AliasGroupID = AliasGroup.AliasGroupID AND AliasGroup.[Description] = @AliasGroup_PPI
				) ON Episode.EntityID = EntityAlias.EntityID AND EntityAlias.[Default] = 1
	  LEFT JOIN ( EntityAlias EA_Case
		JOIN	  AliasGroup AG_Case ON EA_Case.AliasGroupID = AG_Case.AliasGroupID AND AG_Case.[Description] = @AliasGroup_SPI
				) ON Episode.EntityID = EA_Case.EntityID AND EA_Case.[Default] = 1
	WHERE Request.Screen = 0			
	ORDER BY	Request.Priority_Supply DESC
			,	Request.CreatedDate_Supply
			,	Request.CreatedDate_eMMIntervention DESC
			,	Request.ReviewComplete DESC
			,	Request.Suspended DESC
			,	Location.[Description]
			,	Person.Surname
			,	Person.Forename

	
	-- Get all patient specific information from @Result
	DECLARE @PatientData AS icwsys.PatientMatchingTableType

	INSERT	@PatientData
	SELECT	DISTINCT
			EntityID
		,	Surname
		,	Forename
		,	DOB
	FROM	#Result

	-- Return results. GetPatientMatchingStatus checks for any similar patients in the result and appends a message to the status if similar patient found
	SELECT		#Result.id
			,	'Episode' AS class
			,	'' AS Query
			,	#Result.[Text]
			,	#Result.Location AS [Date]
			,	ISNULL(#Result.[Status], '') 
				+	CASE
						WHEN ISNULL(#Result.[Status],'') <> '' AND ISNULL(pd.[Status], '') <> '' THEN
							' | '
						ELSE
							''
					END
				+ ISNULL(pd.[Status] collate database_default, '') AS [Status]
	FROM		#Result 
	  JOIN		icwsys.GetPatientMatchingStatus(@PatientData) pd ON #Result.[EntityID] = pd.ID
	ORDER BY	#Result.SortID
	
	DROP TABLE #Patients
	DROP TABLE #Request
	DROP TABLE #Result
END

