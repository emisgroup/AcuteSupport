select latest.*, r.requestid,r.Description from EpisodeOrder eo 
join Request r on r.RequestID=eo.RequestID
join RequestStatus rs on eo.RequestID = rs.RequestID
join Prescription p on p.RequestID=r.requestid
 OUTER APPLY (      
  SELECT TOP 1 Administration.AdministeredDate      
   ,Administration.AdministeredTime      
   ,Response.ResponseDate      
  FROM icwsys.Response      
  JOIN icwsys.DrugAdministrationResponse ON Response.ResponseID = DrugAdministrationResponse.ResponseID      
  JOIN icwsys.Administration ON Response.ResponseID = Administration.ResponseID      
  WHERE P.RequestID = DrugAdministrationResponse.RequestID_Prescription      
   AND Response.ShortDescription NOT IN ('S','F','C')      
  ORDER BY Response.ResponseID  desc   
  ) Latest      
where rs.Expired =0 and rs.Complete =1 and rs.[Request Cancellation] = 0
and p.Description_Frequency like 'single dose%'  and r.CreatedDate > '2026-03-01 00:00:00.000' and latest.ResponseDate < dateadd(D,-1,getdate())
order by latest.ResponseDate desc

