27/10/2025 11:08:30 - Swati Dongare (Work notes)
Reason for this fault is if patient has been merged after PSO has been ordered.


-- Update merged patient EntityIDs in the wLabel table for PSO orders

select distinct rom.EntityID_Before, rom.EntityID_After, wl.RequestID into #ToUpdate from wlabel wl
join recordofentityaliasmerge rom
on rom.EntityID_Before = wl.PatId
and wl.PSO = 1
order by wl.RequestID desc

update wl
set wl.PatId = tu.entityid_after
from wlabel wl
join #ToUpdate tu
on wl.RequestID = tu.RequestID
and wl.PatId = tu.EntityID_Before


drop table #ToUpdate

