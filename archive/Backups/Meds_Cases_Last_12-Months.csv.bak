SELECT
    [Fact_RequestedActivity].[Patient] [Patient],
    [Fact_RequestedActivity].[Patient1] [Patient1],
    [Fact_RequestedActivity].[NHSNumber] [NHSNumber],
    [Fact_RequestedActivity].[Patient2] [Patient2],
    [Fact_RequestedActivity].[CaseNumber] [CaseNumber],
    [dbo_v_No_Response].[RequestActivityID] [DosesNotActioned],
    [Fact_RequestedActivity].[Description] [Description],
    [Fact_RequestedActivity].[RequestDateTime] [RequestDateTime],
    [dbo_v_No_Response].[RequestActivityID] [RequestActivityID],
    [Fact_RequestedActivity].[DateDesc] [DateDesc],
    [Fact_RequestedActivity].[ProductDescShort] [ProductDescShort],
    [dbo_v_No_Response].[RequestActivityID] [RequestActivityID1],
    [Fact_RequestedActivity].[Ward] [Ward],
    [Fact_RequestedActivity].[Consultant] [Consultant],
    [Fact_RequestedActivity].[WardID] [WardID],
    [Fact_RequestedActivity].[ConsultantID] [ConsultantID]
FROM
    (
        SELECT     RequestActivityID, PrescriptionID, Action
FROM         v_No_Response
    ) [dbo_v_No_Response]
    LEFT OUTER JOIN (
        SELECT
            [Fact_Prescription].[Patient] [Patient],
            [Fact_Prescription].[Patient1] [Patient1],
            [Fact_Prescription].[NHSNumber] [NHSNumber],
            [Fact_Prescription].[Patient2] [Patient2],
            [Fact_Prescription].[CaseNumber] [CaseNumber],
            [Fact_Prescription].[Description] [Description],
            [Fact_RequestedActivity].[RequestDateTime] [RequestDateTime],
            [v_request_date].[DateDesc] [DateDesc],
            [Fact_Prescription].[ProductDescShort] [ProductDescShort],
            [Fact_RequestedActivity].[WardLongDesc] [Ward],
            [Fact_RequestedActivity].[Fullname] [Consultant],
            [Fact_RequestedActivity].[WardID] [WardID],
            [Fact_RequestedActivity].[ConsultantID] [ConsultantID],
            [Fact_Prescription].[PrescriptionStartDateTime] [PrescriptionStartDateTime],
            [Fact_Prescription].[PrescriptionStartDateTime2] [PrescriptionStartDateTime2],
            [Fact_Prescription].[CaseNumber2] [CaseNumber2],
            [Fact_Prescription].[Name] [Name],
            [Fact_RequestedActivity].[WardID] [WardID2],
            [Fact_RequestedActivity].[ConsultantID] [ConsultantID2],
            [Fact_Prescription].[NHSNumber2] [NHSNumber2],
            [Fact_RequestedActivity].[RequestActivityID] [RequestActivityID]
        FROM
            (
                SELECT        RequestActivityID, PrescriptionID, EpisodeID, RequestTypeID, RequestDateID, RequestTimeID, AuthorisedByID, RequestDateTime, PatientOwn, 
                         SupervisedAdmin, SelfAdmin, Description, LocationID, Terminal, Ward, WardID, WardLongDesc, Fullname, ConsultantID, SpecialtyDesc, SpecialtyID
FROM            v_Fact_RequestedActivity
            ) [Fact_RequestedActivity]
            LEFT OUTER JOIN (
                SELECT
                    [Patient].[Patient] [Patient],
                    [Patient].[Patient1] [Patient1],
                    [Patient].[NHSNumber] [NHSNumber],
                    [Patient].[Patient2] [Patient2],
                    [Patient].[CaseNumber] [CaseNumber],
                    [Fact_Prescription].[Description] [Description],
                    [Product].[ProductDescShort] [ProductDescShort],
                    [Fact_Prescription].[PrescriptionStartDateTime] [PrescriptionStartDateTime],
                    [Fact_Prescription].[PrescriptionStartDateTime] [PrescriptionStartDateTime2],
                    [Patient].[CaseNumber2] [CaseNumber2],
                    [Patient].[Name] [Name],
                    [Patient].[NHSNumber2] [NHSNumber2],
                    [Fact_Prescription].[PrescriptionID] [PrescriptionID]
                FROM
                    (
                        SELECT        PrescriptionID, PrescriptionID_Original, EpisodeID, ProductID, PrescriptionStartDateID, PrescriptionStartTimeID, PrescriptionStopDateID, 
                         PrescriptionStopTimeID, ProductRouteID, ScheduleID, PrescriptionCreationTypeID, PrescriptionTypeID, PrescribedByID, OwnerID, PatientID, 
                         PrescriptionStartDateTime, PrescriptionStopDateTime, InOnFormulary, PatientOwn, SelfAdmin, SupervisedAdmin, duration, DurationLow, Rate, RateMin, 
                         RateMax, Dose, DoseLow, GivenAsRequired, Quantity, QuantityMin, QuantityMax, LicensedRoute, AdminMethod_Desc, Frequency_Desc, Description, 
                         PrescriptionType, ControlledDrug, ConsultantID, ConsultantDesc, WardID, WardLongDesc, SpecialtyDesc, TreatmentReason, AuthorisingUser, 
                         [Committed By], Terminal, TerminalWard, PrescriptionCreatedDateTime, AccuracyCheckDateTime, PrescriptionCreateDate, PrescriptionStartDate
FROM            v_Fact_Prescription
                    ) [Fact_Prescription]
                    LEFT OUTER JOIN (
                        SELECT
                            [Patient].[PatientID] [Patient],
                            [Patient].[Name] [Patient1],
                            [Patient].[NHSNumber] [NHSNumber],
                            [Patient].[PatientID] [Patient2],
                            [Patient].[CaseNumber] [CaseNumber],
                            [Patient].[CaseNumber] [CaseNumber2],
                            [Patient].[Name] [Name],
                            [Patient].[NHSNumber] [NHSNumber2],
                            [Patient].[PatientID] [PatientID]
                        FROM
                            [Dim].[Patient] [Patient]
                    ) [Patient] ON [Fact_Prescription].[PatientID] = [Patient].[PatientID]
                    LEFT OUTER JOIN (
                        SELECT
                            [Product].[ProductDesc_Short] [ProductDescShort],
                            [Product].[ProductID] [ProductID]
                        FROM
                            [Dim].[Product] [Product]
                    ) [Product] ON [Fact_Prescription].[ProductID] = [Product].[ProductID]
            ) [Fact_Prescription] ON [Fact_RequestedActivity].[PrescriptionID] = [Fact_Prescription].[PrescriptionID]
            LEFT OUTER JOIN (
                SELECT
                    [v_request_date].[Date_Desc] [DateDesc],
                    [v_request_date].[Date_SK] [Date_SK]
                FROM
                    [dbo].[v_request_date] [v_request_date]
            ) [v_request_date] ON [Fact_RequestedActivity].[RequestDateID] = [v_request_date].[Date_SK]
    ) [Fact_RequestedActivity] ON [dbo_v_No_Response].[RequestActivityID] = [Fact_RequestedActivity].[RequestActivityID]
WHERE
    [Fact_RequestedActivity].[PrescriptionStartDateTime] >= CONVERT(DATETIME,'2025-10-22 00:00:00', 121) AND [Fact_RequestedActivity].[PrescriptionStartDateTime2] <= CONVERT(DATETIME,'2025-10-23 00:00:00', 121) AND (NOT(COALESCE(CHARINDEX('', [Fact_RequestedActivity].[CaseNumber2]), 0) = 0) OR '' = '') AND (NOT(COALESCE(CHARINDEX('', [Fact_RequestedActivity].[Name]), 0) = 0) OR '' = '') AND (NOT(COALESCE(CHARINDEX('', [Fact_RequestedActivity].[NHSNumber2]), 0) = 0) OR '' = '') AND [Fact_RequestedActivity].[WardID2] IN (1822, 1114, 1709, 1710, 17437, 1711, 1712, 1342, 1752, 1753, 1419, 34, 1344, 1061, 1064, 1719, 20, 33, 54, 1819, 58, 1259, 56, 57, 59, 1269, 21, 1345, 1820, 61, 1261, 60, 102, 50, 1048, 1066, 1067, 62, 63, 49, 25, 1103, 1347, 1373, 1370, 1574, 1348, 1484, 1485, 1488, 1487, 1634, 43, 1397, 1349, 1380, 26, 1350, 1417, 1381, 64, 73, 1817, 66, 55, 1363, 90, 1786, 1372, 1137, 1773, 1765, 44, 40, 1459, 1775, 1776, 1777, 1065, 71, 1724, 53, 1382, 1371, 1398, 1395, 1352, 1353, 1355, 1439, 1356, 1357, 28, 1726, 1727, 1729, 1730, 41, 22, 1611, 1358, 1587, 29, 1359, 31, 1818, 30, 32, 99, 74, 1401, 1360, 1438, 1781, 1362, 104, 1081, 1147, 1149, 1150, 1151, 1152, 1156, 1157, 1155, 1275, 1293, 1287, 1288, 1289, 1290, 1291, 1292, 100, 1456, 1717, 75, 46, 1434, 1365, 1821, 1232, 1277, 1278, 76, 77, 80, 81, 27, 1366, 83, 1455, 1369, 1368, 35, 84, 36, 39, 38, 1481, 1482, 1793, 1741, 1480, 1636, 101, 37, 1479, 1030, 1032, 1746, 1750, 1384, 1385, 1555, 1164, 1178, 1169, 42, 1386, 45, 86, 87, 1044, 1112, 1160, 1389, 1751, 1390, 1539, 1458, 88, 103, 89, 91, 92, 93, 1731, 1392, 1594, 1394, 1423, 1420, 1422, 1421, 1424, 1396, 94, 1816, 18, 1260, 96, 1074, 95, 98, 97, 1399, 1708, 1400, -1, 1239, 1132, 51, 47, 1108, 52, 48, 1721, 1757, 1758, 1722, 1760, 1713, 1784, 1792, 1795, 1742, 1799, 1800, 1801, 1802, 1803) AND [Fact_RequestedActivity].[ConsultantID2] IN (165943, 126509, 138770, 138771, 159450, 159324, 138772, 159456, 138774, 128021, 1684, 159326, 156100, 159461, 159463, 