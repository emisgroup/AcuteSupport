DECLARE
        @CurrentSessionID int
    ,   @EpisodeID int
    ,   @UserID int
    ,   @TerminalID int
    ,   @ParentID int
    ,   @FirstRow int
    ,   @LastRow int
	, @ward varchar
    
    

    Set @CurrentSessionID = 15668276
    Select @EpisodeID = [PrimaryKey] From State s Join [Table] t on s.TableID = t.TableID Where s.SessionID=15668276 and t.Description = 'Episode'
    Select  @UserID = EntityID From Session where SessionID = 15668276
    Set @TerminalID = NULL
    Set @ParentID = NULL
    Set @FirstRow = 1
    Set @LastRow = 20
	

------------------------------------------ End Variables - Do not paste text above this line back into Worklist Editor -----------------------------------------------------

IF isnull(@Ward, 0) = 0
BEGIN
    SELECT
            0 AS 'ID'
        ,   'Error: Please select a Ward above' AS 'Text'
        ,   '' AS 'Date'
        ,   '' AS 'Status'
        ,   'Episode' AS 'Class'
    
    RETURN
END

DECLARE @AliasGroup_PPI varchar(128)
  ,  @AliasGroup_SPI varchar(128)
  

SELECT 
    @AliasGroup_PPI = Setting.Value
FROM
    Setting
WHERE 
        Setting.[System] = 'General' 
    AND Setting.[Section] = 'PatientEditor' 
    AND Setting.[Key] = 'PrimaryPatientIdentifier' 
    AND Setting.RoleID = 0
   
   
SELECT 
    @AliasGroup_SPI = Setting.Value
FROM
    Setting
WHERE 
        Setting.[System] = 'General' 
    AND Setting.[Section] = 'PatientEditor' 
    AND Setting.[Key] = 'SecondaryPatientIdentifier' 
    AND Setting.RoleID = 0
    
DECLARE @DisplayName_PPI varchar(128)
  ,  @DisplayName_SPI varchar(128)
  
SELECT @DisplayName_PPI = DisplayName FROM AliasGroup WHERE [Description] = @AliasGroup_PPI
SELECT @DisplayName_SPI = DisplayName FROM AliasGroup WHERE [Description] = @AliasGroup_SPI

Declare @Results TABLE
(
    ID int,
    Surname varchar(256),
    Forename varchar(256),
    PriamryAlias varchar(256),
    SecondaryAlias varchar(256),
    DOB datetime,
    ConsultantText varchar(256),
    [Date] varchar(256),
    [Status] varchar(256),
    Class varchar(256),
    [RowNumber] int,
    [Rowcount] int
)    
Insert into @Results
    SELECT 
            Episode.EpisodeID AS 'ID'
        ,   Person.Surname
        ,	Person.Forename
        ,	isnull(' (' + icwsys.fFormatID(EntityAlias.Alias, AliasGroup.Format) + ')', ' (' + @DisplayName_PPI + ' unknown)') 
        ,	isnull(' (' + icwsys.fFormatID(EA_SPI.Alias, AG_SPI.Format) + ')', ' (' + @DisplayName_SPI + ' unknown)')  
        ,	Patient.DOB
        ,   isnull(' (' + Consultant.[Description] + ' - ' + isnull(Specialty.[Description], 'None') + ')', '')
        ,   '' AS 'Date'
        ,   '' AS 'Status'
        ,   'Episode' AS 'Class'
        ,   row_number() over (ORDER BY Person.Surname, Person.Forename, EntityAlias.Alias, Patient.DOB) AS 'RowNumber'
        ,   count(*) over () AS 'Rowcount'
    FROM
        Episode
        JOIN EpisodeLocation ON Episode.EpisodeID = EpisodeLocation.EpisodeID
        JOIN Location ON EpisodeLocation.LocationID = Location.LocationID
        JOIN LocationType ON Location.LocationTypeID = LocationType.LocationTypeID
        JOIN Person ON Episode.EntityID = Person.EntityID
        JOIN Patient ON Episode.EntityID = Patient.EntityID
        JOIN EpisodeType ON Episode.EpisodeTypeID = EpisodeType.EpisodeTypeID
        LEFT JOIN
            EntityAlias
            JOIN AliasGroup ON EntityAlias.AliasGroupID = AliasGroup.AliasGroupID AND AliasGroup.[Description] = @AliasGroup_PPI
        ON Episode.EntityID = EntityAlias.EntityID AND EntityAlias.[Default] = 1
        
        LEFT JOIN EntityAlias EA_SPI
        JOIN AliasGroup AG_SPI ON EA_SPI.AliasGroupID = AG_SPI.AliasGroupID AND AG_SPI.[Description] = @AliasGroup_SPI
            ON Episode.EntityID = EA_SPI.EntityID AND EA_SPI.[Default] = 1
        LEFT JOIN (ResponsibleEpisodeEntity REE 
            JOIN Entity Consultant ON REE.EntityID = Consultant.EntityID
            JOIN EntityRole ON REE.EntityRoleID = EntityRole.EntityRoleID AND EntityRole.[Description] = 'Consultant') ON REE.EpisodeID = Episode.EpisodeID AND REE.Active = 1 AND REE.EntityRoleID = ( SELECT EntityRoleID FROM EntityRole WHERE Description = 'Consultant')
        LEFT JOIN (EpisodeNote 
            JOIN PatientCareDetails on PatientCareDetails.NoteID = EpisodeNote.NoteID
            JOIN Specialty on Specialty.SpecialtyID = PatientCareDetails.SpecialtyID) ON EpisodeNote.EpisodeID=Episode.EpisodeID
		LEFT JOIN Note On EpisodeNote.NoteID = Note.NoteID AND Note.[Description]='Patient care details' AND EpisodeNote.Expired = 0
            
    WHERE
        EpisodeLocation.Active = 1
        AND Location.LocationID = @Ward
        AND LocationType.[Description] IN ('Ward', 'Outpatient Location')
        AND EpisodeType.[Description] IN ('In-patient', 'Spell')
        AND Episode.EndDate IS NULL
        AND Episode.StartDate <= getdate()
        AND Episode.EpisodeID_Parent > 0

Declare @PatientData AS PatientMatchingTableType

Insert into @PatientData
Select Distinct ID, Surname ,Forename, DOB from @Results

--==== US 216415, 15/08/2018 - If the VTE status setting is disabled, the inner query below returns ""VTE Status:  |"" =====
Select id, [Text], [Date], rTrim(lTrim(Replace([Status], 'VTE Status:  |', ''))) As [Status], Class, [RowCount], RowNumber 
From (
	  Select 
	  r.ID, 
	  Surname + ', ' + Forename + PriamryAlias + SecondaryAlias + ConsultantText + isnull(' - ' + convert(varchar(10), DOB, 103), '') AS [Text], 
	  '' AS [Date], 
	  'VTE Status: ' + 
	  IsNull(r.[Status], '') + icwsys.fGetVTEstatusText(@currentsessionid, r.ID, Null) + ' | ' +
	  CASE 
		  When IsNull(r.[Status],'') <> '' and IsNull(pd.[Status], '') <> '' 
			  Then ' | '
			  Else ''
	  END + IsNull(pd.[Status], '') AS [Status], 
	  Class, 
	  [Rowcount], 
	  RowNumber
	  FROM @Results r Inner Join GetPatientMatchingStatus(@PatientData) pd on r.ID = pd.ID
	  WHERE 
	  r.RowNumber BETWEEN @FirstRow AND @LastRow 
	  ) As qry1 
ORDER BY RowNumber

