20/04/2026 12:17:12 - Muhammed Rashik Rahman (Work notes)
select  * from ascEMMIntervention
where ascEMMInterventionLocationID is null


begin tran
update a
set a.ascEMMInterventionLocationID = ab.ascEMMInterventionLocationID
from ascEMMIntervention a
inner join ascEMMIntervention_CS1751565 ab on a.NoteID =ab.NoteID


--commit
--rollback

20/04/2026 12:09:43 - Muhammed Rashik Rahman (Work notes)
select aei.noteid,ascEMMInterventionLocationID,el.LocationID,ea.Alias,l.Description into ascEMMIntervention_CS1751565  from ascEMMIntervention aei
join note n on n.NoteID =aei.NoteID
join EpisodeNote en on en.NoteID =aei.NoteID
join Episode e on e.EpisodeID = en.EpisodeID
join EpisodeLocation el on el.EpisodeID =e.EpisodeID
join Location l on el.LocationID = l.LocationID
join EntityAlias ea on ea.EntityID =e.EntityID and AliasGroupID =22 and ea.[Default] =1
where aei.ascEMMInterventionLocationID is null and el.Active =1
order by n.NoteID

