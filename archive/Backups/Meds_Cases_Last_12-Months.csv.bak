"CS1694976","Lancashire Care NHS Foundation Trust","3 - Medium","26/11/2025 14:24:16","Closed","NPSA Information Alert : NATPSA/2025/006/NHSPS - Harm from incorrect recording of a penicillin allergy as a penicillamine allergy -","14/04/2026 12:05:39","James.Mcdonough@lscft.nhs.uk","Acute Care Medicines Management Level 1 Team","Swati Dongare","26/11/2025 17:55:15 - Swati Dongare (Work notes)
SELECT
    p.Description as 'Allergy',
    a.CreatedDate as 'Allergy recorded date',
	ea.alias as 'Patient HospID'
FROM DssAllergy A
JOIN Product P ON A.ProductID = P.ProductID
JOIN episode e on a.EpisodeID = e.episodeid
join EntityAlias ea on e.EntityID = ea.EntityID
WHERE P.ProductID IN (
    SELECT ProductID 
    FROM Product
    WHERE Description LIKE '%penicillamine%'
)
and ea.AliasGroupID = 22
ORDER BY A.CreatedDate;

