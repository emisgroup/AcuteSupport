SELECT u.EntityID,u.Username,e.Description AS [Name],
MAX(l.DateTime) AS LastSuccessfulLogin
FROM [User] u
JOIN Entity e ON e.EntityID = u.EntityID
JOIN LoginAttempt l ON l.Username = u.Username
WHERE u.Deleted <> 1
AND l.Success = 1
--AND l.DateTime >= DATEADD(YEAR, -1, GETDATE()) --and u.Username='alisa005'
GROUP BY u.EntityID, u.Username,e.Description
ORDER BY LastSuccessfulLogin DESC;

