select u.Username,u.DateCreated, p.Description as ""Policy"", r.Description ""Role""
from icwsys.[user] u 
join icwsys.UserLinkRole ulr on u.EntityID = ulr.EntityID
join icwsys.permission per on ulr.RoleID = per.RoleID
join icwsys.Role r on ulr.RoleID = r.roleid
join icwsys.policy p on per.PolicyID = p.PolicyID
--where u.username = 'sysadmin14' --enter username
where p.Description ='Security' --or p.Description ='Security Administration'


-------------
SELECT
    Username,
    Location,
    MAX(DateTime) AS LastLogin
FROM LoginAttempt
WHERE Success = 1
AND Username IN (
    SELECT Username
    FROM LoginAttempt
    WHERE Success = 1
    GROUP BY Username
    HAVING COUNT(DISTINCT Location) > 1
)
GROUP BY Username, Location
ORDER BY Username, Location;

---------------

WITH Dedup AS (
    SELECT 
        Username,
        Location,
        MAX(DateTime) AS LastLogin
    FROM LoginAttempt
    WHERE Success = 1
    GROUP BY Username, Location
)
SELECT *
FROM Dedup
WHERE Location IN (
    SELECT Location
    FROM Dedup
    GROUP BY Location
    HAVING COUNT(DISTINCT Username) > 1
)
ORDER BY Location, Username;

