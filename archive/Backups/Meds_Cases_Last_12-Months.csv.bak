--changed to 330 which was the E WARD (GYNAE / SURGICAL)  brought back the 6 people awaiting discharge


 DECLARE
        @CurrentSessionID int
    ,   @EpisodeID int
    ,   @UserID int
    ,   @TerminalID int
    ,   @ParentID int
    ,   @FirstRow int
    ,   @LastRow int
    
    

    Set @CurrentSessionID = 79162154
    Select @EpisodeID = [PrimaryKey] From State s Join [Table] t on s.TableID = t.TableID Where s.SessionID=79162154 and t.Description = 'Episode'
    Select  @UserID = EntityID From Session where SessionID = 79162154
    Set @TerminalID = NULL
    Set @ParentID = NULL
    Set @FirstRow = 1
    Set @LastRow = 20

------------------------------------------ End Variables - Do not paste text above this line back into Worklist Editor -----------------------------------------------------

DECLARE 
    @DischargeRequestTypeID int
  ,  @TransferNoteTypeID int

SELECT @DischargeRequestTypeID = RequestTypeID FROM RequestType WHERE [Description] = 'DischargeRequest'
SELECT @TransferNoteTypeID = NoteTypeID FROM NoteType WHERE [Description] = 'Patient Transfer Note'


SELECT  R.RequestID, CreatedDate, RS.DischargeDispensingComplete, RS.DischargeDispensingInProgress, RS.[Discharge Checked],RS.EpisodeOrder__EpisodeID  into #EpisodeRequest FROM  Episode ER 
				JOIN RequestStatus RS ON ER.EpisodeID = RS.EpisodeOrder__EpisodeID
				JOIN Request R ON RS.RequestID = R.RequestID
				AND RS.RequestType__RequestTypeID = @DischargeRequestTypeID
				AND RS.[Request Cancellation] = 0

CREATE TABLE #Result
	(
	  [ID] int UNIQUE,
	  [Text] varchar(256) COLLATE LATIN1_GENERAL_CI_AS, 
	  [Date] varchar(256) COLLATE LATIN1_GENERAL_CI_AS,
	  [Status] varchar(256) COLLATE LATIN1_GENERAL_CI_AS,
	  [Class] varchar(256) COLLATE LATIN1_GENERAL_CI_AS,
	  [EntityID] int,
	  [DOB] datetime,
	  [Surname] varchar(256) COLLATE LATIN1_GENERAL_CI_AS,
	  [Forename] varchar(256) COLLATE LATIN1_GENERAL_CI_AS
	);          

--List of episodes which have been marked as ready for discharge
INSERT INTO #Result
SELECT
    Episode.EpisodeID AS 'ID'
  ,  upper(Person.Surname) + ', '
    + isnull(Person.Forename, '') + ' - '
    + isnull(L.[Description], '*** No Ward Set ***') AS 'Text'
  ,  convert(varchar(10), s.CreatedDate, 103) + ' ' 
    + convert(varchar(5), s.CreatedDate, 108) AS 'Date'
  ,  CASE
      WHEN DR.Priority = 1 THEN '**Priority** '
      ELSE ''
    END
    +CASE
      WHEN DR.OutOfHours = 1 THEN 'Out Of Hours - '
      ELSE ''
    END
    +CASE
      WHEN s.[Discharge Checked] = 0 THEN 'Awaiting Clinical Check'
      WHEN s.DischargeDispensingComplete = 1 THEN 'Dispensing Complete'
      WHEN s.DischargeDispensingInProgress = 1 THEN 'Dispensing In Progress'
      WHEN s.[Discharge Checked] = 1 THEN 'Clinically Checked'
      ELSE 'Clinical Check Status Unknown'
    END AS 'Status'
  ,  'Episode' AS 'Class'
  ,	 Person.EntityID ""EntityID""
  ,  Patient.DOB ""DOB""
  ,	 Person.Surname ""Surname""
  ,	 Person.Forename ""Forename""
FROM
  Episode
  JOIN Person ON Episode.EntityID = Person.EntityID
  JOIN Patient ON Episode.EntityID = Patient.EntityID
  JOIN EpisodeLocation EL 
      JOIN Location L ON EL.LocationID = L.LocationID 
      JOIN Ward ON L.LocationID = Ward.LocationID
  ON Episode.EpisodeID = EL.EpisodeID AND EL.Active = 1 

  CROSS APPLY (SELECT TOP 1 RequestID, CreatedDate, DischargeDispensingComplete, DischargeDispensingInProgress, [Discharge Checked] FROM  #EpisodeRequest ER 
				WHERE ER.EpisodeOrder__EpisodeID = Episode.EpisodeID
				ORDER BY ER.RequestID DESC) s
  JOIN edsDischargeRequest DR ON s.RequestID = DR.RequestID
  
  LEFT JOIN EpisodeNote
	JOIN Note ON EpisodeNote.NoteID = Note.NoteID AND Note.NoteTypeID = @TransferNoteTypeID                                              
  ON Episode.EpisodeID = EpisodeNote.EpisodeID AND Note.CreatedDate > s.CreatedDate
WHERE
  EpisodeNote.NoteID IS NULL
  AND (
      --Show anything with no Ward, plus items on the user's ward
      EL.LocationID = 15403
      OR 15403 = -1
      OR EL.LocationID IS NULL
    )
ORDER BY
    DR.Priority DESC
  ,  isnull(CONVERT (bit, EL.LocationID), 0) DESC
  ,  Person.Surname
  ,  Person.Forename;


    -- Get all patient specific information from @Result
	DECLARE @PatientData AS PatientMatchingTableType
	insert into @PatientData
	select DISTINCT [EntityID], [Surname],[Forename],[DOB] from #Result; 

	-- Return results. GetPatientMatchingStatus checks for any similar patients in the result and appends a message to the status if similar patient found
	SELECT
	r1.ID,
	r1.Text,
	r1.Date,
	isnull(r1.[Status], '') 
	  + CASE when isnull(r1.[Status],'') <> '' and isnull(pd.[Status], '') <> '' 
			 Then ' | '
			 Else ''
		END
	  + isnull(pd.[Status], '') AS 'Status',
	r1.Class
	from #Result r1 inner join GetPatientMatchingStatus(@PatientData) pd on r1.[EntityID] = pd.ID;

DROP TABLE #Result

DROP TABLE #EpisodeRequest

