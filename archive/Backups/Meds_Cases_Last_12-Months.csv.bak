select * from icwsys.EventEnginelog eel 
join icwsys.EventEngineEventType eeet 
on eel.EventEngineEventTypeID = eeet.EventEngineEventTypeID 
where eeet.Description = 'Critical' 
and eel.Actioned = 0
if  exists(
select * from icwsys.EventEnginelog eel
join icwsys.EventEngineEventType eeet
on eel.EventEngineEventTypeID = eeet.EventEngineEventTypeID
where eeet.Description = 'Critical'
and eel.Actioned = 0)
 
Begin
declare @EntityID int = (select entityid from icwsys.[User] where [Username] = 'sysadmin14')
update eel
set eel.actioned = 1, eel.ActionedByEntityID = @EntityID, eel.ActionedDate = GETDATE()
from icwsys.EventEnginelog eel
join icwsys.EventEngineEventType eeet
on eel.EventEngineEventTypeID = eeet.EventEngineEventTypeID
where eeet.Description = 'Critical'
and eel.Actioned = 0
END
Else
PRINT 'No Errors'

