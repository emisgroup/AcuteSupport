"CS1640122","United Lincolnshire Teaching Hospitals NHS Trust","4 - Low","28/08/2025 13:26:28","Closed","Event Engine notifications for critical errors","02/09/2025 12:59:48","system","Acute Care Medicines Management Level 1 Team","Muhammed Rashik Rahman","29/08/2025 13:46:46 - Muhammed Rashik Rahman (Work notes)
DECLARE @mailbody NVARCHAR(MAX);
DECLARE @Tolist NVARCHAR(1000);
DECLARE @Subject NVARCHAR(255);

IF EXISTS (
    SELECT * 
    FROM icwsys.EventEnginelog eel
    JOIN icwsys.EventEngineEventType eeet
        ON eel.EventEngineEventTypeID = eeet.EventEngineEventTypeID
    WHERE eeet.Description = 'Critical'
      AND eel.CreatedDate >= DATEADD(HOUR, -2, GETDATE()) -- Adjust hours here if needed
      AND eel.Actioned = 0
)
BEGIN
    SET @mailbody = 'Critical logs have been recorded on the Event Engine control panel. Please access the Pharmacy system and take the necessary actions promptly to prevent any disruption to patient medication. If you require assistance, please raise a case with Optum UK.';
    
    SET @Subject = 'Critical Errors - EventEngine Control Panel - ULH';
    
    SET @Tolist = 'ulth.applicationservices@nhs.net;ulth.epma@nhs.net;MedicinesManagementSupport.SecondaryCare@emishealth.com';

    EXEC msdb.dbo.sp_send_dbmail 
        @profile_name = 'Internal',
        @recipients = @Tolist,
        @body = @mailbody,
        @subject = @Subject;
END

