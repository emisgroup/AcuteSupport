select a.Detail as 'AllergyDetail',p.Description 'RecordAgainst',a.CreatedDate as 'DateCreated',ea.Alias as 'HospitalNumber',pa.DOB, 
ep.Description as 'Name',g.Description as 'Gender' from icwsys.DssAllergy a
join icwsys.Product p on p.ProductID=a.ProductID
join icwsys.Episode e on e.EpisodeID =a.EpisodeID
join icwsys.EntityAlias ea on e.EntityID=ea.EntityID
join icwsys.Patient pa on e.EntityID=pa.EntityID
join icwsys.entity ep on ep.EntityID =e.EntityID
join icwsys.Gender g on g.genderid= pa.GenderID
where 
(a.Detail like '%Anaphylaxis%' or 
a.Detail like '%Stevens -Johnson Syndrome%' or 
a.Detail like '%Toxic Epidermal%') and ea.AliasGroupID=22

19/06/2026 16:04:59 - Muhammed Rashik Rahman (Work notes)
SELECT 

    p.Description as 'Allergy', 

    a.CreatedDate as 'Allergy recorded date', 

ea.alias as 'Patient HospID' 

FROM icwsys.DssAllergy A 

JOIN icwsys.Product P ON A.ProductID = P.ProductID 

JOIN icwsys.episode e on a.EpisodeID = e.episodeid 

join icwsys.EntityAlias ea on e.EntityID = ea.EntityID 

WHERE P.ProductID IN ( 

    SELECT ProductID  

    FROM icwsys.Product 

    WHERE Description LIKE '%Stevens%'  or Description LIKE '%Anaphylaxis%' or Description LIKE '%oxic Epidermal%'

)

