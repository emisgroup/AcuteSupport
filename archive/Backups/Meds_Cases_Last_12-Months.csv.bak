28/08/2025 11:55:54 - Muhammed Rashik Rahman (Work notes)
select * from icwsys.EventEnginelog eel
join icwsys.EventEngineEventType eeet
on eel.EventEngineEventTypeID = eeet.EventEngineEventTypeID
where eeet.Description in('critical','warning')



SELECT 
    FORMAT(eel.CreatedDate, 'yyyy-MM') AS Month,
    eeet.Description AS EventType,
    COUNT(*) AS LogCount
FROM icwsys.EventEnginelog eel
JOIN icwsys.EventEngineEventType eeet
    ON eel.EventEngineEventTypeID = eeet.EventEngineEventTypeID
WHERE eeet.Description IN ('Critical', 'Warning')
GROUP BY FORMAT(eel.CreatedDate, 'yyyy-MM'), eeet.Description
ORDER BY Month, EventType;

