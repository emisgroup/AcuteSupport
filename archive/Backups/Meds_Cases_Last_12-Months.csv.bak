24/10/2025 12:33:17 - Swati Dongare (Work notes)
SELECT
    s.session_id,
    s.login_name,
    s.status,
    r.status AS request_status,
    r.command,
    r.cpu_time,
    r.total_elapsed_time,
    r.transaction_id,
    t.transaction_state,
   ---------------- t.transaction_name,
    t.transaction_begin_time,
    t.transaction_type
FROM sys.dm_exec_sessions s
JOIN sys.dm_exec_requests r ON s.session_id = r.session_id
JOIN sys.dm_tran_session_transactions st ON s.session_id = st.session_id
JOIN sys.dm_tran_active_transactions t ON st.transaction_id = t.transaction_id
WHERE t.transaction_state = 1; -- 1 = active


