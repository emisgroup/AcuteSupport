12/08/2025 12:44:23 - Swati Dongare (Work notes)
DECLARE
        @CurrentSessionID int
    ,   @EpisodeID int
    ,   @UserID int
    ,   @TerminalID int
    ,   @ParentID int
    ,   @FirstRow int
    ,   @LastRow int
    
    

    Set @CurrentSessionID = 309458
    Select @EpisodeID = [PrimaryKey] From State s Join [Table] t on s.TableID = t.TableID Where s.SessionID=309458 and t.Description = 'Episode'
    Select  @UserID = EntityID From Session where SessionID = 309458
    Set @TerminalID = NULL
    Set @ParentID = NULL
    Set @FirstRow = 1
    Set @LastRow = 20

------------------------------------------ End Variables - Do not paste text above this line back into Worklist Editor -----------------------------------------------------

Declare @Use_LocationID int  
    ,   @Use_Ward   int 

select @Use_Ward = isnull(@Ward, -1)  

-- Search clicked before ward selected
if  @Use_Ward = ' ' 
    set @use_ward = -1 

-- Get Session Locatin  
select   
        @Use_LocationID = LocationID  
from   
    Session   
where   
    SessionID = @CurrentSessionID  
      
-- Get All wards for Session Location   
CREATE TABLE #RelevantWards (LocationID int primary key)  
INSERT   
    #RelevantWards (LocationID)  
SELECT  
    LocationID  
FROM  
    icwsys.fWardListByStockholdingTerminal(@Use_LocationID)  
      

-- Show Nurse Request for Location  
DECLARE @Result TABLE
(
  [ID] int UNIQUE, 
  [Class] varchar(256),
  [Location] varchar(256),
  [Patient] varchar(256),
  [Surname] varchar(256),
  [Forename] varchar(256),
  [DOB] datetime,
  [Patient_ID] int,
  [Description] varchar(256),
  [RequestDate] datetime,
  [SupplyRequestDate] datetime,
  [Status] varchar(256),
  [Orderby1] varchar(256),
  [Orderby2] varchar(256),
  [Orderby3] varchar(256)
);

insert into @Result 
Select distinct  
       Request.RequestID as 'ID', 
	   'Request' as Class,
	   Request.Location,
	   Request.Patient,
	   per.Surname,
	   per.Forename,
	   pat.DOB,
	   Request.EntityID_Patient,
	   request.[Description],
	   Request.RequestDate,
	   note.createddate,
		' By ' + entity.[Description] + ' - '  + convert(varchar(20), note.createddate, 106) + ' ' + convert(varchar(5), note.createddate, 8) + isnull(' ' + E.Comments, '') as 'Status',
		request.location as 'Orderby1',
		Request.Patient  as 'Orderby2',
		'Description'    as 'Orderby3' 
From  
    eMM_PMR Request  
	join Patient pat on Request.EntityID_Patient = pat.EntityID
	join Person per on Request.EntityID_Patient = per.EntityID
    join RequestLinkAttachedNote ran on Request.RequestID = ran.RequestID  
    join Note on Ran.NoteID = Note.NoteID  
    join entity on note.entityid = entity.entityid
    JOIN AttachedNote AN ON Note.NoteID = AN.NoteID   
    JOIN NoteType ON Note.NoteTypeID = NoteType.NoteTypeID   
    JOIN emmSupplyRequestNurse E ON Note.NoteID = E.NoteID  
    JOIN #RelevantWards RW ON Request.LocationID = RW.LocationID  
    JOIN RequestStatus ON Request.RequestID = RequestStatus.RequestID  

Where  Request.eMMSupplyRequestNurse__NoteID <> 0 
    and Request.Cancelled = 0  
    and RequestStatus.Expired = 0  
    and Request.eMMSupplyRequestNurse = 1  
    and (  
            @Use_Ward = -1  
            OR Request.LocationID = @Use_Ward  
        )  
    AND NoteType.[Description] = 'eMMSupplyRequestNurse'   
    AND AN.Enabled = 1  
order by createddate, 'Orderby1', 'Orderby2', 'Orderby3';


DECLARE @PatientData AS PatientMatchingTableType
insert into @PatientData
select DISTINCT [Patient_ID], [Surname],[Forename],[DOB] from @Result;

SELECT
r1.ID,
r1.[Class],  
r1.Location + ' - ' + r1.Patient + ' - ' + r1.[Description] as 'Text',
convert(varchar(50), r1.[RequestDate], 106) as 'Date',
isnull(r1.[Status], '') 
	  + CASE when isnull(r1.[Status],'') <> '' and isnull(pd.[Status], '') <> '' 
			 Then ' | '
			 Else ''
		END
	  + isnull(pd.[Status], '') AS 'Status',  
[Orderby1],
[Orderby2],
[Orderby3]
from @Result r1 inner join GetPatientMatchingStatus(@PatientData) pd on r1.[Patient_ID] = pd.ID
order by SupplyRequestDate;

DROP TABLE #RelevantWards;

