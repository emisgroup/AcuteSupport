IF (SELECT COUNT(ProductID) FROM Product WHERE ProductTypeID = @ChemicalTypeID AND [Description] LIKE @SearchText + '%') <> 0
BEGIN
    SET @Chemicals = (SELECT 'Chemical (' + CONVERT(VARCHAR(20), (SELECT COUNT(ProductID) FROM Product WHERE ProductTypeID = @ChemicalTypeID AND [Description] LIKE @SearchText + '%')) + ' Matches)' As 'Type', 'Chemical' AS 'RowType', ProductID AS 'ID', [Description] FROM Product Item WHERE ProductTypeID = @ChemicalTypeID AND [Description] LIKE @SearchText + '%' 
    FOR XML PATH('Item'))
END
ELSE
BEGIN
    SET @Chemicals = (SELECT 'Chemical (' + CONVERT(VARCHAR(20), (SELECT COUNT(ProductID) FROM Product WHERE ProductTypeID = @ChemicalTypeID AND [Description] LIKE @SearchText + '%')) + ' Matches)' As 'Type', 'Chemical' AS 'RowType', -1 AS 'ID', @NoDataMsg As 'Description'
    FOR XML PATH('Item'))
END

