-- Auto generated script to build / amend CDH Pharmacy - Pharmacy Reference Data 611 desktop



DECLARE @ToolMenuMap		table ( ToolMenuID int, ToolMenuID_Old int, ToolMenuID_Parent_Old int )

DECLARE @WindowMap			table ( WindowID int, WindowID_Old int, WindowID_Parent_Old int )

DECLARE @DesktopID			int

DECLARE @WindowID_Top		int

DECLARE @PolicyID			int

DECLARE @ToolMenuID_Menu	int

DECLARE @ToolMenuID_Toolbar	int



-- Script to clear an existing desktop or create a new desktop if the desktop does not exist



SET @DesktopID = (SELECT DesktopID FROM Desktop WHERE [Description] = 'CDH Pharmacy - Pharmacy Reference Data 611')

IF @DesktopID IS NULL

BEGIN

	INSERT INTO Policy ( [Description], Detail )

	VALUES ( 'CDH Pharmacy - Pharmacy Reference Data 611', 'Desktop PolicyCDH Pharmacy - Pharmacy Reference Data 611' )

	SET @PolicyID = SCOPE_IDENTITY()



	INSERT INTO Desktop ( PolicyID, ToolMenuID_Menu, ToolMenuID_Toolbar, [Description], PictureName, ShowInShortcutBar, AscribeIssued, DesktopID_Source, hidden)

	VALUES ( @PolicyID, 0, 0, 'CDH Pharmacy - Pharmacy Reference Data 611', 'mortar and pestle - Peach16.gif', 1, 0, (SELECT [DesktopID] FROM [Desktop] WHERE [Description] = ''), 0)

	SET @DesktopID = SCOPE_IDENTITY()



	INSERT INTO Window ( WindowID_Parent, WindowTypeID, DesktopID, ToolMenuID, [Description], Orientation, Offset, [Order], URL )

	VALUES ( 0, 1, @DesktopID, 0, 'Unnamed1', '', 0, 0, '' )

	SET @WindowID_Top = SCOPE_IDENTITY()

END

ELSE

BEGIN

	EXEC pDesktopSetAsNew 'CDH Pharmacy - Pharmacy Reference Data 611'

	SET @WindowID_Top = (SELECT WindowID FROM Window WHERE DesktopID = @DesktopID AND WindowID_Parent = 0)

	IF @WindowID_Top IS NULL

	BEGIN

		INSERT INTO Window ( WindowID_Parent, WindowTypeID, DesktopID, ToolMenuID, [Description], Orientation, Offset, [Order], URL )

		VALUES ( 0, 1, @DesktopID, 0, 'Unnamed1', '', 0, 0, '' )

		SET @WindowID_Top = SCOPE_IDENTITY()

	END

END



-- Create all ToolMenus and store original IDs in temp table to map all elements later



DECLARE @ToolMenuID	int



UPDATE ToolMenu

SET ToolMenuID_Parent = Parent.ToolMenuID

FROM ToolMenu

	JOIN @ToolMenuMap Map ON ToolMenu.ToolMenuID = Map.ToolMenuID

	JOIN @ToolMenuMap Parent ON Map.ToolMenuID_Parent_Old = Parent.ToolMenuID_Old

WHERE Map.ToolMenuID_Parent_Old <> 0



-- Create all Windows and store original IDs in temp table to map all elements later



DECLARE @WindowID	int



SET @ToolMenuID = 0



UPDATE Window

SET WindowTypeID = 1, ToolMenuID = @ToolMenuID, [Description] = 'Pharmacy Reference Data', Orientation = ' ', Offset = 0, [Order] = 0, URL = 'PharmacyReferenceData'

WHERE WindowID = @WindowID_Top

SET @WindowID = @WindowID_Top



INSERT INTO @WindowMap

VALUES ( @WindowID, 492, 0 )



UPDATE Window

SET WindowID_Parent = Parent.WindowID

FROM Window

	JOIN @WindowMap Map ON Window.WindowID = Map.WindowID

	JOIN @WindowMap Parent ON Map.WindowID_Parent_Old = Parent.WindowID_Old

WHERE Map.WindowID_Parent_Old > 0



-- Create all Window Parameters



SET @WindowID = ( SELECT WindowID FROM @WindowMap WHERE WindowID_Old = 492 )

INSERT INTO WindowParameter ( WindowID, [Description], Value )

VALUES ( @WindowID, 'AscribeSiteNumber', '611' )



SET @WindowID = ( SELECT WindowID FROM @WindowMap WHERE WindowID_Old = 492 )

INSERT INTO WindowParameter ( WindowID, [Description], Value )

VALUES ( @WindowID, 'Mode', 'E' )



SET @WindowID = ( SELECT WindowID FROM @WindowMap WHERE WindowID_Old = 492 )

INSERT INTO WindowParameter ( WindowID, [Description], Value )

VALUES ( @WindowID, 'ApplicationPath', 'c:\ascribe\smartclient' )



SET @WindowID = ( SELECT WindowID FROM @WindowMap WHERE WindowID_Old = 492 )

INSERT INTO WindowParameter ( WindowID, [Description], Value )

VALUES ( @WindowID, 'StoresPass', '8' )



SET @WindowID = ( SELECT WindowID FROM @WindowMap WHERE WindowID_Old = 492 )

INSERT INTO WindowParameter ( WindowID, [Description], Value )

VALUES ( @WindowID, 'ReadOnly', 'No' )



-- Create all Window Events



GO

-- End of auto generated script to build / amend CDH Pharmacy - Pharmacy Reference Data 611 desktop




