"CS1725013","Walsall Healthcare NHS Trust","4 - Low","28/01/2026 10:18:57","Closed","NHS SBS AP Interface","17/02/2026 10:36:43","system","Acute Care Medicines Management Level 1 Team","Swati Dongare","11/02/2026 17:42:22 - Swati Dongare (Work notes)
IF OBJECT_ID('pGenfin_AP_Export_SBS') IS NOT NULL
	DROP PROCEDURE pGenfin_AP_Export_SBS
GO

CREATE PROCEDURE pGenfin_AP_Export_SBS
	@GFBatchNumber INT
	AS

/*
This is an Oracle Interface in SBS flavour.

CHANGE LOG
==========
04/02/2019 JKu TFS 235727 Code revamped to include generic code and added consolidated output file.

*/

--Unit Test
--use EHSC_REPORTING
--declare @GFBatchNumber int = 2
--

declare @theGFBatchNumber Int = @GFBatchNumber
declare @SegmentCode1 varchar (25) = (select SegmentCode from [map_AP_OracleSegmentCodes_SBS] where OracleAccountSegment = 1)
declare @SegmentCode2 varchar (25) = (select SegmentCode from [map_AP_OracleSegmentCodes_SBS] where OracleAccountSegment = 2)
declare @SegmentCode3 varchar (25) = (select SegmentCode from [map_AP_OracleSegmentCodes_SBS] where OracleAccountSegment = 3)
declare @SegmentCode4 varchar (25) = (select SegmentCode from [map_AP_OracleSegmentCodes_SBS] where OracleAccountSegment = 4)
declare @SegmentCode5 varchar (25) = (select SegmentCode from [map_AP_OracleSegmentCodes_SBS] where OracleAccountSegment = 5)
declare @PaymentTerms varchar (25) = (select PaymentTerms from map_AP_PaymentTerms_SBS where ID = 1)
declare @DefaultLineType varchar (15) = (select LineType from map_AP_OracleLineType_SBS where NSVCode = 'XXXXXXX')

--=========================================================================================================================================
-- Create a temporary table #AP to work on
--=========================================================================================================================================

IF OBJECT_ID('tempDB..#AP') IS NOT NULL
	DROP TABLE #AP;

SELECT 
	A.[Site]
,	A.SupCode
,	A.Num
,	A.InvNum
,	A.Code 
,	A.PayDate
,	A.ReconcileDate
,	A.GFBatchNumber
,	A.GFBatchDate
,	B.CostCentre
,	@SegmentCode1 OracleAccountSegment1
,	@SegmentCode2 OracleAccountSegment2
,	@SegmentCode3 OracleAccountSegment3
,	@SegmentCode4 OracleAccountSegment4
,	@SegmentCode5 OracleAccountSegment5
,	@PaymentTerms PaymentTerms
,	case when D.NSVCode IS not null
		 then D.LineType 
		 else @DefaultLineType
		 end OracleLineType
,	Space (15) OracleVATCode
,	A.VatRateCode
,	A.VatRatePct
,	A.VATamount
,	Convert(float, A.VATInclusive) VATInclusive
,	(RTrim(InvNum) + RTrim(SupCode) + convert(varchar(10), A.[Site])) as Reference

INTO #AP
FROM Interface_AP_SBS A
left join rSupplier B on A.SupCode = B.Supplier and A.[Site] = B.[Site]
LEFT JOIN map_AP_ExcludeSupplier_SBS C ON A.SupCode = C.Supplier
left join map_AP_OracleLineType_SBS D on A.Code = D.NSVCode
left join map_AP_OracleVATCode_SBS E on A.VatRateCode = E.ASCVATCode
WHERE 
	A.GFBatchNumber = @theGFBatchNumber AND 
	C.Supplier IS NULL and 
	upper(left(A.InvNum,5)) <> 'DUMMY'

--Unit Test
--select * from #APGlobal

--=========================================================================================================================================
-- Force zero VAT on Everything / VAT Rounding?
--=========================================================================================================================================

declare @ForceZeroVATonInv char 
execute pGenfin_Get_IniSetting 'ForceZeroVATonInv', @ForceZeroVATonInv output, 'SBS'
if @ForceZeroVATonInv is null
	begin
		set @ForceZeroVATonInv = IsNull(@ForceZeroVATonInv,'Y') -- Default is 'Y' (Default to No for SBS)
	end

--Unit Test
--select @ForceZeroVATonInv

if @ForceZeroVATonInv = 'Y'
	Update #AP set VatRateCode = 0, VatRatePct = 1, VATAmount = 0 
else
	begin
		declare @ForceZeroVATonRounding char 
		execute pGenfin_Get_IniSetting 'ForceZeroVATonRounding', @ForceZeroVATonRounding output, 'SBS'
		if @ForceZeroVATonRounding is null
			begin
				set @ForceZeroVATonRounding = IsNull(@ForceZeroVATonRounding,'Y') -- Default is 'Y' (Default to Yes for backwardcompatibility)
			end
		if @ForceZeroVATonRounding = 'Y'
			Update #AP set VatRateCode = 0, VatRatePct = 1, VATAmount = 0 where Code = 'ASC000R'
	end

--=========================================================================================================================================
-- Populate the Oracle VAT Code
--=========================================================================================================================================

update A 
set OracleVATCode = B.OracleVATCode
from #AP A
join map_AP_OracleVATCode_SBS B on A.VatRateCode = B.ASCVATCode

--=========================================================================================================================================
-- Main Data incl Inv Headers (AP_Main_SBS)
--=========================================================================================================================================

-------------------------------------------------------------------------------------------------------------------------------------------
-- Invoice Header Data
-------------------------------------------------------------------------------------------------------------------------------------------

if OBJECT_ID('TempDB..#InvHeader') is not null
	drop table #InvHeader;

SELECT

	InvNum
,	CASE WHEN sum(VATInclusive) < 0
		THEN
			'CREDIT'
		ELSE
			'STANDARD'
	END InvoiceType
,	Min(PayDate) PayDate
,	CostCentre
,	sum(VATInclusive) as VATInclusive
,	max(ReconcileDate) as ReconcileDate
,	GFBatchNumber
,	Reference

INTO
	#InvHeader
FROM
	#AP 
Group By GFBatchNumber, Reference, InvNum, CostCentre

-------------------------------------------------------------------------------------------------------------------------------------------
-- Invoice Transactions Data
-------------------------------------------------------------------------------------------------------------------------------------------

declare @GroupInvTrans char
execute pGenfin_Get_IniSetting 'GroupInvByVATCode', @GroupInvTrans output, 'SBS'

if @GroupInvTrans is null
	begin
		set @GroupInvTrans = IsNull(@GroupInvTrans,'Y') -- Default is Yes
	end

if OBJECT_ID('tempAP') is not null
	drop table tempAP;

if @GroupInvTrans = 'N' 
	begin
		select 
			Reference
		,	OracleAccountSegment1
		,	OracleAccountSegment2
		,	OracleAccountSegment3
		,	OracleAccountSegment4
		,	OracleAccountSegment5
		,	OracleLineType
		,	OracleVATCode
		,	PaymentTerms
		,	VATInclusive

		into tempAP
	
		from #AP
	end

else

	begin
		select 
			Reference
		,	OracleAccountSegment1
		,	OracleAccountSegment2
		,	OracleAccountSegment3
		,	OracleAccountSegment4
		,	OracleAccountSegment5
		,	OracleLineType
		,	OracleVATCode
		,	MIN(PaymentTerms) PaymentTerms
		,	SUM(VATInclusive) VATInclusive

		into tempAP
	
		from #AP
		group by 	
			Reference
		,	OracleAccountSegment1
		,	OracleAccountSegment2
		,	OracleAccountSegment3
		,	OracleAccountSegment4
		,	OracleAccountSegment5
		,	OracleLineType
		,	OracleVATCode
	end;

--Unit Test
--Select * from tempAP

-------------------------------------------------------------------------------------------------------------------------------------------
-- Invoice Transactions Data
-------------------------------------------------------------------------------------------------------------------------------------------

if OBJECT_ID('AP_Main_SBS') is not null
	drop table AP_Main_SBS;

select 

	A.Reference
,	OracleAccountSegment1
,	OracleAccountSegment2
,	OracleAccountSegment3
,	OracleAccountSegment4
,	OracleAccountSegment5
,	OracleLineType
,	OracleVATCode
,	PaymentTerms
,	A.VATInclusive
,	B.CostCentre
,	B.GFBatchNumber
,	B.InvNum
,	B.InvoiceType
,	dbo.OracleDate(B.PayDate,'YY') PayDate
,	dbo.OracleDate(B.ReconcileDate,'YY') ReconcileDate
,	B.VATInclusive HdrVATInclusive

into AP_Main_SBS

from tempAP A
join #InvHeader B on A.Reference = B.Reference
order by Reference

--Unit Test
--select * from AP_Main_SBS 

--=========================================================================================================================================
-- File Header/Footer Table (AP_Header_SBS)
--=========================================================================================================================================

declare @GFBatchDate datetime = (select top 1 GFBatchDate from #AP);

if object_id('AP_Header_SBS') is not null
	drop table AP_Header_SBS
	
SELECT
		GFBatchNumber
	,	@GFBatchDate GFBatchDate
	,	sum(VATInclusive) as SumOfVATInclusive
	,	COUNT(*) ControlCount
INTO
	AP_Header_SBS
FROM
	AP_Main_SBS
GROUP BY GFBatchNumber

--Unit Test
--select * from AP_Header_SBS


--=========================================================================================================================================
-- Consolidated-suppliers output file
--=========================================================================================================================================

if OBJECT_ID('AP_Main_SBS_Consolidated') is not null
	drop table AP_Main_SBS_Consolidated;

select 
	CostCentre Reference
,	OracleAccountSegment1
,	OracleAccountSegment2
,	OracleAccountSegment3
,	OracleAccountSegment4
,	OracleAccountSegment5
,	OracleLineType
,	OracleVATCode
,	PaymentTerms
,	Sum(VATInclusive) VATInclusive
,	CostCentre
,	GFBatchNumber
,	Min(InvNum) InvNum
,	InvoiceType
,	Min(PayDate) PayDate
,	Min(ReconcileDate) ReconcileDate
,	Sum(HdrVATInclusive) HdrVATInclusive

into AP_Main_SBS_Consolidated

from AP_Main_SBS
group by 
	OracleAccountSegment1
,	OracleAccountSegment2
,	OracleAccountSegment3
,	OracleAccountSegment4
,	OracleAccountSegment5
,	OracleLineType
,	OracleVATCode
,	PaymentTerms
,	CostCentre
,	GFBatchNumber
,	InvoiceType

--Unit Test
--select * from AP_Main_SBS_Consolidated

--=========================================================================================================================================
-- AP Reports
--=========================================================================================================================================

--Testing
--declare @theGFBatchNumber Int = 2

declare @OutputFileID_Invoice Int = (select top 1 OutputFileID from Interface_OutputFiles_SBS where ReportID = 'INVOICE_LISTING')
declare @OutputFileID_VATRounding Int = (select top 1 OutputFileID from Interface_OutputFiles_SBS where ReportID = 'VAT_ROUNDING' )
declare @OutputFileID_MissingSupplier Int = (select top 1 OutputFileID from Interface_OutputFiles_SBS where ReportID = 'MISSING_SUPPLIER' )

declare @ASC000RLimit float = (select top 1 VATRoundingLimit from map_AP_VATRounding_Limit_SBS)

if IsNull(@OutputFileID_Invoice, 0) <> 0
	exec pGenfin_Report_InvoiceListing @theGFBatchNumber, @OutputFileID_Invoice, 'Interface_Definition_SBS', '#AP' , 'map_AP_ExcludeSupplier_SBS';

if IsNull(@OutputFileID_VATRounding, 0) <> 0
	exec pGenfin_Report_VATRounding @theGFBatchNumber, @OutputFileID_VATRounding, 'Interface_Definition_SBS', '#AP', 'map_AP_ExcludeSupplier_SBS', @ASC000RLimit;

if IsNull (@OutputFileID_MissingSupplier, 0) <> 0
	exec pGenfin_Report_MissingVendors @OutputFileID_MissingSupplier, '_SBS', 'map_AP_ExcludeSupplier_SBS';

exec pGenfin_Report_PartMatchInvoices 'SBS'

--=========================================================================================================================================
-- Clean Up
--=========================================================================================================================================

IF OBJECT_ID('tempDB..#AP') IS NOT NULL
	DROP TABLE #AP;

if OBJECT_ID('tempAP') is not null
	drop table tempAP;

if OBJECT_ID('TempDB..#InvHeader') is not null
	drop table #InvHeader;

