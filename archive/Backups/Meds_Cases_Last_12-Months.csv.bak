select * from WSupplier2 WHERE ContractAddress like N'%'+CHAR(13)+ CHAR(10) + '%'

select * from WSupplier2 WHERE InvAddress like N'%'+CHAR(13)+ CHAR(10) + '%'

select * from WSupplier2 WHERE SupAddress like N'%'+CHAR(13)+ CHAR(10) + '%'

begin tran
UPDATE wSupplier2 SET ContractAddress = replace(replace(ContractAddress, CHAR(13), ' '), CHAR(10), ' ') WHERE ContractAddress like N'%'+CHAR(13)+ CHAR(10) + '%'
--commit
begin tran
UPDATE wSupplier2 SET InvAddress = replace(replace(InvAddress, CHAR(13), ' '), CHAR(10), ' ') WHERE InvAddress like N'%'+CHAR(13)+ CHAR(10) + '%'

begin tran
