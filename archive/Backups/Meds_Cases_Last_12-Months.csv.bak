DECLARE @AllergyStatus INT
    DECLARE @AllergyCount INT

    EXEC icwsys.pAllergyConfirmation 0, @EpisodeID, @AllergyStatus OUTPUT

    SELECT @AllergyCount = COUNT(*) FROM [icwsys].fAllergicProductsByEpisode(0, @EpisodeID)

	--
	--
	-- As of 2016.1 release there seems to be an issue with HiEdit printing whereby columns returned in the
	-- select statement MUST be in the order they appear in the HiEdit cell - until further investigation is done on HiEdit the following
	-- data must be returned as is.
	--
	--

    SELECT	EpisodeID
        ,	Ward
        ,	PrimaryPatientIdentifierDisplayName + ': ' + ISNULL(PrimaryPatientIdentifierNumber,'') + ' ' + ISNULL(PrimaryPatientIdentifierIsValid,'') AS PrimaryPatientIdentifier
        ,	HospitalNumber
        ,	HospitalName
        ,	HospitalAddress1
        ,	HospitalAddress2
        ,	HospitalAddress3
        ,	HospitalPostCode
        ,	HospitalAddress4
        ,	Consultant
        ,	[Weight]
        ,	Height
        ,	BSA
        ,	CurrentUser
        ,	[Name]
        ,	DoorNumber
        ,	Building
        ,	Street
        ,	Town
        ,	District
        ,	PostCode
		,	DOB AS DOB__DATE
        ,	CASE
                WHEN @AllergyStatus = 0 THEN
                    'Allergy Status Not Confirmed'
                WHEN @AllergyCount = 0 THEN
                    'No Known Allergies'
                ELSE
                    'See Below'
            END AS AllergyStatus
    FROM	icwsys.fEpisodeSummaryByEpisode (0, @EpisodeID) Episode
    --FOR XML AUTO

