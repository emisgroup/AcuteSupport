18/05/2026 12:53:58 - Muhammed Rashik Rahman (Work notes)
SELECT u.EntityID,u.Username,e.Description AS [Name],
MAX(l.DateTime) AS LastSuccessfulLogin,r.RoleID,r.Description as 'RoleName', r.Detail
FROM [User] u
JOIN Entity e ON e.EntityID = u.EntityID
JOIN LoginAttempt l ON l.Username = u.Username
join UserLinkRole ul on ul.EntityID =u.EntityID
join Role r on r.RoleID =ul.RoleID
WHERE u.Deleted <> 1
AND l.Success = 1
AND l.DateTime >= DATEADD(YEAR, -1, GETDATE())
GROUP BY u.EntityID, u.Username,e.Description,r.Description,r.Detail,r.RoleID
ORDER BY LastSuccessfulLogin DESC;

