SELECT SUM(Difference) AS TotalDifference
FROM (
    SELECT
        DATEPART(YEAR, ms.timestamp) AS [Year],
        DATEPART(MONTH, ms.timestamp) AS [Month],
        DATEPART(DAY, ms.timestamp) AS [Day],
        DATEPART(HOUR, ms.timestamp) AS [Hour],
        COUNT(DISTINCT CASE WHEN i.InterfaceComponentID = 2 THEN m.MessageGuid END) -
        COUNT(DISTINCT CASE WHEN i.InterfaceComponentID = 4 THEN m.MessageGuid END) AS Difference
    FROM MESSAGESTATUS ms (NOLOCK)
    JOIN MESSAGE m (NOLOCK) ON m.MessageGuid = ms.MessageGuid
    JOIN INTERFACECOMPONENT i (NOLOCK) ON i.InterfaceComponentID = ms.InterfaceComponentID
    WHERE ms.Timestamp > '2025-10-22 08:00:00.000'
      AND ms.Timestamp < '2025-10-22 11:00:00.000'
    GROUP BY
        DATEPART(YEAR, ms.timestamp),
        DATEPART(MONTH, ms.timestamp),
        DATEPART(DAY, ms.timestamp),
        DATEPART(HOUR, ms.timestamp)
) AS HourlyDifferences;



--select * from InterfaceComponent 
--select * from Status

SELECT
        DATEPART(YEAR, ms.timestamp) AS [Year],
        DATEPART(MONTH, ms.timestamp) AS [Month],
        DATEPART(DAY, ms.timestamp) AS [Day],
        DATEPART(HOUR, ms.timestamp) AS [Hour],
		COUNT(DISTINCT CASE WHEN i.InterfaceComponentID = 2 THEN m.MessageGuid END) as Receieved,
		COUNT(DISTINCT CASE WHEN i.InterfaceComponentID = 4 THEN m.MessageGuid END) AS Processed,
        COUNT(DISTINCT CASE WHEN i.InterfaceComponentID = 2 THEN m.MessageGuid END) -
        COUNT(DISTINCT CASE WHEN i.InterfaceComponentID = 4 THEN m.MessageGuid END) AS Difference
    FROM MESSAGESTATUS ms (NOLOCK)
    JOIN MESSAGE m (NOLOCK) ON m.MessageGuid = ms.MessageGuid
    JOIN INTERFACECOMPONENT i (NOLOCK) ON i.InterfaceComponentID = ms.InterfaceComponentID
    WHERE ms.Timestamp > '2025-10-22 08:00:00.000'
      AND ms.Timestamp < '2025-10-22 11:00:00.000'
    GROUP BY
        DATEPART(YEAR, ms.timestamp),
        DATEPART(MONTH, ms.timestamp),
        DATEPART(DAY, ms.timestamp),
        DATEPART(HOUR, ms.timestamp)

