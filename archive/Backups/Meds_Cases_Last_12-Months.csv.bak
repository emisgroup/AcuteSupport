13/07/2026 16:11:24 - Sean Prescott (Work notes)
SELECT 
Entity.Description
,Duplicates.RequestID

,	eMMSupplyRequestNurse.*
FROM 
(

select R.RequestID
from RequestLinkAttachedNote R
JOIN AttachedNote A ON R.NoteID = A.NoteID
JOIN NOte N ON A.NoteID = N.NoteID
JOIN eMMSupplyRequestNurse E ON N.NoteID = E.NoteID
where A.Enabled = 1
GROUP BY R.RequestID
HAVING COUNT(*) > 1
) Duplicates

JOIN RequestLinkAttachedNote ON Duplicates.RequestID = RequestLinkAttachedNote.RequestID
JOIN AttachedNote ON RequestLinkAttachedNote.NoteID = AttachedNote.NoteID
JOIN NOte  ON AttachedNote.NoteID = NOte.NoteID
JOIN eMMSupplyRequestNurse ON Note.NoteID = eMMSupplyRequestNurse.NoteID
JOIN EpisodeOrder ON Duplicates.RequestID = EpisodeOrder.RequestID
JOIN Episode ON EpisodeOrder.EpisodeID = Episode.EPisodeID
JOIN Entity ON Episode.ENtityID = Entity.EntityID
where AttachedNote.Enabled = 1

ORDER BY
	Duplicates.RequestID
,	Note.NoteID


SELECT 
Entity.Description
,Duplicates.RequestID

,	eMMSupply.*
FROM 
(

select R.RequestID
from RequestLinkAttachedNote R
JOIN AttachedNote A ON R.NoteID = A.NoteID
JOIN NOte N ON A.NoteID = N.NoteID
JOIN eMMSupply E ON N.NoteID = E.NoteID
where A.Enabled = 1
GROUP BY R.RequestID
HAVING COUNT(*) > 1
) Duplicates

JOIN RequestLinkAttachedNote ON Duplicates.RequestID = RequestLinkAttachedNote.RequestID
JOIN AttachedNote ON RequestLinkAttachedNote.NoteID = AttachedNote.NoteID
JOIN NOte  ON AttachedNote.NoteID = NOte.NoteID
JOIN eMMSupply ON Note.NoteID = eMMSupply.NoteID
JOIN EpisodeOrder ON Duplicates.RequestID = EpisodeOrder.RequestID
JOIN Episode ON EpisodeOrder.EpisodeID = Episode.EPisodeID
JOIN Entity ON Episode.ENtityID = Entity.EntityID
where AttachedNote.Enabled = 1

ORDER BY
	Duplicates.RequestID
,	Note.NoteID

-- If there are duplicates disabled the earliest noteID for each Request

