18/12/2025 11:35:46 - Swati Dongare (Work notes)
SELECT [User].Username
,Desktop.Description AS [Desktop Desc]
,ROLE.Description AS [Role Desc]
,ROLE.Detail
,ROLE.Individual
,Permission.Allow
,[User].LocationID
FROM icwsys.Desktop
INNER JOIN icwsys.Policy ON Desktop.PolicyID = Policy.PolicyID
INNER JOIN icwsys.Permission ON Policy.PolicyID = Permission.PolicyID
INNER JOIN icwsys.[Role] ON Permission.RoleID = ROLE.RoleID
INNER JOIN icwsys.UserLinkRole ON ROLE.RoleID = UserLinkRole.RoleID
INNER JOIN icwsys.[User] ON UserLinkRole.EntityID = [User].EntityID
WHERE (Desktop.Description LIKE 'MFT Inpatients - WardStock List (Full) 483')
AND Permission.Allow = 1
ORDER BY ROLE.Individual
,ROLE.Description
,[USER].Username

