select siscode from wproduct group by siscode, locationid_site having count(siscode) > 1-----1 entry

select a.siscode, a.productstockid, a.locationid_site,a.wsupplierprofileid, a.* from wproduct a
join (select siscode, locationid_site from wproduct group by siscode, locationid_site having count(siscode) > 1) b
on (a.siscode = b.siscode and a.locationid_site = b.locationid_site)-----------2 entires

Select drugid, productid, siteproductdataid, * from siteproductdata
where siscode = 'DVT338J'--------2 entries

select supcode, * from productstock
where drugid = 927469--------dummy/scps

select locationid_site, * from wsupplierprofile
where nsvcode = 'DVT338J' and supcode =1117


select * from WSupplierProfile where nsvcode = 'DVT338J'----2 entries 

select * from productstock where ProductStockid = 71422-------1 entry 


select * into bkp_WSupplierProfile_CS1608142 from WSupplierProfile where WSupplierProfileID IN ('125903','125904')



The productstock table can only have one line per site and the supcode must match one line in wsupplierprofile

If there are 2 entries in wsupplierprofile that are identical delete the oldest entry.
If they are not identical check with the customer which has the correct information.




SELECT w.LocationID_Site [Site pKey]
,s.SiteNumber [Site Number]
,w.Siscode
,w.ProductID
,w.Description
,w.InUse
FROM wProduct w
JOIN Site s
ON w.LocationID_Site = s.LocationID
WHERE SISCode = 'DVT338J'

