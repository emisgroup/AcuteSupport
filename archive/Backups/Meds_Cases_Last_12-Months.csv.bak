30/03/2026 09:57:21 - Gunjan Idnani (Work notes)
eds Current PMR With Dispensings


 DECLARE
        @CurrentSessionID int
    ,   @EpisodeID int
    ,   @UserID int
    ,   @TerminalID int
    ,   @ParentID int
    ,   @FirstRow int
    ,   @LastRow int
    
    

    Set @CurrentSessionID = 79238545
    Select @EpisodeID = [PrimaryKey] From State s Join [Table] t on s.TableID = t.TableID Where s.SessionID=79238545 and t.Description = 'Episode'
    Select  @UserID = EntityID From Session where SessionID = 79238545
    Set @TerminalID = NULL
    Set @ParentID = NULL
    Set @FirstRow = 1
    Set @LastRow = 20

------------------------------------------ End Variables - Do not paste text above this line back into Worklist Editor -----------------------------------------------------

DECLARE
        @DischargeRequestID int
    ,   @DischargeRequestDate datetime
    ,   @TransferDate datetime
    ,   @DischargeMessage varchar(128)
    ,   @UserFlagOneText varchar(12)
    ,   @UserFlagTwoText varchar(12)
    ,   @UserFlagThreeText varchar(12)
    ,   @UserFlagFourText varchar(12)
    ,   @UserFlagFiveText varchar(12)
    ,   @PriorityText varchar(10)
    ,   @WardStockText varchar(10)
    ,   @SupplyRequestText varchar(30)
    ,   @PendingSupplyRequestText varchar(30)

SELECT 
        @UserFlagOneText = UserFlagOneText
    ,   @UserFlagTwoText = UserFlagTwoText
    ,   @UserFlagThreeText = UserFlagThreeText
    ,   @UserFlagFourText = UserFlagFourText
    ,   @UserFlagFiveText = UserFlagFiveText
    ,   @PriorityText = PriorityText
    ,   @SupplyRequestText = SupplyRequestText
    ,   @PendingSupplyRequestText = PendingSupplyRequestText
    ,   @WardStockText = WardStockText
FROM 
    eMMDefaults 
WHERE 
    eMMDefaults.LocationID_Parent = icwsys.feMMSettingsByChildLocation(@TerminalID)

DECLARE @MidnightTonight datetime

SELECT @MidnightTonight = DATEADD(dd, DATEDIFF(dd,0,getdate()), 1)

--Find most recent Discharge Request
SELECT TOP 1 
        @DischargeRequestID = Request.RequestID
    ,   @DischargeRequestDate = Request.RequestDate
FROM
    Request
    JOIN RequestStatus RS ON Request.RequestID = RS.RequestID
WHERE
    RS.EpisodeOrder__EpisodeID = @EpisodeID
    AND RS.RequestType__Description = 'DischargeRequest'
    AND RS.[Request Cancellation] = 0
ORDER BY
    Request.RequestID DESC

--Has it also been marked for Discharge
IF @DischargeRequestID IS NOT NULL
BEGIN
    SELECT TOP 1 
        @TransferDate = Note.CreatedDate
    FROM
        Note
        JOIN EpisodeNote ON Note.NoteID = EpisodeNote.NoteID
        JOIN NoteType ON Note.NoteTypeID = NoteType.NoteTypeID
        LEFT JOIN NoteCancellation ON Note.NoteID = NoteCancellation.NoteID_Cancelled
    WHERE
        EpisodeNote.EpisodeID = @EpisodeID
        AND NoteType.[Description] = 'Patient Transfer Note'
        AND NoteCancellation.NoteID IS NULL
    ORDER BY
        Note.CreatedDate DESC

    IF (@DischargeRequestDate > @TransferDate) OR (@TransferDate IS NULL)
    --There's a Discharge Request since the latest Transfer Note, so show the Discharge Request
    BEGIN
        --Return @DischargeRequestID
        SELECT
                Request.RequestID AS 'ID'
            ,   'Discharge' AS 'Text'
            ,   convert(varchar(10), Request.CreatedDate, 103) + ' ' + convert(varchar(5), Request.CreatedDate, 108) AS 'Date'
            ,   CASE
                    WHEN RS.[Discharge Checked] = 0 THEN 'Awaiting Clinical Checking'
                    WHEN RS.[Discharge Checked] = 1 THEN 'Checked'
                    ELSE ''
                END AS 'Status'
            ,   'Request' AS 'Class'
        FROM
            Request
            JOIN RequestStatus RS ON Request.RequestID = RS.RequestID
        WHERE
        Request.RequestID = @DischargeRequestID
    END
END


--Store all current, non-expired prescriptions for this Episode and any parent episodes
--Need to store them to identify if there's any non-discharge ones, and return a dummy note if there is.
SELECT
        Request.RequestID AS 'ID'
    ,   CASE
            WHEN RS.Screen = 0 THEN '**Awaiting Clinical Checking** '
            ELSE ''
        END        
        +  isnull(Parent.[Description], '') + Request.[Description] 
      + CASE 
        WHEN RS.RequestType__Description = 'Infusion Prescription' OR Request.LocationID IS NULL
          THEN isnull(' - ' + P.Description_FreeTextDirection, '') 
        ELSE ''
      END AS 'Text'
    ,   convert(varchar(10), Request.RequestDate, 103) AS 'Date'
    ,   icwsys.fEDSTrimStatus(
							   CASE
								 WHEN icwsys.fIsBlackTrianglePrescription(RS.RequestID) = 1 THEN
								   '&#9660; | '	
								 ELSE 
									''
							   END 
                            +  CASE
                                    WHEN RS.Discharge = 1 THEN 'TTO - NOT to be continued'
                                    WHEN RS.DischargeContinue = 1 THEN 'TTO - to be continued'
                                    WHEN RS.DischargeGP = 1 THEN 'TTO - to be continued by GP' + isnull(' - ' + icwsys.Ellipsis(DischargeGP.Detail, 75), '')
                                    WHEN RS.DischargeHospital = 1 THEN 'TTO - to be continued by Hospital' + isnull(' - ' + icwsys.Ellipsis(DischargeHospital.Detail, 75), '')
                                    ELSE 'Not for discharge'
							   END
                            +  CASE WHEN RS.WardStock = 1 THEN ' | ' + @WardStockText ELSE '' END
                            +  isnull(' | PO - ' + POS.[Description] + isnull(' (' + PO.Comments + ')', ''), '')
                            +  CASE 
                                    WHEN RS.eMMSupply = 1 THEN ' | ' 
                                    +   CASE WHEN ems.Priority = 1 THEN @PriorityText ELSE '' END 
                                    +   CASE WHEN RS.Screen = 0 THEN  '' + @PendingSupplyRequestText ELSE '' + @SupplyRequestText END 
                                    +   ' (' + convert(varchar(20), RS.eMMSupply__CreatedDate, 106) + ' ' + convert(varchar(5), RS.eMMSupply__CreatedDate, 8) + ' by ' + Entity.[Description] + ')' 
                                    +   CASE WHEN ems.UserFlagOne = 1 THEN ' ' + @UserFlagOneText ELSE '' END
                                    +   CASE WHEN ems.UserFlagTwo = 1 THEN ' ' + @UserFlagTwoText ELSE '' END
                                    +   CASE WHEN ems.UserFlagThree = 1 THEN ' ' + @UserFlagThreeText ELSE '' END
                                    +   CASE WHEN ems.UserFlagFour = 1 THEN ' ' + @UserFlagFourText ELSE '' END
                                    +   CASE WHEN ems.UserFlagFive = 1 THEN ' ' + @UserFlagFiveText ELSE '' END
                                    +   CASE WHEN len(rtrim(ems.comments)) > 0 THEN ' ' + rtrim(ems.comments) ELSE '' END
                                    ELSE '' 
                                END
                            ) AS 'Status'
    ,   'Request' AS 'Class'
    ,   CASE WHEN icwsys.DispensingsExists(Request.RequestID) = 1 THEN 'Dispensings' END AS 'Query'
    ,   RS.Discharge
    ,   RS.DischargeGP
    ,   RS.DIschargeContinue
    ,   RS.DischargeHospital
INTO 
    #Request
FROM
    Request
    LEFT JOIN Request Parent ON Request.RequestID_Parent = Parent.RequestID AND Request.RequestID_Parent > 0
    LEFT JOIN Prescription P ON Request.RequestID = P.RequestID
    LEFT JOIN GenericPrescription GP ON Request.RequestID = GP.RequestID
    JOIN RequestStatus RS ON Request.RequestID = RS.RequestID
    --POM Status
    LEFT JOIN
    PatientsOwn PO 
        JOIN POMStatus POS ON PO.POMStatusID = POS.POMStatusID
        ON RS.Patient_Own__NoteID = PO.NoteID
    --eMM Supply Request
    LEFT JOIN eMMSupply ems ON RS.eMMSupply__NoteID = ems.NoteID
    LEFT JOIN Entity on RS.eMMSupply__EntityID = Entity.EntityID
    
    LEFT JOIN DischargeGP ON RS.DischargeGP__NoteID = DischargeGP.NoteID
    LEFT JOIN DischargeHospital ON RS.DischargeHospital__NoteID = DischargeHospital.NoteID
WHERE
    RS.EpisodeOrder__EpisodeID = @EpisodeID
    AND RS.RequestType__Description IN ('Standard Prescription', 'Doseless Prescription', 'Infusion Prescription', 'Enteral Prescription', 'Generic Prescription', 'Product Order')
    AND RS.Expired = 0
	AND --Not Expired
            (
                (
                    P.RequestID IS NOT NULL
          AND --Not Expired
            (
              P.StopDate IS NULL
              OR DATEDIFF(day, GETDATE(), P.StopDate) >= 0
            )
                )              
             OR --FreeText Prescription
                (
                    GP.RequestID IS NOT NULL
                  AND 
                 (    GP.StopDate_GenericPrescription IS NULL 
                    OR DATEDIFF(day, GETDATE(), GP.StopDate_GenericPrescription) >= 0
                  )
                )         
                OR RS.RequestType__Description = 'Product Order'  
            )
    AND RS.[Request Cancellation] = 0 AND RS.Expired = 0


--Return DIscharge Prescriptions
SELECT
        ID
    ,   Text
    ,   Date
    ,   Status
    ,   Class
    ,   Query
FROM
    #Request Request
WHERE
    Discharge = 1
    OR DischargeContinue = 1
    OR DischargeGP = 1
    OR DischargeHospital = 1


--If there's any non-discharge prescriptions, return a dummy note row to separate them, then return them
IF EXISTS ( SELECT TOP 1 1 FROM #Request where Discharge = 0 AND DischargeContinue = 0 AND DischargeGP = 0 AND DischargeHospital = 0)
BEGIN

    SELECT
            0 AS 'ID'
        ,   'Non-discharge prescriptions:' AS 'Text'
        ,   '' AS 'Date'
        ,   '' AS 'Status'
        ,   0 AS 'Class'
        ,   'Note' AS 'TableID'


    SELECT
            ID
        ,   Text
        ,   Date
        ,   Status
        ,   Class
        ,   Query
    FROM
        #Request Request
    WHERE
        Discharge = 0
        AND DischargeContinue = 0
        AND DischargeGP = 0
        AND DischargeHospital = 0

END

DROP TABLE #Request

