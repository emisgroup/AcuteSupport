SELECT [User].Username
,Desktop.Description AS [Desktop Desc]
,ROLE.Description AS [Role Desc]
,ROLE.Detail
,ROLE.Individual
,Permission.Allow
,[User].LocationID
FROM icwsys.Desktop
INNER JOIN icwsys.Policy ON Desktop.PolicyID = Policy.PolicyID
INNER JOIN icwsys.Permission ON Policy.PolicyID = Permission.PolicyID
INNER JOIN icwsys.[Role] ON Permission.RoleID = ROLE.RoleID
INNER JOIN icwsys.UserLinkRole ON ROLE.RoleID = UserLinkRole.RoleID
INNER JOIN icwsys.[User] ON UserLinkRole.EntityID = [User].EntityID
WHERE (Desktop.Description LIKE ' Inpatients - WardStock List (Full)')
AND Permission.Allow = 1
ORDER BY ROLE.Individual
,ROLE.Description
,[USER].Username

06/01/2026 12:41:55 - Swati Dongare (Work notes)
select u.Username, p.Description, r.Description
from [user] u
join UserLinkRole ulr on u.EntityID = ulr.EntityID
join permission per on ulr.RoleID = per.RoleID
join Role r on ulr.RoleID = r.roleid
join policy p on per.PolicyID = p.PolicyID
where u.username = 'MWalls' --enter username

