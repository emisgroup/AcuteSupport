SELECT 
DATEPART(YEAR, ms.timestamp),
DATEPART(MONTH, ms.timestamp),
DATEPART(DAY, ms.timestamp),
DATEPART(HOUR, ms.timestamp) as Per_hour, 
count(distinct m.MessageGuid)
FROM MESSAGESTATUS MS (nolock)
JOIN MESSAGE M (nolock)ON M.MESSAGEGUID = MS.MESSAGEGUID 
JOIN INTERFACECOMPONENT I (nolock)ON I.INTERFACECOMPONENTID = MS.INTERFACECOMPONENTID and i.name = 'ICWMsgProcessor'
where ms.Timestamp > '2024-03-26T00:00:00.000' and ms.Timestamp < '2024-03-27T00:00:00.000' and [StatusID] = 12
group by 
DATEPART(YEAR, ms.timestamp),
DATEPART(MONTH, ms.timestamp),
DATEPART(DAY, ms.timestamp),
DATEPART(HOUR, ms.timestamp)

--received
SELECT 
DATEPART(YEAR, ms.timestamp),
DATEPART(MONTH, ms.timestamp),
DATEPART(DAY, ms.timestamp),
DATEPART(HOUR, ms.timestamp) as Per_hour, 
count(distinct m.MessageGuid)
FROM MESSAGESTATUS MS (nolock)
JOIN MESSAGE M (nolock)ON M.MESSAGEGUID = MS.MESSAGEGUID 
JOIN INTERFACECOMPONENT I (nolock)ON I.INTERFACECOMPONENTID = MS.INTERFACECOMPONENTID and i.name = 'IPReceiver'
where ms.Timestamp > '2024-03-26T00:00:00.000' and ms.Timestamp < '2024-03-27T00:00:00.000' and [StatusID] = 8
group by 
DATEPART(YEAR, ms.timestamp),
DATEPART(MONTH, ms.timestamp),
DATEPART(DAY, ms.timestamp),
DATEPART(HOUR, ms.timestamp)

