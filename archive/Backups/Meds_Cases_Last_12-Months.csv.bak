SELECT
    dci.RequestID,
    dci.AmendmentOfId,
    dci.PatientId,
    dci.EpisodeId,
    dci.RequestType,
    dci.RouteDescription,
    dci.Description_Frequency,
    dci.Description_Direction,
    dci.MinimumDoseInterval,
    dci.MaximumDoseOverTimeDose,
    dci.MaximumDoseOverTimeInterval,
    dci.CreatedDate,
    dci.StartDate,
    dci.StopDate,
    dci.Prescriber,
    dci.TreatmentReason,
    dci.Expired,
    dci.CreationType,
    dci.AdministrationMethod,
    dci.IsInfusion,
    dci.Cancelled,
    dci.CancelledOn,
    dci.DiluentDescription,
    dci.DiluentVolumeDescription,
    dci.HasStickyNotes,
    dci.LengthOfCourseDuration,
    dci.BolusInjection,
    dci.WarningsOverridden,
    dci.SingleDose,
    dci.WhenRequired,
    dci.RegularScheduled,
    dci.AdminDue,
    dci.AdminOverdue,
    dci.AdminInProgress,
    dci.InfusionRate,
    dci.InfusionMinimumRate,
    dci.InfusionMaximumRate,
    dci.InfusionRateMass,
    dci.InfusionRateTime,
    dci.InfusionDuration,
    dci.InfusionDurationLow,
    dci.InfusionDurationUnit,
    dci.GenericProductDescription,
    dci.GenericDoseDescription,
    dci.ProductOrderDescription,
    dci.ParentOrdersetName,
    dci.OptionsOrdersetName,
    dci.Screened,
    dci.VolumeInfusion,
    dci.InfusionRoute,
    dci.TransferDate,
    dci.AlertStartDate,
    dci.ReviewDate,
    dci.ReviewPending,
    dci.ReviewDue,
    dci.ReviewOverDue,
    dci.ReviewComplete,
    dci.Outstanding,
    dci.PrescriptionIsFormulary,
    dci.OrderTemplateIsFormulary,
    dci.AdministrationSite,
    dci.DischargeStatus,
    dci.IsIntervention,
    dci.DrugOnAdmission,
    dci.PatientOwn,
    dci.IsUnauthorisedUnderMHA,
    dci.Complete,
    dci.AdditionalInstructions,
    dci.ProductId,
    dci.Mortal,
    dci.Responses,
    dci.RequestTypeId,
    dci.RequestID_Parent,
    dci.RequestTypeTableId,
    dci.HoursPending,
    dci.IgnorePending,
    dci.Orderable,
    dci.ManualResponse,
    dci.PrintOnCommit,
    dci.AutoCommit,
    dci.OrderingFrequency,
    dci.ModalityID,
    dci.RoutineID_OnCommit,
    dci.DoseTimingBehaviour,
    dci.ScheduleID,
    dci.UnitID_MinimumDoseInterval,
    dci.UnitID_MaximumDoseOverTime,
    dci.UnitID_Duration
FROM DrugChartItem dci
INNER JOIN Schedule s ON dci.ScheduleID = s.ScheduleID
LEFT JOIN CustomDailySchedule cds ON s.ScheduleID = cds.ScheduleID
LEFT JOIN CustomWeeklySchedule cws ON s.ScheduleID = cws.ScheduleID
LEFT JOIN CustomMonthlyDaySchedule cmday ON s.ScheduleID = cmday.ScheduleID
LEFT JOIN CustomMonthlyDateSchedule cmdate ON s.ScheduleID = cmdate.ScheduleID
LEFT JOIN CustomYearlyDaySchedule cyd ON s.ScheduleID = cyd.ScheduleID
LEFT JOIN CustomYearlyDateSchedule cydt ON s.ScheduleID = cydt.ScheduleID
LEFT JOIN Unit u1 ON dci.UnitID_MinimumDoseInterval = u1.UnitID
LEFT JOIN Unit u2 ON dci.UnitID_MaximumDoseOverTime = u2.UnitID
LEFT JOIN Unit u3 ON dci.UnitID_Duration = u3.UnitID
WHERE dci.EpisodeId = 351214
  AND dci.RequestType NOT IN ('PN Prescription', 'FP10 Prescription', 'FP10 MDA Prescription');

