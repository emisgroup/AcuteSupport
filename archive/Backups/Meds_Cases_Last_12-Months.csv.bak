exec dbo.GetLongRunningSPID


select
  sp.spid
  , datediff(mi, sp.last_batch, current_timestamp) as batch_duration
  , sp.program_name
  , sp.hostname
  , sp.loginame
  , st.text
from sys.sysprocesses sp
cross apply sys.dm_exec_sql_text(sp.sql_handle) as st
where datediff(mi, sp.last_batch, current_timestamp) >=5
and sp.spid > 50 
and sp.status = 'sleeping'
and sp.open_tran > 0
and sp.cmd not in ('MIRROR HANDLER','LAZY WRITER','CHECKPOINT SLEEP','RA MANAGER')
and sp.program_name not like 'SQLAgent%'
and (sp.program_name <> 'Microsoft® Windows® Operating System')

