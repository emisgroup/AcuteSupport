                    [ProductRoute].[ProductRouteID] [ProductRoute],
                    [ProductRoute].[ProductRouteDesc] [ProductRouteProductRouteDesc],
                    [ProductRoute].[ProductRouteID] [ProductRouteID]
                FROM
                    [Dim].[ProductRoute] [ProductRoute]
            ) [ProductRoute] ON [Fact_Prescription].[ProductRouteID] = [ProductRoute].[ProductRouteID]
            LEFT OUTER JOIN (
                SELECT
                    [Patient].[NHSNumber] [NHSNumber],
                    [Patient].[PatientID] [Patient3],
                    [Patient].[Name] [Patient1],
                    [Patient].[PatientID] [Patient],
                    [Patient].[CaseNumber] [CaseNumber],
                    [Patient].[PatientID] [PatientID]
                FROM
                    [Dim].[Patient] [Patient]
            ) [Patient] ON [Fact_Prescription].[PatientID] = [Patient].[PatientID]
            LEFT OUTER JOIN (
                SELECT
                    [Patient].[Name] [Name],
                    [Patient].[CaseNumber] [CaseNumber],
                    [Patient].[NHSNumber] [NHSNumber],
                    [Fact_Episode].[EpisodeID] [EpisodeID]
                FROM
                    (
                        SELECT     Episode_sk, EpisodeID, EpisodeID_Parent, Description, PatientID, EpisodeTypeID, EpisodeStartDateID, EpisodeStartTimeID, EpisodeEndDateID, EpisodeEndTimeID, 
                      EpisodeStartDate, EpisodeEndDate, DateCreated, CaseNo, UserID, UserRoleID, Active
FROM         Fact.Episode
                    ) [Fact_Episode]
                    LEFT OUTER JOIN (
                        SELECT
                            [Patient].[Name] [Name],
                            [Patient].[CaseNumber] [CaseNumber],
                            [Patient].[NHSNumber] [NHSNumber],
                            [Patient].[PatientID] [PatientID]
                        FROM
                            [Dim].[Patient] [Patient]
                    ) [Patient] ON [Fact_Episode].[PatientID] = [Patient].[PatientID]
            ) [Fact_Episode] ON [Fact_Prescription].[EpisodeID] = [Fact_Episode].[EpisodeID]
            LEFT OUTER JOIN (
                SELECT
                    [PrescriptionCreationType].[PrescriptionCreationDesc] [PrescriptionCreationDesc],
                    [PrescriptionCreationType].[PrescriptionCreationTypeID] [PrescriptionCreationTypeID]
                FROM
                    [Dim].[PrescriptionCreationType] [PrescriptionCreationType]
            ) [PrescriptionCreationType] ON [Fact_Prescription].[PrescriptionCreationTypeID] = [PrescriptionCreationType].[PrescriptionCreationTypeID]
    ) [Fact_Prescription] ON [Fact_ResponseActivity].[PrescriptionID] = [Fact_Prescription].[PrescriptionID2]
    LEFT OUTER JOIN (
        SELECT
            [DrugAdmin].[Code] [Code],
            [DrugAdmin].[DrugAdminID] [DrugAdmin],
            [DrugAdmin].[DrugAdminDesc] [DrugAdminDrugAdminDesc],
            [DrugAdmin].[DrugAdminID] [DrugAdminID]
        FROM
            [Dim].[DrugAdmin] [DrugAdmin]
    ) [DrugAdmin] ON [Fact_ResponseActivity].[DrugAdminID] = [DrugAdmin].[DrugAdminID]
    LEFT OUTER JOIN (
        SELECT
            [Fact_Prescription].[Description] [Description],
            [Fact_Prescription].[Description1] [Description1],
            [Fact_RequestedActivity].[RequestDateTime] [RequestDateTime],
            [Fact_RequestedActivity].[RequestDateTime] [RequestDateTime2],
            [Fact_RequestedActivity].[RequestDateTime] [RequestDateTime3],
            [Fact_RequestedActivity].[RequestActivityID] [RequestActivityID]
        FROM
            (
                SELECT        RequestActivityID, PrescriptionID, EpisodeID, RequestTypeID, RequestDateID, RequestTimeID, AuthorisedByID, RequestDateTime, PatientOwn, 
                         SupervisedAdmin, SelfAdmin, Description, LocationID, Terminal, Ward, WardID, WardLongDesc, Fullname, ConsultantID, SpecialtyDesc, SpecialtyID
FROM            v_Fact_RequestedActivity
            ) [Fact_RequestedActivity]
            LEFT OUTER JOIN (
                SELECT
                    [Fact_Prescription].[Description] [Description],
                    [Fact_Prescription].[Description] [Description1],
                    [Fact_Prescription].[PrescriptionID] [PrescriptionID]
                FROM
                    (
                        SELECT        PrescriptionID, PrescriptionID_Original, EpisodeID, ProductID, PrescriptionStartDateID, PrescriptionStartTimeID, PrescriptionStopDateID, 
                         PrescriptionStopTimeID, ProductRouteID, ScheduleID, PrescriptionCreationTypeID, PrescriptionTypeID, PrescribedByID, OwnerID, PatientID, 
                         PrescriptionStartDateTime, PrescriptionStopDateTime, InOnFormulary, PatientOwn, SelfAdmin, SupervisedAdmin, duration, DurationLow, Rate, RateMin, 
                         RateMax, Dose, DoseLow, GivenAsRequired, Quantity, QuantityMin, QuantityMax, LicensedRoute, AdminMethod_Desc, Frequency_Desc, Description, 
                         PrescriptionType, ControlledDrug, ConsultantID, ConsultantDesc, WardID, WardLongDesc, SpecialtyDesc, TreatmentReason, AuthorisingUser, 
                         [Committed By], Terminal, TerminalWard, PrescriptionCreatedDateTime, AccuracyCheckDateTime, PrescriptionCreateDate, PrescriptionStartDate
FROM            v_Fact_Prescription
                    ) [Fact_Prescription]
            ) [Fact_Prescription] ON [Fact_RequestedActivity].[PrescriptionID] = [Fact_Prescription].[PrescriptionID]
    ) [Fact_RequestedActivity] ON [Fact_ResponseActivity].[RequestActivityID] = [Fact_RequestedActivity].[RequestActivityID]
    LEFT OUTER JOIN (
        SELECT
            [Dim_AdminStatus].[AdminStatusID] [AdminStatusFlag],
            [Dim_AdminStatus].[AdminStatusSK] [AdminStatus],
            [Dim_AdminStatus].[AdminStatusDesc] [AdminStatusAdminStatusDesc],
            [Dim_AdminStatus].[AdminStatusSK] [AdminStatusSK]
        FROM
            (
                SELECT     AdminStatusSK, AdminStatusID, AdminStatusDesc
FROM         Dim.AdminStatus
            ) [Dim_AdminStatus]
    ) [Dim_AdminStatus] ON [Fact_ResponseActivity].[AdminStatusID] = [Dim_AdminStatus].[AdminStatusSK]
    LEFT OUTER JOIN (
        SELECT
            [AdministeredBy].[Administered ByID] [AdministeredBy],
            [AdministeredBy].[Administered By] [AdministeredByAdministeredBy],
            [AdministeredBy].[Administered ByID] [AdministeredByID]
        FROM
            [Dim].[AdministeredBy] [AdministeredBy]
    ) [AdministeredBy] ON [Fact_ResponseActivity].[AdministeredByID] = [AdministeredBy].[AdministeredByID]
WHERE
    [Fact_RequestedActivity].[RequestDateTime2] >= CONVERT(DATETIME,'2025-09-01 00:00:00', 121) AND [Fact_RequestedActivity].[RequestDateTime3] <= CONVERT(DATETIME,'2025-09-30 00:00:00', 121) AND (NOT(COALESCE(CHARINDEX('', [Fact_Prescription].[Name]), 0) = 0) OR '' = '') AND (NOT(COALESCE(CHARINDEX('21259321', [Fact_Prescription].[CaseNumber2]), 0) = 0) OR '21259321' = '') AND (NOT(COALESCE(CHARINDEX('', [Fact_Prescription].[NHSNumber2]), 0) = 0) OR '' = '') AND [Fact_ResponseActivity].[WardID] IN (97) AND [Fact_ResponseActivity].[ConsultantID] IN (11006) AND NOT([Fact_Prescription].[PrescriptionCreationDesc] = 'Transcription' AND NOT([Fact_Prescription].[PrescriptionCreationDesc] IS NULL))
ORDER BY
    [Specialty], [Consultant], [Ward], [Product]

