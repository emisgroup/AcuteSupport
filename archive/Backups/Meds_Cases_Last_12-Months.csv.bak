DECLARE
        @CurrentSessionID int
    ,   @EpisodeID int
    ,   @UserID int
    ,   @TerminalID int
    ,   @ParentID int
    ,   @FirstRow int
    ,   @LastRow int
    
    

    Set @CurrentSessionID = 24927585
    Select @EpisodeID = [PrimaryKey] From State s Join [Table] t on s.TableID = t.TableID Where s.SessionID=24927585 and t.Description = 'Episode'
    Select  @UserID = EntityID From Session where SessionID = 24927585
    Set @TerminalID = NULL
    Set @ParentID = NULL
    Set @FirstRow = 1
    Set @LastRow = 20

------------------------------------------ End Variables - Do not paste text above this line back into Worklist Editor -----------------------------------------------------


IF @EpisodeID = -1
BEGIN
    RETURN
END

CREATE TABLE #RelevantNoteTypes ([Description] varchar(256) COLLATE DATABASE_DEFAULT)
INSERT #RelevantNoteTypes ([Description])
SELECT 'Height Observation'
UNION SELECT 'Weight Observation'
UNION SELECT 'Creatinine Clearance'
UNION SELECT 'Serum Creatinine'
UNION SELECT 'Oxygen Assessment'
UNION SELECT 'VTE Assessment'
UNION SELECT 'Blood glucose'
UNION SELECT 'Serum Creatinine'
UNION SELECT 'Creatinine Clearance'
UNION SELECT 'Bilirubin Serum'
UNION SELECT 'Blood Glucose'
UNION SELECT 'Lithium Level'
UNION SELECT 'Digoxin Level'
UNION SELECT 'eGFR'
UNION SELECT 'Vancomycin Level'
UNION SELECT 'Gentamicin Pre Dose'
UNION SELECT 'Gentamicin Post Dose'
UNION SELECT 'Sodium'
UNION SELECT 'CholesterolTotal'
UNION SELECT 'HDL'
UNION SELECT 'LDL'
UNION SELECT 'Pulse Rate'
UNION SELECT 'Respiration Rate'
UNION SELECT 'INR Test'
UNION SELECT 'BloodPressure'
UNION SELECT 'Triglycerides'
UNION SELECT 'QTcIntervalCorrected'
UNION SELECT 'TSH'
UNION SELECT 'Prolactin'
UNION SELECT 'NG Aspirate pH'

SELECT
			Note.NoteID AS 'ID',
			EpisodeNote.episodeid as 'EpisodeID',
			case 
				when BloodPressure.NoteID is null then
					Note.[Description]+ coalesce(' (' + convert(varchar(50), Observation.Value) + ' ' + Unit.Abbreviation + ')', ' (' + convert(varchar(50), ObservationNoUnit.Value) + ')','')
				--else
				--	Note.[Description]+ coalesce(' (' + convert(varchar(50),BloodPressure.SystolicmmHg) + '/' + convert(varchar(50),BloodPressure.DiastolicmmHg) + ')','','')
			End AS 'Text'
			,   convert(varchar(8), Note.CreatedDate, 3) + ' ' + convert(varchar(5), Note.CreatedDate, 8) AS 'Date'
			,   ''AS 'Status'
			,   'Note' AS 'Class'
FROM
    Note
    JOIN EpisodeNote ON Note.NoteID = EpisodeNote.NoteID
    JOIN NoteType ON Note.NoteTypeID = NoteType.NoteTypeID
    JOIN #RelevantNoteTypes R ON NoteType.[Description] = R.[Description]
    LEFT JOIN NoteCancellation ON Note.NoteID = NoteCancellation.NoteID_Cancelled
    LEFT JOIN Observation 
        JOIN Unit ON Observation.UnitID = Unit.UnitID
    ON Note.NoteID = Observation.NoteID
	LEFT JOIN BloodPressure ON BloodPressure.NoteID = Note.NoteID
    LEFT JOIN ObservationNoUnit ON Note.NoteID = ObservationNoUnit.NoteID	
    
WHERE
    EpisodeNote.EpisodeID in( select Episodeid from Episode where EpisodeTypeID =2 and EndDate is null)
    AND NoteCancellation.NoteID IS NULL
ORDER BY
        NoteType.[Description]
    ,   Note.CreatedDate 

DROP TABLE #RelevantNoteTypes 



