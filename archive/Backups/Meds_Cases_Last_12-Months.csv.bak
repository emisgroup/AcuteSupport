DECLARE @Batch INT
DECLARE @Date VARCHAR(8)
 
 
SET @Batch = 	(SELECT MAX(GFBatchNumber) FROM [EPMA-RPT-L1].[EHSC_REPORT_LIVE].dbo.Interface_AP)
 
 
SET @Date = (CONVERT(CHAR(8),	(
								SELECT TOP 1 GFBatchDate
								FROM [EPMA-RPT-L1].[EHSC_REPORT_LIVE].dbo.Interface_AP
								WHERE GFBatchNumber = @Batch
								),112
					)
			)
 
 
IF (SELECT TOP 1 [Pad] FROM icwsys.wReconcil ORDER BY [PAD] Desc) < @Batch
	BEGIN
		UPDATE icwsys.WReconcil 
		SET
				[Status] = '8'
			,	CodingSlipDate = @Date
			,	Pad = @Batch
		FROM icwsys.WReconcil
		WHERE
				WReconcilID IN
					(
					SELECT WReconcilID
					FROM [EPMA-RPT-L1].[EHSC_REPORT_LIVE].dbo.Interface_AP
					WHERE GFBatchNumber = @Batch
					)
	END

