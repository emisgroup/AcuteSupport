"CS1755427","The Royal Wolverhampton NHS Trust","3 - Medium","23/03/2026 10:58:05","Closed","Replication sync status Email Notifications","26/03/2026 15:57:14","system","Acute Care Medicines Management Level 1 Team","Muhammed Rashik Rahman","25/03/2026 17:29:46 - Muhammed Rashik Rahman (Work notes)
USE master
go
--updated Instructions:
-- AB - CHANGE EVERY SECTION NOTED WITH '--AB EDIT THIS -'

--previous instructions-
--Check the publication name on line 23
--Set the to list on line 41 (Leave the Medicines Management email in their for support to see it)
--set DB mail profile on line 116, see line 76 for testing as might need to remove some other servers that we don't monitor. 
--Last thing is to check on BC side that job step has an appopriate retry attempts (5 x 5 min interval) as most times these are set to maximum integer value which means they won't report failure!


-- JH 14-01-2015 --
-- Compare the synchronised time for listed replication publications
-- to current time.  If it exceeds threshold e-mail listed recipients 
-- the details.

-- JH Amended 18-12-2018 having occasional performance issues showing this
-- query using nearly all CPU.
---------------------------------------------------------------------------
--Define monitoring threshold in the scale of minutes
---------------------------------------------------------------------------
DECLARE @minutes INT

-- AB EDIT THIS - FREQUENCY OF NOTIFICATIONS
SET @minutes = 15 --> Here is where you define how many minutes sync difference you would like to be notified
-- Add the publications below that you would like to monitor

-- AB EDIT THIS - IDENTIFYING NAME OF PUBLISHER
DECLARE @Publication sysname = 'BC_LIVE_1022' --This is the identifying name of the publication. 

IF OBJECT_ID('tempdb..#ReplSyncStatus') IS NOT NULL
      DROP TABLE #ReplSyncStatus

-- Define the email parameters and recipients
DECLARE @Body VARCHAR(max)
DECLARE @TableHead VARCHAR(max)
DECLARE @TableTail VARCHAR(max)
DECLARE @mailitem_id AS INT
DECLARE @statusMsg AS VARCHAR(max)
DECLARE @Error AS VARCHAR(max)
DECLARE @Note AS VARCHAR(max)
DECLARE @mailsubject VARCHAR(100)
DECLARE @Tolist VARCHAR(200)
DECLARE @CClist VARCHAR(110)

--AB EDIT THIS - LIST OF EMAILS
SET @Tolist = 'muhammed.rahman@optum.com'
SET @CClist = ''
--SET @Tolist = ''
--SET @CClist = ''
SET @mailsubject = @@SERVERNAME + ' Replication Sync Status Please Log an incident with EMIS Support Desk'
SET NOCOUNT ON;
SET @mailitem_id = NULL
SET @statusMsg = NULL
SET @Error = NULL
SET @Note = NULL
SET @TableTail = '</table></body></html>';

--First refresh the last sync time for the distribution DB

--AB EDIT THIS -DISTRIBUTION DB NAME
exec [RWEPMASQL1B].distribution.dbo.sp_replmonitorhelpsubscription @publication_type=0

--Run the below to find the subscribers and sync time
SELECT md.publisher as [Publisher]
	,md.publisher_db as [PublisherDB]
	,md.status as [Status]
	,CASE 
		WHEN da.anonymous_subid IS NOT NULL
			THEN -- anonymous subscription
				upper(da.subscriber_name) -- name is stored in subscriber_name instead of sys.servers
		ELSE upper(srv.NAME)
		END as [BCTerminal]
	,md.last_distsync as [LastSync]
	,DATEDIFF(mi, md.last_distsync, GETDATE()) as SyncDiff
	,srv.Name
INTO #ReplSyncStatus
FROM distribution.dbo.MSreplication_monitordata md(NOLOCK)
left JOIN distribution.dbo.MSdistribution_agents da(NOLOCK) ON md.agent_id = da.id
left JOIN sys.servers AS srv ON md.agent_name like '%' + SRV.Name + '%' --MC added as the previous join was not synched to the correct name eg. BC2 is failing and it emails to say BC1 is failing instead
WHERE agent_type = 3
	AND da.publication = @Publication

--AB EDIT THIS - NAMES LIKE THE PREFIX OF THE PC NAMES OR SPECIFIC LIST OF PC NAMES OR NOT LIKE THOSE TO BE EXCLUDED
	and srv.name like '%-RWH0%'

--	and srv.name not like 'EPMA-SQL-REP' ----MC added to not show the site created ones
--	and srv.Name not like '%[[]%' --MC added to stop new join from creating 2 rows per BC
-- Just run from line below to the top if you want to view the output

--DELETE FROM #ReplSyncStatus WHERE BCTerminal IN ('')

SELECT * FROM #ReplSyncStatus

-- If there are any results then send an e-mail notification
IF EXISTS (
            SELECT 1
            FROM #ReplSyncStatus
			WHERE SyncDiff >= @minutes
			or Status =6
            )
BEGIN
DELETE FROM #ReplSyncStatus
WHERE SyncDiff < @minutes and SyncDiff <> null

SELECT * FROM #ReplSyncStatus
      --HTML layout--
      SET @TableHead = '<html><head>' + '<H1 style=""color: #000000"">' + @@SERVERNAME + ' Replication sync status</H1>' + '<style>' + 'td {border: solid black 1px;padding-left:5px;padding-right:5px;padding-top:1px;padding-bottom:1px;font-size:9pt;color:Black;} ' + '</style>' + '</head>' + '<body><table cellpadding=0 cellspacing=0 border=0>' + '<tr bgcolor=#FF6F6F>' + '<td align=center><b>Publisher</b></td>' + '<td align=center><b>Publisher DB</b></td>' + '<td align=center><b>Last Sync Time</b></td>' + '<td align=center><b>Sync Diff (m)</b></td>' + '<td align=center><b>BC Terminal Name</b></td></tr>';

      --Select information for the Report-- 
      SELECT @Body = (
                  SELECT [Publisher] AS [TD]
                        ,[PublisherDB] AS [TD]
                        ,[LastSync] AS [TD]
                        ,[SyncDiff] AS [TD]
                        ,[BCTerminal] AS [TD]
                  FROM #ReplSyncStatus
                  FOR XML raw('tr')
                        ,Elements
                  )

      -- Replace the entity codes and row numbers
      SET @Body = Replace(@Body, '_x0020_', space(1))
      SET @Body = Replace(@Body, '_x003D_', '=')
      SET @Body = Replace(@Body, '<tr><TRRow>1</TRRow>', '<tr bgcolor=#C6CFFF>')
      SET @Body = Replace(@Body, '<TRRow>0</TRRow>', '')
      SET @Body = @TableHead + @Body + @TableTail

      -- return HTML output--
      -- SELECT @Body
      --Email

--AB EDIT THIS - THE PROFILE NAME IN DBMAIL (VIEWABLE IN OPTION 2 , OPTION 4 OF DBMAIL)
      EXEC msdb.dbo.sp_send_dbmail @profile_name = 'Emis Alerts' --This is the mail account to sent from. 
            ,@mailitem_id = @mailitem_id OUT
            ,@recipients = @Tolist
            ,@blind_copy_recipients = @CClist
            ,@subject = @mailsubject
            ,@body = @Body
            ,@body_format = 'HTML';
END

IF OBJECT_ID('tempdb..#ReplSyncStatus') IS NOT NULL
      DROP TABLE #ReplSyncStatus

