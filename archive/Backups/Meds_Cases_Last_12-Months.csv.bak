WITH CTE AS (
    SELECT l.LocationID,lleg.EpmaGroupID, l.Description
    FROM icwsys.LocationLinkEpmaGroup AS lleg
    JOIN location AS l 
        ON l.LocationID = lleg.LocationID
       AND l.LocationTypeID = 4
)
SELECT cte.LocationID,cte.Description,cte.epmagroupid,e.EpisodeID,e.StartDate,e.EndDate,e.EntityID, ea.Alias into #Temp1
FROM CTE
join EpisodeLocation el on el.LocationID=cte.LocationID and el.Active = 1 and el.EndDate is NULL
join Episode e on e.EpisodeID=el.EpisodeID and e.EpisodeTypeID = 2 and e.enddate is NULL
join entityalias ea on ea.EntityID=e.EntityID and ea.AliasGroupID = 22 and ea.[Default] = 1

select * from #Temp1
order by locationid, EpisodeID desc

drop table #Temp1

