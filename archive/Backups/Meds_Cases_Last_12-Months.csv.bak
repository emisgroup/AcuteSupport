21/05/2026 14:20:28 - Muhammed Rashik Rahman (Work notes)
$logPath = ""C:\inetpub\logs\LogFiles\W3SVC1\""
$archivePath = ""D:\AscribeArchive\IISArchive\Temp\Manual\""
$daysOld = 30

# Ensure archive folder exists
if (!(Test-Path $archivePath)) {
    New-Item -ItemType Directory -Path $archivePath
}

# Get old log files
$files = Get-ChildItem -Path $logPath -Recurse -File |
    Where-Object { $_.LastWriteTime -lt (Get-Date).AddDays(-$daysOld) }

foreach ($file in $files) {
    $zipFile = ""$archivePath\$($file.BaseName).zip""

    Compress-Archive -Path $file.FullName -DestinationPath $zipFile

    # Verify archive before deleting original
    if (Test-Path $zipFile) {
        Remove-Item $file.FullName -Force
    }
}

