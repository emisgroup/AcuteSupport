-- View current blocking
EXEC sp_who2;-----------blk by is empty means not blaocking



-- View active requests and wait types
SELECT * FROM sys.dm_exec_requests WHERE status = 'suspended'

-- View top wait types
SELECT TOP 10 wait_type, wait_time_ms, waiting_tasks_count
FROM sys.dm_os_wait_stats
ORDER BY wait_time_ms DESC


SELECT TOP 10 r.session_id, r.start_time, r.status, r.command, r.cpu_time, r.total_elapsed_time, t.text AS [Query Text]

FROM sys.dm_exec_requests r

CROSS APPLY sys.dm_exec_sql_text(r.sql_handle) t

ORDER BY r.cpu_time DESC-----long run query



---------Long run query

