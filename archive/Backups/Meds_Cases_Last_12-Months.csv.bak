select OT.OrderTemplateid,OT.description,OT.ProductName,OT.ProductID, OT.Description_Full, OT.Class,
case when OT.formulary = 1 then 'Yes'
when formulary =0 then 'No'
Else ''
End as Formulary,OT.Prescription,
case when OTS.Detail is null or cast(OTS.Detail as varchar(max))='' then 'No'
else 'Yes' End as 'FurtherDetais(YES/NO)',OTS.Detail,
case when OTS.FurtherDescription is null or cast(ots.FurtherDescription as varchar(max))='' then 'No'
else 'Yes' End as FurtherDescription,OTS.FurtherDescription
from OrderTemplates OT
join OrderTemplate OTS on ots.OrderTemplateID =ot.OrderTemplateID

