--USE [EHSC_HAP_LIVE]
--GO
--/****** Object:  StoredProcedure [icwsys].[peMMInterventionsWorkListQuery]    Script Date: 05/06/2026 10:16:25 ******/
--SET ANSI_NULLS ON
--GO
--SET QUOTED_IDENTIFIER ON
--GO


--ALTER Procedure [icwsys].[peMMInterventionsWorkListQuery]  
--	(  
--		  @CurrentSessionID int  
--		, @Pass_Ward int  
--		, @Pass_Ward_Group int  
--	)  
--	as  

declare @CurrentSessionID int =89765028
declare @Pass_Ward int  =-1
declare @Pass_Ward_Group int  
BEGIN  

	DECLARE @Ward Int 
		,	@Ward_Group Int
		  
	select @Ward = isnull(@Pass_Ward, -1)  
	select @Ward_Group = isnull(@Pass_Ward_Group, -1)  
		  
	declare @UserFlagOneText varchar(12)  
	declare @UserFlagTwoText varchar(12)  
	declare @UserFlagThreeText varchar(12)  
	declare @UserFlagFourText varchar(12)  
	declare @UserFlagFiveText varchar(12)  
	declare @OrderedByText varchar(20)  
	declare @AwaitingClinicalCheckText varchar(30)  
	declare @PriorityText varchar(10)  
	declare @ClinicalScreeningInUse int  
	Declare @StatusTextSeperator varchar(5)    
	Declare @ConditionalCheckText varchar(30) -- 48298   
	declare @ClinicalCheckAgainstClosedEpisodes int
	  
	declare @LocationID int  
	declare @IncludeClosedFromDate datetime
	  
	select   
		@LocationID = 0  
	from   
		Session   
	where   
		SessionID = 89765028 
	  
	select   
		  @UserFlagOneText = UserFlagOneText  
		, @UserFlagTwoText = UserFlagTwoText  
		, @UserFlagThreeText = UserFlagThreeText  
		, @UserFlagFourText = UserFlagFourText  
		, @UserFlagFiveText = UserFlagFiveText  
		, @AwaitingClinicalCheckText = AwaitingClinicalCheckText  
		, @PriorityText = PriorityText  
		, @OrderedByText = OrderedByText  
		, @StatusTextSeperator = StatusTextSeperator 
		, @ConditionalCheckText = ConditionalCheckText -- 48298   
		, @ClinicalCheckAgainstClosedEpisodes = ClinicalCheckAgainstClosedEpisodes
	from   
		eMMDefaults  
	where   
		eMMDefaults.LocationID_Parent = icwsys.feMMSettingsByChildLocation(@LocationID);  
	  
	SELECT	@IncludeClosedFromDate =	CASE
									WHEN @ClinicalCheckAgainstClosedEpisodes IS NULL THEN
										NULL
									WHEN @ClinicalCheckAgainstClosedEpisodes = 0 THEN
										DATEADD(dd, DATEDIFF(dd, -1, GETDATE()), 0)
									ELSE
										DATEADD(dd, DATEDIFF(dd, @ClinicalCheckAgainstClosedEpisodes, GETDATE()), 0)
								END
	  
	DECLARE @Result TABLE
	(
	  [ID] int UNIQUE, 
	  [Class] varchar(256),
	  [Text] varchar(4000),
	  [Date] varchar(256),
	  [Status] varchar(256),
	  [OrderBy1] varchar(256),
	  [OrderBy2] varchar(256),
	  [OrderBy3]  varchar(256),
	  [Query] varchar(256),
	  [EntityID] int,
	  [DOB] datetime,
	  [Surname] varchar(256),
	  [Forename] varchar(256)
	);      

	insert into  @Result 
		Select distinct  
			  Request.RequestID as 'ID'   
			, 'Request' as 'Class'  
			, Request.Location + ' - ' + Request.Patient + ' - ' + request.[Description] as 'Text'  
			, convert(varchar(50), Request.RequestDate, 106) as 'Date'  
			, icwsys.fASCTrimStatuseMM(
			  CASE  
				WHEN RequestStatus.eMMIntervention = 1    
				THEN @StatusTextSeperator
					 + convert(varchar(20), RequestStatus.eMMIntervention__CreatedDate, 106) + ' ' + convert(varchar(5), RequestStatus.eMMIntervention__CreatedDate, 8) + ' by ' + Entity_Intervention.[description]   
					 + isnull(' (' + eMMInterventionReason.Description + isnull(' - ' + eMMIntervention.Comments, '') + ') ', '')  
				ELSE ''  
			  END  
			+ Case when Request.eMMSupply = 1 then @StatusTextSeperator + @OrderedByText + convert(varchar(20), note.createddate, 106) + ' ' + convert(varchar(5), note.createddate, 8) + ' - ' +entity.[description] else '' end   
			+ Case when Request.Screen = 0  and @ClinicalScreeningInUse = 1 then @StatusTextSeperator + @AwaitingClinicalCheckText else '' end   
			+ CASE  
				WHEN RequestStatus.eMMConditionalCheck = 1    
				THEN @StatusTextSeperator + @ConditionalCheckText  
					 + ' ('+convert(varchar(20), RequestStatus.eMMConditionalCheck__CreatedDate, 106) + ' ' + convert(varchar(5), RequestStatus.eMMConditionalCheck__CreatedDate, 8) + ' by ' + Entity_eMMConditionalCheck.[description] + ')'  
					 + isnull(' (' + ascEMMConditionalCheckReason.Description + isnull(' - ' + eMMConditionalCheck.Comments, '') + ') ', '')  
				ELSE ''  
			  END  
			+ Case when ems.Priority=1 then @StatusTextSeperator + @PriorityText else '' end   
			+ Case when (Request.eMMSupply = 1 and ems.UserFlagOne = 1)  then @StatusTextSeperator + @UserFlagOneText   else '' end   
			+ Case when (Request.eMMSupply = 1 and ems.UserFlagTwo = 1)  then @StatusTextSeperator + @UserFlagTwoText   else '' end   
			+ Case when (Request.eMMSupply = 1 and ems.UserFlagThree = 1)then @StatusTextSeperator + @UserFlagThreeText else '' end   
			+ Case when (Request.eMMSupply = 1 and ems.UserFlagFour = 1) then @StatusTextSeperator + @UserFlagFourText  else '' end   
			+ Case when (Request.eMMSupply = 1 and ems.UserFlagFive = 1) then @StatusTextSeperator + @UserFlagFiveText  else '' end   
			+ Case when (Request.eMMSupply = 1 and len(rtrim(ems.comments))>0) then @StatusTextSeperator + ems.comments else '' end  
			+ isnull(@StatusTextSeperator + ' (' + Del.[Description] + ')', '')  
			  ,@StatusTextSeperator) as 'Status'  
			 -- Sort Information 
			,  isnull(ems.Priority, 0) AS 'OrderBy1'   
			,  Request.Location        AS 'OrderBy2' 
			,  Request.Patient         AS 'OrderBy3'
			,  '' as Query 
			,  Request.EntityID_Patient ""EntityID""
			,  pat.DOB ""DOB""
			,  per.Surname ""Surname""
			,  per.Forename ""Forename""
		From  
			eMM_PMR Request  
			join Episode Episode_Lifetime ON Request.EntityID_Patient = Episode_Lifetime.EntityID AND Episode_Lifetime.EpisodeID_Parent = 0  
			left join RequestLinkAttachedNote ran on ran.noteid =   
				(   
					select   
					top 1  
					note.noteid  
					from emmsupply ems  
					join note on ems.noteid = note.noteid  
					join RequestLinkAttachedNote ran on ran.noteid = note.noteid  
					join RequestStatus on (Ran.RequestID = RequestStatus.RequestID)  
				where ran.requestid = request.requestid and RequestStatus.emmsupply=1  
				order by note.createddate desc  
				)  
			left join Note on Ran.NoteID = Note.NoteID  
			left join entity on note.entityid = entity.entityid  
			left join emmsupply ems on note.noteid = ems.noteid 
			left JOIN Person per ON Request.EntityID_Patient = per.EntityID        
			left JOIN Patient pat ON Request.EntityID_Patient = pat.EntityID  
			left join ascEMMDeliveryMethod Del ON ems.ascEMMDeliveryMethodID = Del.ascEMMDeliveryMethodID AND ems.ascEMMDeliveryMethodID > 0  
			JOIN Ward W ON Request.LocationID = W.LocationID  
			JOIN RequestStatus ON Request.RequestID = RequestStatus.RequestID  
			-- Interventions  
			JOIN eMMIntervention ON RequestStatus.eMMIntervention__NoteID = eMMIntervention.NoteID  
			LEFT JOIN eMMInterventionReason ON eMMIntervention.eMMInterventionReasonID = eMMInterventionReason.eMMInterventionReasonID AND eMMInterventionReason.eMMInterventionReasonID > 0  
			LEFT JOIN Entity Entity_Intervention ON RequestStatus.eMMIntervention__EntityID = Entity_Intervention.EntityID  
			-- eMMConditionalCheck  
			LEFT JOIN eMMConditionalCheck ON RequestStatus.eMMConditionalCheck__NoteID = eMMConditionalCheck.NoteID  
			LEFT JOIN ascEMMConditionalCheckReason ON eMMConditionalCheck.ascEMMConditionalCheckReasonID = ascEMMConditionalCheckReason.ascEMMConditionalCheckReasonID AND ascEMMConditionalCheckReason.ascEMMConditionalCheckReasonID > 0  
			LEFT JOIN Entity Entity_eMMConditionalCheck ON RequestStatus.eMMConditionalCheck__EntityID = Entity_eMMConditionalCheck.EntityID  
		Where  Request.eMMIntervention__NoteID <> 0  		
		    and Request.eMMIntervention = 1  
			and Request.Cancelled = 0  
			and Request.Expired = 0  
			and (  
					@Ward = -1  
					OR Request.LocationID = @Ward  
				)  
			and (  
					@Ward_Group = -1  
					OR W.WardGroupID = @Ward_Group  
				)
				-- AND episode.EndDate is  null
			and		(		@ClinicalCheckAgainstClosedEpisodes IS NULL
					OR	Request.Episode_EndDate IS NULL
					OR	Request.Episode_EndDate >= @IncludeClosedFromDate
				)
				
			and Episode_Lifetime.EndDate is  null;
						
	  -- Get all patient specific information from @Result
	DECLARE @PatientData AS PatientMatchingTableType
	insert into @PatientData
	select DISTINCT [EntityID], [Surname],[Forename],[DOB] from @Result; 

	-- Return results. GetPatientMatchingStatus checks for any similar patients in the result and appends a message to the status if similar patient found
	SELECT
	r1.ID,
	r1.[Class], 
	r1.[Query],
	r1.[Text],        
	r1.[Date],
	isnull(r1.[Status], '') 
	  + CASE when isnull(r1.[Status],'') <> '' and isnull(pd.[Status], '') <> '' 
			 Then ' | '
			 Else ''
		END
	  + isnull(pd.[Status], '') AS 'Status',
	r1.[OrderBy1],
	r1.[OrderBy2],
	r1.[OrderBy3],
	r1.[Query]
	from @Result r1 inner join GetPatientMatchingStatus(@PatientData) pd on r1.[EntityID] = pd.ID
	order by   
		isnull(OrderBy1, 0) DESC  
	  , OrderBy2
	  , OrderBy3
	  , Text;   
  
end

