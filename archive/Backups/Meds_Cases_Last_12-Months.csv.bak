"CS1674413","Northern Lincolnshire And Goole NHS Foundation Trust","2 - High","21/10/2025 15:17:48","Closed","message queue over 1000","21/10/2025 17:17:38","peter.stamford@nhs.net","Acute Care Medicines Management Level 1 Team","Azeem Parvez","21/10/2025 17:06:38 - Azeem Parvez (Work notes)
SELECT
DATEPART(YEAR, ms.timestamp) as 'Year',
DATEPART(MONTH, ms.timestamp) as 'month',
DATEPART(DAY, ms.timestamp) as 'day',
DATEPART(HOUR, ms.timestamp) as Per_hour,
DATEPART(MINUTE, ms.timestamp) as 'minute' ,
count(distinct m.MessageGuid) as 'processed'
FROM MESSAGESTATUS MS (nolock)
JOIN MESSAGE M (nolock)ON M.MESSAGEGUID = MS.MESSAGEGUID
JOIN INTERFACECOMPONENT I (nolock)ON I.INTERFACECOMPONENTID = MS.INTERFACECOMPONENTID and i.name = 'ICWMsgProcessor' --may need to amend i.name, search interfacecomponent table
where ms.Timestamp > '2025-10-21T11:00:00.000' and ms.Timestamp < '2025-10-21T16:20:00.000' and [StatusID] = 12
group by
DATEPART(YEAR, ms.timestamp),
DATEPART(MONTH, ms.timestamp),
DATEPART(DAY, ms.timestamp),
DATEPART(HOUR, ms.timestamp),
DATEPART(MINUTE, ms.timestamp)
--received
SELECT
DATEPART(YEAR, ms.timestamp) as 'Year',
DATEPART(MONTH, ms.timestamp)as 'month',
DATEPART(DAY, ms.timestamp)as 'day',
DATEPART(HOUR, ms.timestamp) as 'Perhour',
DATEPART(MINUTE, ms.timestamp) as 'minute' ,
count(distinct m.MessageGuid) as 'Recieved'
FROM MESSAGESTATUS MS (nolock)
JOIN MESSAGE M (nolock)ON M.MESSAGEGUID = MS.MESSAGEGUID
JOIN INTERFACECOMPONENT I (nolock)ON I.INTERFACECOMPONENTID = MS.INTERFACECOMPONENTID and i.name = 'IPReceiver'
where ms.Timestamp > '2025-10-21 11:00:00.000' and ms.Timestamp < '2025-10-21 16:20:00.000' and [StatusID] = 8
group by
DATEPART(YEAR, ms.timestamp),
DATEPART(MONTH, ms.timestamp),
DATEPART(DAY, ms.timestamp),
DATEPART(HOUR, ms.timestamp),
DATEPART(MINUTE, ms.timestamp)

--select top 10 * from InterfaceComponent

