SELECT ca.ContextAuditID,ca.EpisodeID,t.ComputerName,ca.DateAccessed,d.Description as 'Desktop', e.Description as 'User'
FROM ContextAudit ca
join Desktop d on d.DesktopID =ca.DesktopID
join Terminal t on t.LocationID =ca.LocationID_Terminal
join Entity e on e.EntityID = ca.EntityID_User 
WHERE DateAccessed >= DATEADD(MONTH, -6, GETDATE())
ORDER BY DateAccessed DESC

