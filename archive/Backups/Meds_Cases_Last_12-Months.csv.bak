join role r on r.roleid=ulr.RoleID
join entity e on e.EntityID=ulr.EntityID
join [user] u on u.EntityID = ulr.EntityID
where r.roleid in (341,
4,
342,
343) ---- this will show the users having the wrong role id which created under wrong location, Probably 0

