-------Genfin_Trust_ELFS
select reconciledate as 'date',* from WReconcil where Status='7' and SiteID in(11358,11359,11360)
order by reconciledate desc


---- Find for the site which not included in Genfin AP_Include sites, then we found the site ID 37 is using Print Coding slip in store module(Royal Preston Hospital Homecare-612)
select ReconcileDate,CodingSlipDate,* from WReconcil where Status='7' and SiteID not in(11358,11359,11360,19,20,21,22) --3174
-- There are 3174 records which was causing to crash when Genfin run due the limlitation of the system . 
-- Either run 'Print Coding slip ' from the  store module or manually update it from the backend table.


begin tran
update WReconcil
set Status ='8'
where SiteID=37 and Status ='7'

commit
rollback


