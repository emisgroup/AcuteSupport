/****** Object:  StoredProcedure [icwsys].[peMMDispensingWorklistQuery]    Script Date: 24/03/2026 14:06:26 ******/
SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO


ALTER PROCEDURE [icwsys].[peMMDispensingWorklistQuery]
(
???????????? @CurrentSessionID int
????????????, @Pass_Ward_Group int
????????????, @Pass_Delivery_Method int
)

AS

BEGIN

??????DECLARE @Ward_Group int
??????DECLARE @Delivery_Method int
??????DECLARE @IncludeClosedFromDate datetime

??????--If @Ward_Group is anything other than -1 or NULL, then only prescriptions for wards in the group will be shown
??????-- otherwise, prescriptions for all wards returned by fWardListByStockholdingTerminal will be shown
??????SELECT @Ward_Group = isnull(@Pass_Ward_Group, -1)

??????SELECT @Delivery_Method = isnull(@Pass_Delivery_Method, -1)
??????
??????DECLARE
??????????????????@LocationID int

??????SELECT
????????????@LocationID = LocationID
??????FROM
????????????Session
??????WHERE
????????????SessionID = @CurrentSessionID
????????????
??????CREATE TABLE #RelevantWards (LocationID int primary key)
??????INSERT
????????????#RelevantWards (LocationID)
??????SELECT
????????????LocationID
??????FROM
????????????icwsys.fWardListByStockholdingTerminal(@LocationID)

??????DECLARE
???????????? @UserFlagOneText varchar(12)
????????????, @UserFlagTwoText varchar(12)
????????????, @UserFlagThreeText varchar(12)
????????????, @UserFlagFourText varchar(12)
????????????, @UserFlagFiveText varchar(12)
????????????, @ClinicalCheckBeforeSupply bit
????????????, @PriorityText varchar(12)
????????????, @ExcludeDeliveryMethod bit
????????????, @ClinicalCheckAgainstClosedEpisodes int
????????????
??????SELECT
???????????? @UserFlagOneText = UserFlagOneText
????????????, @UserFlagTwoText = UserFlagTwoText
????????????, @UserFlagThreeText = UserFlagThreeText
????????????, @UserFlagFourText = UserFlagFourText
????????????, @UserFlagFiveText = UserFlagFiveText
????????????, @ClinicalCheckBeforeSupply = ClinicalCheckBeforeSupply
????????????, @PriorityText = PriorityText
????????????, @ExcludeDeliveryMethod = ExcludeDeliveryMethod
????????????, @ClinicalCheckAgainstClosedEpisodes = ClinicalCheckAgainstClosedEpisodes
??????FROM
????????????eMMDefaults
??????WHERE
????????????eMMDefaults.LocationID_Parent = [icwsys].feMMSettingsByChildLocation(@LocationID)

??????SELECT??????@IncludeClosedFromDate =??????CASE
??????????????????????????????????????????????????????????????????WHEN @ClinicalCheckAgainstClosedEpisodes IS NULL THEN
????????????????????????????????????????????????????????????????????????NULL
??????????????????????????????????????????????????????????????????WHEN @ClinicalCheckAgainstClosedEpisodes = 0 THEN
????????????????????????????????????????????????????????????????????????DATEADD(dd, DATEDIFF(dd, -1, GETDATE()), 0)
??????????????????????????????????????????????????????????????????ELSE
????????????????????????????????????????????????????????????????????????DATEADD(dd, DATEDIFF(dd, @ClinicalCheckAgainstClosedEpisodes, GETDATE()), 0)
????????????????????????????????????????????????????????????END

??????-- Step 1, just grab the data we need. Previous version did everything in one go, but went really slow when we added an isnull() round the ems.comments field.
??????-- So, to make things faster we'll just gtab the relevant data here and then worry about the presentational side of it later.
??????SELECT
???????????? Request.RequestID
????????????, ems.Priority
????????????, Location.[Description] AS 'Location'
????????????, Person.Surname
????????????, Person.Forename
????????????, Patient.DOB
????????????, Request.[Description] AS 'Request'
????????????, Request.RequestDate
????????????, RS.eMMSupply__CreatedDate
????????????, en.[description] AS 'Requester'
????????????, ems.UserFlagOne
????????????, ems.UserFlagTwo
????????????, ems.UserFlagThree
????????????, ems.UserFlagFour
????????????, ems.UserFlagFive
????????????, ems.comments
????????????, DM.[Description] AS 'DeliveryMethod'

??????INTO
????????????#Results
??????FROM
????????????Request
????????????JOIN RequestStatus RS ON Request.RequestID = RS.RequestID
????????????JOIN EpisodeOrder on Request.RequestID = EpisodeOrder.RequestID
????????????JOIN Episode ON Episode.EpisodeID = EpisodeOrder.EpisodeID
????????????JOIN Entity ON Episode.EntityID = Entity.EntityID
????????????JOIN Episode Episode_Lifetime ON Entity.EntityID = Episode_Lifetime.EntityID AND Episode_Lifetime.EpisodeID_Parent = 0

????????????JOIN Person ON Episode.EntityID = Person.EntityID
????????????JOIN Patient ON Episode.EntityID = Patient.EntityID
????????????
????????????LEFT JOIN EpisodeLocation EL
??????????????????JOIN Location ON EL.LocationID = Location.LocationID
??????????????????JOIN Ward ON Location.LocationID = Ward.LocationID
????????????ON Episode.EpisodeID = EL.EpisodeID AND EL.Active = 1
????????????

????????????JOIN EMMSupply ems on RS.eMMSupply__NoteID = ems.NoteID
????????????LEFT JOIN ascEMMDeliveryMethod DM ON ems.ascEMMDeliveryMethodID = DM.ascEMMDeliveryMethodID AND ems.ascEMMDeliveryMethodID > 0
????????????JOIN Entity en on RS.eMMSupply__EntityID = En.EntityID
????????????
????????????LEFT JOIN #RelevantWards RW ON EL.LocationID = RW.LocationID
????????????
????????????LEFT JOIN WPrescriptionMergeItem ON Request.RequestID = WPrescriptionMergeItem.RequestID_Prescription AND WPrescriptionMergeItem.Active = 1
????????????
????????????OUTER APPLY (
????????????????????????????????????--Find latest dispensing
????????????????????????????????????SELECT TOP 1
??????????????????????????????????????????isnull(wTransLog.LogDateTime, re.CreatedDate) AS 'Date'
????????????????????????????????????FROM
??????????????????????????????????????????WLabel wl
??????????????????????????????????????????JOIN Request re ON re.RequestID = wl.RequestID
??????????????????????????????????????????LEFT JOIN wTransLog ON wl.RequestID = wTransLog.RequestID_Dispensing
????????????????????????????????????WHERE
??????????????????????????????????????????(
????????????????????????????????????????????????re.RequestID_Parent = Request.RequestID
????????????????????????????????????????????????OR
????????????????????????????????????????????????re.RequestID_Parent = WPrescriptionMergeItem.RequestID_WPrescriptionMerge
??????????????????????????????????????????)
????????????????????????????????????ORDER BY
??????????????????????????????????????????isnull(wTransLog.LogDateTime, re.CreatedDate) DESC
??????????????????????????????) AS LastDispensing
??????WHERE RS.eMMSupply__NoteID <> 0 AND
????????????(
??????????????????Ward.WardGroupID = @Ward_Group
??????????????????OR
??????????????????(
????????????????????????@Ward_Group = -1
????????????????????????AND
????????????????????????RW.LocationID IS NOT NULL
??????????????????)
????????????)
????????????AND
????????????(
?????????????????? --NULL passed in, show all
??????????????????@Delivery_Method = -1
???????????????????????? and (
??????????????????????????????@ExcludeDeliveryMethod <> 1
??????????????????????????????or DM.ascemmDeliveryMethodID IS NULL
???????????????????????? )
??????????????????OR
??????????????????(
????????????????????????@Delivery_Method = 0 --0 passed in, show only ones with no Delivery Method
????????????????????????AND
????????????????????????DM.asceMMDeliveryMethodID IS NULL
??????????????????)
??????????????????OR
??????????????????(
????????????????????????@Delivery_Method > 0 --Otherwise show selected DM
????????????????????????AND
????????????????????????ems.ascEMMDeliveryMethodID = @Delivery_Method
??????????????????)
????????????)
??????
????????????--Rx not expired or cancelled
????????????AND RS.[Request Cancellation] = 0
????????????AND RS.Expired = 0
????????????
????????????--Not TTO
????????????AND (
????????????????????????ems.TTO = 0
????????????????????????OR
????????????????????????ems.TTO IS NULL
??????????????????)

????????????--Rx Screened (if necessary), not ToFollow and not Failed
????????????AND RS.ToFollow = 0
????????????AND RS.asceMMPharmacyProblem = 0
????????????AND (RS.Screen + RS.eMMConditionalCheck) >= @ClinicalCheckBeforeSupply
????????????AND RS.eMMPrintedDL =0
????????????
????????????AND (
????????????????????????LastDispensing.Date IS NULL --Never dispensed
????????????????????????or -- Or , if we have been marked as re-supply (the 'emmSupply)' note and that note was added after the last
???????????????????????? -- dispensing - ie. the re-supply has yet to be dispensed
????????????????????????RS.eMMSupply__CreatedDate >= LastDispensing.Date
????????????????????????????????????????????????????????????
????????????????????????
??????????????????)
????????????-- AND episode.EndDate is null
???????????? AND????????(???????????@ClinicalCheckAgainstClosedEpisodes IS NULL
??????????????????????????????OR????Episode.EndDate IS NULL
??????????????????????????????OR????Episode.EndDate >= @IncludeClosedFromDate
????????????????????????)
????????????????????????
????????????and Episode_Lifetime.EndDate is null
??????????????????
??????--Now actually return the results
??????SELECT
???????????? RequestID as 'ID'
????????????, CASE WHEN Priority = 1 THEN @PriorityText ELSE '**' END
??????????????????+ Location + ' - '
??????????????????+ upper(Surname) + ', ' + ISNULL(Forename,'') + ' (' + ISNULL(Convert(varchar(50), DOB, 106), '') + ') '
??????????????????+ Request AS 'Text'
????????????, convert(varchar(11), RequestDate, 106) AS 'Date'
????????????, convert(varchar(20), eMMSupply__CreatedDate, 106) + ' ' + convert(varchar(5), eMMSupply__CreatedDate, 8)
??????????????????+ ' by ' + Requester
??????????????????+ CASE WHEN UserFlagOne = 1 THEN ' ' + @UserFlagOneText ELSE '' END
??????????????????+ CASE WHEN UserFlagTwo = 1 THEN ' ' + @UserFlagTwoText ELSE '' END
??????????????????+ CASE WHEN UserFlagThree = 1 THEN ' ' + @UserFlagThreeText ELSE '' END
??????????????????+ CASE WHEN UserFlagFour = 1 THEN ' ' + @UserFlagFourText ELSE '' END
??????????????????+ CASE WHEN UserFlagFive = 1 THEN ' ' + @UserFlagFiveText ELSE '' END
??????????????????+ ISNULL(' - ' + ltrim(rtrim(Comments)), '')
??????????????????+ isnull(' (' + DeliveryMethod + ')','') AS 'Status'
????????????, 'Request' as Class
????????????, '' as Query
????????????

??????FROM
????????????#Results Request
??????ORDER BY
??????????????????Priority desc
????????????, eMMSupply__CreatedDate
??????
??????
??????DROP TABLE #RelevantWards

END

