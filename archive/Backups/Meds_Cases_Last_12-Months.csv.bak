begin tran
UPDATE L
SET
    L.Description = CASE
        WHEN L.Description NOT LIKE 'Zzzz%' THEN 'Zzzz' + L.Description
        ELSE L.Description
    END,
    L.Detail = CASE
        WHEN L.Detail NOT LIKE 'Zzzz%' THEN 'Zzzz' + L.Detail
        ELSE L.Detail
    END
FROM Location L
JOIN Ward W
    ON W.LocationID = L.LocationID
WHERE W.Out_Of_Use = 1;

--commit
--rollback



SELECT *
INTO Location_Backup_OutOfUse2_CS1770704
FROM Location
--WHERE out_of_use = 1

