-Checking both worklist for both current medication and PMR (both working fine (see on below )

current medication:


1.AGH Medicines Reconciliation PMR


DECLARE
@CurrentSessionID int
, @EpisodeID int
, @UserID int
, @TerminalID int
, @ParentID int
, @FirstRow int
, @LastRow int



Set @CurrentSessionID = 18294912
Select @EpisodeID = [PrimaryKey] From State s Join [Table] t on s.TableID = t.TableID Where s.SessionID=18294912 and t.Description = 'Episode'
Select @UserID = EntityID From Session where SessionID = 18294912
Set @TerminalID = NULL
Set @ParentID = NULL
Set @FirstRow = 1
Set @LastRow = 20

------------------------------------------ End Variables - Do not paste text above this line back into Worklist Editor -----------------------------------------------------

IF @EpisodeID = -1
BEGIN
RETURN
END

DECLARE @CancelledCutOff int
SELECT @CancelledCutOff = InpatientCancelledCutoff FROM icwsys.fASCGenericPrescribingSettingsByChildLocation(@TerminalID)

DECLARE @ShowIndicatorWhenFormulary bit
SELECT
@ShowIndicatorWhenFormulary = case when value = 'true' then 1 else 0 end
FROM
??????Setting
WHERE
??????[System] = 'ICW'
AND
??????[Section] = 'Prescribing'
AND
??????[Key] = 'ShowIndicatorWhenFormulary'

SELECT *
FROM
(
SELECT
InnerResults.*
, row_number() over(ORDER BY InnerResults.Weighting, InnerResults.OrderBy1, InnerResults.OrderBy2, InnerResults.OrderBy3) AS 'RowNumber'
, count(*) OVER () AS 'Rowcount'
FROM
(
SELECT
Request.RequestID AS 'ID'
, Request.[Description] + isnull(' FROM ORDERSET: ' + Parent.[Description], '') AS 'Text'
, icwsys.fASCPMRDate(Request.RequestID) AS 'Date'
, ISNULL(icwsys.fASCCurrentPMRStatus(Request.RequestID), '')
??????????????????+ CASE WHEN RequestStatus.DrugOnAdmission = 1 THEN ' | Drug On Admission' ELSE '' END
+ icwsys.fIsFormularyIndicatorFromFlags(Request.IsFormulary, ot.IsFormulary, @ShowIndicatorWhenFormulary, ' | ') AS 'Status'
, 'Request' AS 'Class'
, CASE
WHEN RequestStatus.EpisodeOrder__EpisodeID <> @EpisodeID AND
(
-- If the reconciled prescription's expected end date is in the past or is a 'Single Dose' then set the Weighting to -1 (Weighting of -1 will be removed from the result blow)
(Prescription.RequestID IS NOT NULL AND (DATEADD(ss,(Prescription.Duration * PrescriptionUnit.Multiple), Prescription.StartDate) < GETDATE() OR Prescription.Description_Frequency = 'Single Dose')) OR
(GenericPrescription.RequestID IS NOT NULL AND DATEADD(ss,(GenericPrescription.Duration * GenericPrescriptionUnit.Multiple), GenericPrescription.StartDate_GenericPrescription) < GETDATE())
) THEN '-1'
WHEN RequestStatus.EpisodeOrder__EpisodeID <> @EpisodeID THEN 14 --From old episodes
WHEN RequestStatus.RequestType__Description = 'Enteral Prescription' THEN 12 --Dietary
WHEN RequestStatus.RequestType__Description = 'PN Prescription' THEN 8 --Fluids and electrolytes
WHEN Ingredient.Description_Drug = 'TPN' THEN 8 -- Fluids and Electrolytes
WHEN TM.DrugChartFluid = 1 AND icwsys.fIsRequestFluidAndElectrolytes(Request.RequestID) = 1 THEN 8
WHEN TM.DrugChartBlood = 1 OR icwsys.fIsDrugChartBlood(Ingredient.ProductID) = 1 THEN 10
????????????????????????WHEN Prescription.IsIfRequired = 1 AND Prescription.ScheduleID_Administration = 0 THEN 2 --Single Dose
WHEN isnull(Prescription.PRN, GenericPrescription.PRN) = 0 AND isnull(Prescription.ScheduleID_Administration, GenericPrescription.ScheduleID_Administration) = 0 THEN 2 --Single Dose
WHEN isnull(Prescription.PRN, GenericPrescription.PRN) = 0 THEN 4 --Regular Scheduled Meds
WHEN isnull(Prescription.PRN, GenericPrescription.PRN) = 1 THEN 6 -- PRNs (both WHEN and IF)
ELSE 99--Others
END AS 'Weighting'
, RequestStatus.[Request Cancellation] AS 'OrderBy1'
, coalesce(Ingredient.Description_Drug, GenericPrescription.DrugName, Request.[Description]) AS 'OrderBy2'
, Request.RequestDate AS 'OrderBy3'
FROM
Request
JOIN RequestStatus ON Request.RequestID = RequestStatus.RequestID
????????????LEFT JOIN EpisodeOrder eo on eo.RequestID = Request.RequestID
????????????LEFT JOIN OrderTemplateWithFormularyFlag ot on ot.OrderTemplateID = eo.OrderTemplateID
LEFT JOIN Request Parent ON Request.RequestID_Parent = Parent.RequestID AND Request.RequestID_Parent > 0
LEFT JOIN Ingredient ON Request.RequestID = Ingredient.RequestID
LEFT JOIN Prescription ON Request.RequestID = Prescription.RequestID
LEFT JOIN GenericPrescription ON Request.RequestID = GenericPrescription.RequestID
LEFT JOIN PrescriptionInfusion ON Request.RequestID = PrescriptionInfusion.RequestID
LEFT JOIN [Unit] PrescriptionUnit on Prescription.UnitID_Duration = PrescriptionUnit.UnitId
LEFT JOIN [Unit] GenericPrescriptionUnit on GenericPrescription.UnitID_Duration = GenericPrescriptionUnit.UnitId
JOIN icwsys.fAllEpisode(@EpisodeID) E ON RequestStatus.EpisodeOrder__EpisodeID = E.EpisodeID
OUTER APPLY (
SELECT TOP 1 DrugChartBlood, DrugChartFluid from icwsys.TherapeuticMoiety
JOIN icwsys.fProductComposition(Ingredient.ProductID) c on c.ProductID = TherapeuticMoiety.ProductID
) TM
LEFT JOIN vMostRecentReviewRequest mrrr on Request.RequestID = mrrr.RequestID
WHERE
RequestStatus.RequestType__Description IN ('Standard Prescription', 'Infusion Prescription', 'Doseless Prescription', 'Generic Prescription', 'Product Order', 'Enteral Prescription', 'PN Prescription')
AND (
Ingredient.PrimaryIngredient = 1
OR Ingredient.RequestID IS NULL --Free-text Prescriptions
)
AND (
RequestStatus.[Request Cancellation] = 0
OR datediff(hour, RequestStatus.Request_Cancellation__CreatedDate, getdate()) < @CancelledCutOff
OR mrrr.Complete = 0
)
AND (RequestStatus.Expired = 0 OR mrrr.Complete = 0)
AND NOT (RequestStatus.EpisodeOrder__EpisodeID <> @EpisodeID AND RequestStatus.[Request Cancellation] = 1 AND (mrrr.Complete IS NULL OR mrrr.Complete = 1))

UNION ALL

SELECT
0 AS ID
, 'ONCE ONLY MEDICATION' AS 'Text'
, '' AS 'Date'
, '' AS 'Status'
, 'Header' AS 'Class'
, 1 AS 'Weighting'
, NULL AS 'OrderBy1'
, NULL AS 'OrderBy2'
, NULL AS 'OrderBy3'

UNION ALL

SELECT
0 AS ID
, 'REGULAR MEDICATION' AS 'Text'
, '' AS 'Date'
, '' AS 'Status'
, 'Header' AS 'Class'
, 3 AS 'Weighting'
, NULL AS 'OrderBy1'
, NULL AS 'OrderBy2'
, NULL AS 'OrderBy3'

UNION ALL
SELECT
0 AS ID
, 'AS REQUIRED MEDICATION' AS 'Text'
, '' AS 'Date'
, '' AS 'Status'
, 'Header' AS 'Class'
, 5 AS 'Weighting'
, NULL AS 'OrderBy1'
, NULL AS 'OrderBy2'
, NULL AS 'OrderBy3'

UNION ALL
SELECT
0 AS ID
, 'FLUIDS AND ELECTROLYTES' AS 'Text'
, '' AS 'Date'
, '' AS 'Status'
, 'Header' AS 'Class'
, 7 AS 'Weighting'
, NULL AS 'OrderBy1'
, NULL AS 'OrderBy2'
, NULL AS 'OrderBy3'

UNION ALL
SELECT
0 AS ID
, 'BLOOD PRODUCTS' AS 'Text'
, '' AS 'Date'
, '' AS 'Status'
, 'Header' AS 'Class'
, 9 AS 'Weighting'
, NULL AS 'OrderBy1'
, NULL AS 'OrderBy2'
, NULL AS 'OrderBy3'

UNION ALL
SELECT
0 AS ID
, 'ENTERAL' AS 'Text'
, '' AS 'Date'
, '' AS 'Status'
, 'Header' AS 'Class'
, 11 AS 'Weighting'
, NULL AS 'OrderBy1'
, NULL AS 'OrderBy2'
, NULL AS 'OrderBy3'

UNION ALL
SELECT
0 AS ID
, 'MEDICATION FROM OTHER EPISODES YET TO BE RECONCILED' AS 'Text'
, '' AS 'Date'
, '' AS 'Status'
, 'Header' AS 'Class'
, 13 AS 'Weighting'
, NULL AS 'OrderBy1'
, NULL AS 'OrderBy2'
, NULL AS 'OrderBy3'


) InnerResults
WHERE Weighting <> '-1' -- Remove Weighting of ""-1""
) Results
WHERE
Results.RowNumber BETWEEN @FirstRow AND @LastRow
ORDER BY
Results.RowNumber




