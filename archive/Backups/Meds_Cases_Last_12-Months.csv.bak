"CS1786025","Tameside and Glossop Integrated Care NHS Foundation Trust","4 - Low","21/05/2026 08:14:30","Closed","Location of stock on wards","03/06/2026 05:58:41","system","Acute Care Medicines Management Level 1 Team","Swati Dongare","28/05/2026 13:54:33 - Swati Dongare (Work notes)
declare @month varchar(15)='202605'
declare @ward varchar(15)='136'
SELECT
		rTranslog.NSVCode
	,	CASE WHEN rProduct.StoresDescription = '' THEN REPLACE(rProduct.LabelDescription, '!', ' ') ELSE REPLACE(rProduct.StoresDescription, '!', ' ') END AS [Product_Description]
	,	SUM(CONVERT(MONEY,rTranslog.Cost/100)) AS [Gross_Cost_£]
	,	SUM(CONVERT(MONEY,rTranslog.CostExTax/100)) AS [Net_Cost_£]
	,	SUM(CONVERT(MONEY,rTranslog.TaxCost/100)) AS [Tax_Cost_£]
	
	--,	CASE rTranslog.LabelType 
	--		WHEN 'C' THEN 'CIVAS'
	--		WHEN 'D' THEN 'Discharge'
	--		WHEN 'I' THEN 'Inpatient'
	--		WHEN 'O' THEN 'Outpatient'
	--		WHEN 'L' THEN 'Leave'
	--		WHEN 'S' THEN CASE WHEN Kind = 'S' THEN 'Stock' ELSE 'Self-Med' END 
	--		WHEN 'P' THEN 'Picking Ticket'
	--		WHEN 'T' THEN 'PN'
	--		WHEN 'M' THEN 'Manufactured'
	--		WHEN 'W' THEN 'Ward-Stock'
	--	ELSE rTranslog.LabelType END AS LabelTypeExp
FROM
  rTranslog
  INNER JOIN rProduct
    ON rTranslog.NSVCode = rProduct.NSVCode
  INNER JOIN rSupplier
    ON rTranslog.Ward = rSupplier.Supplier AND rTranslog.[Site] = rSupplier.[Site]
WHERE rTranslog.[Month] IN (@Month)
AND rTranslog.Ward = @Ward
GROUP BY
		rTranslog.NSVCode
	,	CASE WHEN rProduct.StoresDescription = '' THEN REPLACE(rProduct.LabelDescription, '!', ' ') ELSE REPLACE(rProduct.StoresDescription, '!', ' ') END
	--,	CASE rTranslog.LabelType 
	--		WHEN 'C' THEN 'CIVAS'
	--		WHEN 'D' THEN 'Discharge'
	--		WHEN 'I' THEN 'Inpatient'
	--		WHEN 'O' THEN 'Outpatient'
	--		WHEN 'L' THEN 'Leave'
	--		WHEN 'S' THEN CASE WHEN Kind = 'S' THEN 'Stock' ELSE 'Self-Med' END 
	--		WHEN 'P' THEN 'Picking Ticket'
	--		WHEN 'T' THEN 'PN'
	--		WHEN 'M' THEN 'Manufactured'
	--		WHEN 'W' THEN 'Ward-Stock'
	--	ELSE rTranslog.LabelType END

