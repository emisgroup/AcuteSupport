08/10/2025 10:49:09 - Swati Dongare (Work notes)
USE [EHSC_HAP_LIVE]
GO

/****** Object:  StoredProcedure [icwsys].[pMonitorTidyMessages]    Script Date: 08/10/2025 10:48:52 ******/
SET ANSI_NULLS ON
GO

SET QUOTED_IDENTIFIER ON
GO


CREATE PROCEDURE [icwsys].[pMonitorTidyMessages]
(
		@CurrentSessionID		INT
	,	@InterfaceComponentID	INT
	,	@StepID					INT
)
AS
BEGIN
	DECLARE @error			int
	DECLARE @now			datetime
	DECLARE @numofdays		int
	DECLARE @instance		varchar (50)
	DECLARE @temp			table ( MessageGuid uniqueidentifier )
	DECLARE @MessageItems	table ( MessageGuid uniqueidentifier primary key )
	DECLARE @MessageIDs		table ( MessageID int primary key )

	SET NOCOUNT ON 
	
	SET @now = GETDATE()
	SET @error = 0

	SELECT	@instance = InstanceName
	FROM	InterfaceComponent
	WHERE	InterfaceComponentID = @InterfaceComponentID

	SELECT	@numofdays = CAST(Value AS int)
	FROM	Setting
	WHERE	[System] = 'MonitorComponent'
	  AND	Section = @Instance
	  AND	[Key] = 'MessageRetentionPeriod'

	SET @numofdays = 0 - @numofdays

	INSERT		@temp
	SELECT		TOP 1000 MessageGuid
	FROM		MessageStatus
	WHERE		[Timestamp] <= DATEADD(dd, @numofdays, @now)
	ORDER BY	MessageStatusID 

	INSERT		@MessageItems
	SELECT		DISTINCT MessageGuid
	FROM		@temp

	DECLARE @numtodelete INT
	SELECT @numtodelete = COUNT(*) FROM @MessageItems
	
	Print 'Deleting ' + cast(ISNULL(@numtodelete, '0') as varchar) + ' messages...'
	
	INSERT		@MessageIDs
	SELECT		DISTINCT MessageID
	FROM		@MessageItems mi
	JOIN		Message m on mi.MessageGuid = m.MessageGuid
	
	IF ((@@ERROR <> 0) AND (@error = 0))
		SET @error = @@ERROR

	Print 'Deleting from MessageReply - SourceMsgGuid...'

	DELETE	MessageReply
	FROM	MessageReply
	  JOIN	@MessageItems Items ON MessageReply.SourceMsgGuid = Items.MessageGuid

	IF ((@@ERROR <> 0) AND (@error = 0))
		SET @error = @@ERROR

	Print 'Deleting from MessageReply - ReplyMsgGuid...'

	DELETE	MessageReply
	FROM	MessageReply
	  JOIN	@MessageItems Items2 ON MessageReply.ReplyMsgGuid = Items2.MessageGuid

	IF ((@@ERROR <> 0) AND (@error = 0))
		SET @error = @@ERROR

	Print 'Deleting from MessageTransform - SourceMsgGuid...'
	
	DELETE	MessageTransform
	FROM	MessageTransform
	  JOIN	@MessageItems Items ON MessageTransform.SourceMsgGuid = Items.MessageGuid

	IF ((@@ERROR <> 0) AND (@error = 0))
		SET @error = @@ERROR

	Print 'Deleting from MessageTransform - TransformMsgGuid...'
	
	DELETE	MessageTransform
	FROM	MessageTransform
	  JOIN	@MessageItems Items2 ON MessageTransform.TransformMsgGuid = Items2.MessageGuid

	IF ((@@ERROR <> 0) AND (@error = 0))
		SET @error = @@ERROR

	IF EXISTS(SELECT * FROM sysobjects WHERE [name] = 'MessageUpdated')
	BEGIN
		Print 'Deleting from MessageUpdated...'

		DELETE	MessageUpdated
		FROM	MessageUpdated
		  JOIN	@MessageItems Items ON MessageUpdated.MessageGuid = Items.MessageGuid

		IF ((@@ERROR <> 0) AND (@error = 0))
			SET @error = @@ERROR
	END
	
	IF EXISTS(SELECT * FROM sysobjects WHERE [name] = 'MessageAlias')
	BEGIN
		Print 'Deleting from MessageAlias...'

		DELETE	MessageAlias
		FROM	MessageAlias
		  JOIN	@MessageIDs Items ON MessageAlias.MessageID = Items.MessageID

		IF ((@@ERROR <> 0) AND (@error = 0))
			SET @error = @@ERROR	
	END
	
	IF EXISTS(SELECT * FROM sysobjects WHERE [name] = 'eDischargeMessageLinkMessage')
	BEGIN
		Print 'Deleting from eDischargeMessageLinkMessage...'

		DELETE	eDischargeMessageLinkMessage
		FROM	eDischargeMessageLinkMessage
		  JOIN	@MessageIDs Items ON eDischargeMessageLinkMessage.MessageID = Items.MessageID

		IF ((@@ERROR <> 0) AND (@error = 0))
			SET @error = @@ERROR		
	END 
	
	BEGIN TRANSACTION

	Print 'Deleting from MessageStatus...'

	DELETE	MessageStatus
	FROM	MessageStatus
	  JOIN	@MessageItems Items ON MessageStatus.MessageGuid = Items.MessageGuid

	IF ((@@ERROR <> 0) AND (@error = 0))
		SET @error = @@ERROR

	Print 'Deleting from Message...'
	
	DELETE	[Message]
	FROM	[Message]
	  JOIN	@MessageItems Items ON [Message].MessageGuid = Items.MessageGuid

	IF ((@@ERROR <> 0) AND (@error = 0))
		SET @error = @@ERROR

	IF (@error = 0)
		COMMIT TRANSACTION
	ELSE
		ROLLBACK TRANSACTION

	SET NOCOUNT OFF
	
	IF (@error <> 0)
	BEGIN
		SET NOCOUNT ON

		SELECT '<root>'

		SELECT	*
		FROM	InterfaceInstance
		  JOIN	InterfaceComponent ON InterfaceInstance.InterfaceInstanceID = InterfaceComponent.InterfaceInstanceID
		WHERE	InterfaceComponent.InterfaceComponentID = @InterfaceComponentID
		FOR XML AUTO

		SELECT	*
		FROM	MonitorStep
		  JOIN	MonitorJob ON MonitorStep.MonitorJobID = MonitorJob.MonitorJobID
		WHERE	MonitorStep.MonitorStepID = @StepID
		FOR XML AUTO

		SELECT	'<Error Number=""' + 
				CAST(@error AS VARCHAR) + 
				'"" Description=""'

		SELECT [description] FROM [master].[dbo].[sysmessages] WHERE error = @error
		
		SELECT '""/></root>'

		SET NOCOUNT OFF
	END
END

GO

