Analysis scripts:

/* Locations In Use */
select loc_name, loc_id, loc_active, loc_MaxPatCategory, atd_num, 'Current Attendance' AtdType
,atd_created, atd_dischcreated
from Current_Attendance
join Attendance_Details on cat_atdid = atd_id
join CFG_Locations on cat_currentlocid = loc_id
where cat_currentlocid in (select loc_id from cfg_locations where loc_id <> 31)
and cat_sdid = 0 and cat_currentlocid <> 0
 union
select loc_name, loc_id, loc_active, loc_MaxPatCategory, atd_num, 'Clinic' AtdType
,atd_created, atd_dischcreated
from Clinic_Appointments
join Attendance_Details on cla_atdid = atd_id
join CFG_Locations on cla_currentlocationid = loc_id
where cla_currentlocationid in (select loc_id from cfg_locations where loc_id <> 31)
and cla_currentlocationid <> 0
order by loc_name

