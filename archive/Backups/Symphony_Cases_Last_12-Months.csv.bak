exec pInterfaceEngineQueueCountByInterfaceInstance 1,1 

SELECT top 1000 ms.messagestatusid
   , I.name
   , M.text
   , S.description
   , ms.timestamp
   , M.messageguid
   , M.messageid 
   , rip.value AS RemoteIP
   , prt.value AS PortNumber
FROM icwsys.messagestatus AS ms
   INNER JOIN icwsys.message AS m ON m.messageguid = ms.messageguid
   INNER JOIN icwsys.interfacecomponent AS i ON i.interfacecomponentid = ms.interfacecomponentid
   INNER JOIN icwsys.status AS s ON s.statusid = ms.statusid
   LEFT OUTER JOIN icwsys.setting AS rip ON rip.section = i.InstanceName AND rip.[key] = 'RemoteIPAddress'
   LEFT OUTER JOIN icwsys.setting AS prt ON prt.section = i.InstanceName AND prt.[key] IN ('LocalIpPort', 'RemoteIPPort')
WHERE 
   ms.Timestamp > DATEADD(DAY, -1, GETDATE())
ORDER BY 
   ms.messagestatusid DESC

