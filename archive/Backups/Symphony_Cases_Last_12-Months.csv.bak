--Please provide an audit showing all users that have accessed patient record
--DIS0720087 in Symphony between 01/04/2026 and 31/05/2026

----Info - amend 

/*
Audit createdby and LAST updatedby PER PATIENT for dates
*/

declare @hospitalno varchar(20), @pid int, @startdate datetime, @enddate datetime
set @hospitalno = 'DIS0720087' --UPDATE HERE
set @pid = (select psi_pid from patient_system_ids
where psi_system_id = @hospitalno
and psi_system_name in (select syp_value from SystemProperties where syp_type = 'gods number'))
set @startdate = '20260401' --UPDATE HERE
set @enddate = '20260531' --UPDATE HERE

select @hospitalno HospNo, @pid PID, @startdate StartDate, @enddate EndDate

select atd_num Attendances from Attendance_Details join Episodes on epd_id = atd_epdid where epd_pid = @pid

select ea.*, stf_logonid from EViewAudit ea ---eView Audit
join staff on ea_UserID = stf_staffid
where ea_PatientID = @pid and ea_Date between @startdate and @enddate

select atd_num, dep_caption, atd_created created, stcre.stf_logonid CreatedBy, atd_update updated, stupd.stf_logonid UpdatedBy from Attendance_Details ---ATDs createdby and updatedby
join Episodes on epd_id = atd_epdid
join CFG_DEProcedures on atd_depid = dep_id
join staff stcre on atd_createdby = stcre.stf_staffid
join staff stupd on atd_updatedby = stupd.stf_staffid
where epd_pid = @pid
and (atd_created between @startdate and @enddate or atd_update between @startdate and @enddate)
union
select atd_num, dep_caption, res_created, stcre.stf_logonid, res_updated, stupd.stf_logonid from Result_details
join Attendance_Details on res_atdid = atd_id
join Episodes on epd_id = atd_epdid
join CFG_DEProcedures on res_depid = dep_id
join staff stcre on res_createdby = stcre.stf_staffid
join staff stupd on res_updatedby = stupd.stf_staffid
where epd_pid = @pid
and (res_created between @startdate and @enddate or res_updated between @startdate and @enddate)
union
select atd_num, dep_caption, req_created, stcre.stf_logonid, req_update, stupd.stf_logonid from Request_Details
join Attendance_Details on req_atdid = atd_id
join Episodes on epd_id = atd_epdid
join CFG_DEProcedures on req_depid = dep_id
join staff stcre on req_createdby = stcre.stf_staffid
join staff stupd on req_updatedby = stupd.stf_staffid
where epd_pid = @pid
and (req_created between @startdate and @enddate or req_update between @startdate and @enddate)
union
select atd_num, dep_caption, tri_created, stcre.stf_logonid, tri_update, stupd.stf_logonid from Triage
join Attendance_Details on tri_atdid = atd_id
join Episodes on epd_id = atd_epdid
join CFG_DEProcedures on tri_depid = dep_id
join staff stcre on tri_createdby = stcre.stf_staffid
join staff stupd on tri_updatedby = stupd.stf_staffid
where epd_pid = @pid
and (tri_created between @startdate and @enddate or tri_update between @startdate and @enddate)
--union
--select * from enotes
--select atd_num, dep_caption, nts_created, nts_update from eNotes
--join Attendance_Details on nts_atdid = atd_id
--join CFG_DEProcedures on nts_depid = dep_id
--where (nts_createdby = @staffid or nts_updatedby = @staffid)
--and (nts_created between @startdate and @enddate or nts_update between @startdate and @enddate)
--union
--select mid_number, 'Midas', mid_created, mid_update from MIDAS
--where (mid_createdby = @staffid or mid_updatedby = @staffid)
--and (mid_created between @startdate and @enddate or mid_update between @startdate and @enddate)
union
select atd_num, dep_caption, nts_created, stcre.stf_logonid, nts_update, stupd.stf_logonid from eNotes
join Attendance_Details on nts_atdid = atd_id
join Episodes on epd_id = atd_epdid
join CFG_DEProcedures on nts_depid = dep_id
join staff stcre on nts_createdby = stcre.stf_staffid
join staff stupd on nts_updatedby = stupd.stf_staffid
where epd_pid = @pid
and (nts_created between @startdate and @enddate or nts_update between @startdate and @enddate)
order by updated


