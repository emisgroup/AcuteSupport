select epi_uploaddate
,stf_logonid,stf_surname,stf_forename
,epi_update,epi_imagepath,epi_displayname,epi_parentid
,pat_pid,pat_forename,pat_surname
--,atd_id
, hospnum.psi_system_id hospitalnumber
, nhsnum.psi_system_id nhsnumber  from epics
join staff on epi_createdby = stf_staffid
left outer join Patient on epi_parentid = pat_pid
left outer join Patient_system_ids as hospnum on pat_pid = hospnum.psi_pid and hospnum.psi_system_name = 5548
left outer join Patient_system_ids as nhsnum on pat_pid = nhsnum.psi_pid and nhsnum.psi_system_name = 1583
where epi_imagepath like '%\\cymru.nhs.uk\bcu\ED\Epics\Live\e-DOCs0001\0038%'
and epi_deleted <> 1
and epi_parentno = 1

Union all

select epi_uploaddate
,stf_logonid,stf_surname,stf_forename
,epi_update,epi_imagepath,epi_displayname,epi_parentid
,pat_pid,pat_forename,pat_surname
, hospnum.psi_system_id hospitalnumber
, nhsnum.psi_system_id nhsnumber
,atd_num
from epics
join staff on epi_createdby = stf_staffid
join Attendance_Details on epi_parentid = atd_id
join episodes on atd_epdid = epd_id
left outer join Patient on epd_pid = pat_pid
left outer join Patient_system_ids as hospnum on pat_pid = hospnum.psi_pid and hospnum.psi_system_name = 5548
left outer join Patient_system_ids as nhsnum on pat_pid = nhsnum.psi_pid and nhsnum.psi_system_name = 1583
where epi_imagepath like '%\\cymru.nhs.uk\bcu\ED\Epics\Live\e-DOCs0001\0038%'
and epi_deleted <> 1
and epi_parentno = 2

