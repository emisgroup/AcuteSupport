Based on the standard patient audit:
/*
Audit createdby and LAST updatedby PER PATIENT for dates
*/
 
declare @startdate datetime, @enddate datetime
declare @attendance varchar(20), @episode varchar(20)
--set @attendance = 'JCUH-25-055016-1'
--set @episode = 'JCUH-25-055016'
set @attendance = 'JCUH-25-054781-1'
set @episode = 'JCUH-25-054781'
set @startdate = '20250808' --UPDATE HERE
set @enddate = '20250812' --UPDATE HERE
 
select
	ea_id as id,
	ea_PatientID as patientID,
	ea_AttendanceNo as AttendanceNo,
	convert(varchar, ea_date, 13) as Date,
	ea_Workstation as Workstation,
	stf_logonid as userID
from EViewAudit ea
join staff on ea_UserID = stf_staffid
where ea_AttendanceNo = @attendance and ea_Date between @startdate and @enddate
 
select atd_num, dep_caption, convert(varchar, atd_created, 13) created, stcre.stf_logonid CreatedBy, convert(varchar, atd_update, 13) updated, stupd.stf_logonid UpdatedBy from Attendance_Details
join Episodes on epd_id = atd_epdid
join CFG_DEProcedures on atd_depid = dep_id
join staff stcre on atd_createdby = stcre.stf_staffid
join staff stupd on atd_updatedby = stupd.stf_staffid
where epd_num = @episode

union
select atd_num, dep_caption, convert(varchar, atd_created, 13) created, stcre.stf_logonid CreatedBy, convert(varchar, atd_update, 13) updated, stupd.stf_logonid UpdatedBy from Aud_Attendance_Details
join Episodes on epd_id = atd_epdid
join CFG_DEProcedures on atd_depid = dep_id
join staff stcre on atd_createdby = stcre.stf_staffid
join staff stupd on atd_updatedby = stupd.stf_staffid
where epd_num = @episode

