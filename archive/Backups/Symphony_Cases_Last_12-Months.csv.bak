                         Aud_DAD_Failed_Messages.fam_atdid, Aud_DAD_Failed_Messages.fam_status, Aud_DAD_Failed_Messages.fam_reason, Aud_DAD_Failed_Messages.fam_deptid, Aud_DAD_Failed_Messages.fam_LocMsgLocID, 
