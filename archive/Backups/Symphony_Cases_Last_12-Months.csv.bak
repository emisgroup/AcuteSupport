Additional analysis scripts:

select del_serviceid, del_date, del_event, * from dad_eventlogs where del_date > '20251226' and del_event like '%ED-25-084418%' order by del_id

SELECT        DAD_Services.ser_name, DAD_Msg_Definition.mdf_name, DAD_EventLogs.del_date, DAD_EventLogs.del_event, DAD_EventLogs.del_serviceID, DAD_EventLogs.del_ID, DAD_EventLogs.del_serviceID AS Expr1, 
                         DAD_EventLogs.del_msgdefID, DAD_EventLogs.del_machine, DAD_EventLogs.del_date AS Expr2, DAD_EventLogs.del_type, DAD_EventLogs.del_event AS Expr3, DAD_EventLogs.del_serviceuser, DAD_EventLogs.del_deleted, 
                         DAD_EventLogs.del_created, DAD_EventLogs.del_updated, DAD_EventLogs.del_updatedby, DAD_EventLogs.del_emailed, DAD_EventLogs.del_createdby
FROM            DAD_EventLogs INNER JOIN
                         DAD_Services ON DAD_EventLogs.del_serviceID = DAD_Services.ser_id INNER JOIN
                         DAD_Msg_Definition ON DAD_EventLogs.del_msgdefID = DAD_Msg_Definition.mdf_id
WHERE        (DAD_EventLogs.del_date > '20251226') AND (DAD_EventLogs.del_event LIKE '%ED-25-084418%')
ORDER BY DAD_EventLogs.del_ID

select * from dad_eventlogs where del_serviceid = 13 and del_id between 47200257 and 47200287 order by del_id

