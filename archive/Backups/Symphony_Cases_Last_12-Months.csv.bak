                         Aud_Patient_Indicators.pin_pid
FROM            Patient_system_ids INNER JOIN
                         Aud_Patient_Indicators ON Patient_system_ids.psi_pid = Aud_Patient_Indicators.pin_pid INNER JOIN
                         Staff ON Aud_Patient_Indicators.pin_updatedby = Staff.stf_staffid INNER JOIN
                         Lookups ON Aud_Patient_Indicators.pin_indicator = Lookups.Lkp_ID
WHERE        (Aud_Patient_Indicators.pin_updatedby = 5566) AND (Aud_Patient_Indicators.pin_indicator = 15795) AND (Patient_system_ids.psi_system_name = 9585)
ORDER BY Aud_Patient_Indicators.pin_update

