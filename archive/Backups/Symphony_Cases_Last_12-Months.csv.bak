27/02/2026 16:12:36 - Carlos Berrios (Work notes)
top 1000 current locations not in top 5000 data sent
on attendance number and location mapping.

select * from
	(select top 1000
	atd_num, not_text, cul_created
	from Attendance_Details
	join Current_Locations cul on cul_atdid = atd_id
	join CFG_Locations on cul_locationid = loc_id
	join LookupMappings on loc_id = flm_lkpid and flm_mtid = 4 and flm_MappedType = 1
	join Notes on flm_value = not_noteid
	order by cul_culid desc) cullist
LEFT OUTER JOIN
	(select msgref
	,ROW_NUMBER() over (partition by msgref, SUBSTRING(del_event, locmapstart, locmapend-locmapstart) order by del_date) rn
	,SUBSTRING(del_event, locmapstart, locmapend-locmapstart) locationmap
	,SUBSTRING(del_event, locmapend+2, locnameend-locmapend-2) locationname
	,del_date, del_event
	FROM (SELECT TOP 5000 
		REPLACE(SUBSTRING(del_event,CHARINDEX('|||||||||||||||1|',del_event)+17,16),'|','') msgref
		,CHARINDEX('PV1||E|', del_event)+7 locmapstart
		,CHARINDEX('^', del_event, CHARINDEX('PV1||E|', del_event)) locmapend
		,CHARINDEX('^^', del_event, CHARINDEX('^^', del_event, CHARINDEX('PV1||E|', del_event))+2) locnameend
		,* FROM DAD_eventlogs
		WHERE del_serviceID = 31 and del_event like '%Data Sent%'
		ORDER BY del_id DESC) top10ksent
	) sentlist on atd_num = msgref and not_text = locationmap and rn = 1
where locationmap is NULL

