below script was run to find the rows with empty spaces in Temp (res_field12).

SELECT 
		res_resid
		, res_atdid
		, res_date
		, DATEPART(YEAR, res_date)
		, 0					-- news_offset
		, res_field8		-- Resps Field
		, res_field3		-- scale lkp_id
		, sc.lkp_name					-- scale lkp_name
		, res_field2		-- air or o2 lkp_id
		, ao.Lkp_Name		-- air or o2 lkp_name
		, res_field7		-- spo2 value
		, res_field9		-- bp sys value
		, res_field11		-- pulse value
		, res_field1		-- avpu lkp_id
		, avpu.lkp_name			-- avpu lkp_name
		--, res_field12		-- temp value
		,REPLACE(REPLACE(res_field12, ',', '.'), '..', '.')    ---temp value

		, ROW_NUMBER() OVER (PARTITION BY res_atdid ORDER BY res_resid ASC)
	FROM 
		dbo.result_details 
		LEFT OUTER JOIN dbo.Lookups AS ao ON res_field2 = ao.lkp_id
		LEFT OUTER JOIN dbo.Lookups AS sc ON res_field3 = sc.lkp_id
		LEFT OUTER JOIN dbo.Lookups AS avpu ON res_field1 = avpu.lkp_id
	WHERE 
		res_depid = 211
		AND res_atdid IN (SELECT atd_id FROM dbo.ECDS_Attendances)
		AND res_inactive = 0
		AND isnumeric (res_field12)=0

