"CS1634535","South Tees Hospitals NHS Foundation Trust","4 - Low","15/08/2025 15:20:44","Closed","User accounts","18/08/2025 14:47:16","system","Acute Care Symphony Support Level 1","Gareth Evans","18/08/2025 12:11:17 - Gareth Evans (Work notes)
Based on the Get Active Staff script from the repository, with an extra line to include last login date:

------------------------------------------------------------------------------------------------------------------------------------
-- Get Active Staff
-- List all staff within Symphony
--
-- V1.0 - L.Booth - 07/02/2018 - First draft
-- V2.0 - L.Booth - 11/01/2019 - Added option to include Suspended accounts
-- V2.5 - L.Booth - 11/01/2019 - Added option to include Groups staff is a member of.
------------------------------------------------------------------------------------------------------------------------------------

DECLARE @bIncludeSuspended BIT, @bIncludeGroups BIT, @vSQL varchar(4096)

SET @bIncludeSuspended  = 1 -- 0 = False, 1 = True
SET @bIncludeGroups = 1 -- 0 = False, 1 = True

SET @vSQL = 'select s.stf_forename+'' ''+s.stf_surname [Staff Name]'
SET @vSQL = @vSQL + ' , s.stf_logonid [Logon]'
SET @vSQL = @vSQL + ' , convert(varchar(10),s.stf_startdate,103) [Started]'
SET @vSQL = @vSQL + ' , convert(varchar(10),s.stf_LastSuccessLoginDtime,103) [Last login]'
IF @bIncludeSuspended = 1 SET @vSQL = @vSQL + ' ,CASE WHEN s.stf_suspended = 0 THEN ''No'' ELSE ''YES'' END [Suspended?]'
IF @bIncludeGroups = 1
    BEGIN
        SET @vSQL = @vSQL + ' , stuff(('
        SET @vSQL = @vSQL + 'select ''; '' + grp_grpname + '' ('' + dpt_name +'')'' from StaffGroup g'
        SET @vSQL = @vSQL + ' join groups on grp_grpid = g.sg_grpid'
        SET @vSQL = @vSQL + ' join cfg_dept on dpt_id = grp_deptid'
        SET @vSQL = @vSQL + ' where s.stf_staffid = g.sg_staffid'
        SET @vSQL = @vSQL + ' order by g.sg_grpid'
        SET @vSQL = @vSQL + ' for xml path('''')), 1, 1, '''')  [Member Of Group(s)]'
    END
SET @vSQL = @vSQL + ' from staff s'
SET @vSQL = @vSQL + ' where stf_enddate > getdate()'
SET @vSQL = @vSQL + ' and stf_midnames <> ''systemusers'' '
SET @vSQL = @vSQL + ' and stf_staffid>0'
IF @bIncludeSuspended = 0 SET @vSQL = @vSQL + ' and stf_suspended=0' 
SET @vSQL = @vSQL + ' order by stf_surname'

EXECUTE(@vSQL)

