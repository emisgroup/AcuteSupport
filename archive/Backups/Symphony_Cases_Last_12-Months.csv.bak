DATEDIFF (""YYYY"",{Patient.pat_dob},{Attendance_Details.atd_arrivaldate}) else 

if DatePart (""m"", {Attendance_Details.atd_arrivaldate}) > DatePart (""m"",{Patient.pat_dob}) and 
DatePart (""d"", {Attendance_Details.atd_arrivaldate}) = DatePart (""d"",{Patient.pat_dob}) then 
