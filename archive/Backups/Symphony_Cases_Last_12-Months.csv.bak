--Referral messages
SELECT * FROM (
SELECT del_machine, req_atdid, req_created, atd_num, msgref, msgcreated
,datediff(minute,req_created,msgcreated) as msgdelay
FROM Request_Details
JOIN Attendance_Details on req_atdid = atd_id
LEFT OUTER JOIN
(select ROW_NUMBER() OVER (PARTITION BY msgref ORDER BY del_id) as rn, *
from (select top 1000 del_id, del_machine, del_date msgcreated
,SUBSTRING(del_event,CHARINDEX('|||||ED-25-',del_event)+5,14) msgref
,del_event
from DAD_EventLogs
where del_serviceID = 25 and del_event like '%Data Sent%'
order by del_id desc
) DADEvnTop --order by del_id desc
) FirstMsgList ON msgref = atd_num and rn = 1
WHERE req_created between GETDATE()-20 and DATEADD(minute, -30, GETDATE())
and req_depid = 33
) FullMsgList
WHERE msgdelay not in (-1,0,1) or msgdelay is null
--and req_atdid = '801109'
ORDER BY req_created DESC

