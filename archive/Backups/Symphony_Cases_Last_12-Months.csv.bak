select * from Lookups
where lkp_id = 9923
-- and that's latex, which is what we want

select * from Lookups
where Lkp_ParentID = 7673

select * from Lookups
where lkp_name like '%allerg%'

select * from Episodes
where epd_num = ''
-- 2277283 is a better example — allergies is Other, and there's text in 'Specify Allergies'

select * from Patient_details
where pdt_pid = 2277283

select * from Patient_Details_ExtraFields
where pdt_EF_pdtpid = 2277283
-- nah, not there

select top 10 * from Patient_Details_ExtraFields_View
where pdt_EF_extrafieldID in (3495588,
3495589,
3495590,
4933085,
5186458,
4933027)


select * from Patient_Details_ExtraFields_View
where pdt_EF_extrafieldID = 4933027

select * from Patient_Details_ExtraFields
where pdt_EF_extrafieldID = 4933027

-- reading the definition of the view, and the function that creates the field in question suggests:
select * from Notes
where not_noteid = 12349436
-- Bingo!

select * from notes
where not_text like '%Penicillamine%'
or not_text like '%Penicilamine%'

select * from notes
where not_text like '%Pen%'
and not_text like '%mine%'


select * from Allergies_view
where Allergy1 = 'other'
and Allergy2 is not null

select * from Patient_system_ids
where psi_pid = 1850130

select * from Lookups
where Lkp_ParentID = 7673
--7704 is other

