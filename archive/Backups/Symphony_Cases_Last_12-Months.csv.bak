SELECT        PatDetailsAudit.pda_Date, Patient_system_ids.psi_system_id, PatDetailsAudit.pda_Workstation, Staff.stf_logonid
FROM            PatDetailsAudit INNER JOIN
                         Patient_system_ids ON PatDetailsAudit.pda_PatientID = Patient_system_ids.psi_pid INNER JOIN
