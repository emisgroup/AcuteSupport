Standard scripts run followd by:

select lkp_name, gp_code, gp_surname
,pr_praccode, add_line1+' '+add_line2 [Address], add_postcode
,gpa.* from GPPracticeAddressLink gpa
join gp on gpa_gpid = gp_id
join Gp_Practise on gpa_prid = pr_id
join Address on gpa_praddid = add_addid
join lookups on gpa_status = Lkp_ID
where pr_praccode in ('V81997','V81998','V81999')

SELECT * FROM GP WHERE GP_CODE IN ('G9999981','G9999998','A9999998','G0','P9999981')

select lkp_name, gp_code, gp_surname
,pr_praccode, add_line1+' '+add_line2 [Address], add_postcode
,gpa.* from GPPracticeAddressLink gpa
join gp on gpa_gpid = gp_id
join Gp_Practise on gpa_prid = pr_id
join Address on gpa_praddid = add_addid
join lookups on gpa_status = Lkp_ID
where pr_praccode in ('V81997','V81998','V81999') AND GP_ID IN (39319,39141,39315,39320,39318) and pr_id in (11250,22862,11246)

select * from gp_practise where pr_praccode in ('V81997','V81998','V81999')

SELECT        GPPracticeAddressLink.gpa_gpid, GPPracticeAddressLink.gpa_prid, GPPracticeAddressLink.gpa_praddid, GPPracticeAddressLink.gpa_localcode, GPPracticeAddressLink.gpa_telid, GPPracticeAddressLink.gpa_status, 
                         GPPracticeAddressLink.gpa_GUID, Lookups.Lkp_Name
FROM            GPPracticeAddressLink INNER JOIN
                         Lookups ON GPPracticeAddressLink.gpa_status = Lookups.Lkp_ID

						 select * from lookups where lkp_id in (3345,3346,2661,5813)

						 select * from lookups where lkp_parentid = 2659

						 select * from  GPPracticeAddressLink where gpa_gpid in (39318,39320) and gpa_praddid in (4078843,4078847)

						 begin tran
						 update GPPracticeAddressLink
						 set gpa_status = 2661
						 where gpa_gpid in (39318,39320) and gpa_praddid in (4078843,4078847)

						 commit

						 rollback

