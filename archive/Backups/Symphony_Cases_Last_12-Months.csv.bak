"CS1729748","Western Health and Social Care Trust","4 - Low","05/02/2026 09:33:34","Closed","Report on department numbers","23/02/2026 12:02:17","system","Acute Care Symphony Support Level 1","Shazad Ishaque","13/02/2026 13:41:20 - Shazad Ishaque (Work notes)
declare @snapshottime datetime---all in dept before that time but all have a left dept vafter the time or not one recorded at all
set @snapshottime = '20250227 17:15'
 
select atd_num, atd_created, cul_locationdate leftdepttime, cul_created leftdeptrecorded
	,DATEDIFF(minute,atd_created, cul_locationdate) timeindeptmins
from Attendance_Details
join Episodes on epd_id = atd_epdid
left outer join Current_Locations on cul_atdid = atd_id and cul_locationid = 31 and cul_deleted = 0
where atd_created < @snapshottime
and (cul_locationdate > @snapshottime or cul_locationdate is null)
and epd_deptid = 1
and atd_deleted = 0
and atd_attendancetype = 0
order by atd_created desc




declare @snapshottime datetime---all atds that are in dept during but were disharged after the time or dont have a discharge
set @snapshottime = '20250227 17:15'
 
select atd_num, atd_created, atd_dischdate dischargedate,  atd_dischcreated dischargerecorded
	,DATEDIFF(minute,atd_created, atd_dischdate) timeindeptmins
from Attendance_Details
join Episodes on epd_id = atd_epdid
where atd_created < @snapshottime
and (atd_dischdate > @snapshottime or atd_dischcreated is null)
and epd_deptid = 1
and atd_deleted = 0
and atd_attendancetype = 0--138
order by atd_created desc

