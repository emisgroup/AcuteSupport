26/01/2026 14:57:20 - Sheree Chadwick (Work notes)
THERE IS SCHEDULED JOB SET UP AS BELOW - this only does records only than 2 month thogh

This is an EMIS made SQL job to remove orphaned service department attendances for the ""Bed Manager"" Department, these are caused when the DTA or Ready to Admit DEPs are deleted in the e-view instead of being cancelled. It removes orphaned attendances that are over 2 months old.


--remove cat_Details rows first and then remove the current_attendances
 

DELETE from Cat_Details 

WHERE 
	ctd_catid in (
SELECT 
cat_catid
 FROM dbo.Current_Attendance
		
WHERE
	cat_sdid > 0 
and cat_currentlocid = 31	and cat_dischdate ! = '2200-01-01 00:00:00.000'
	
AND cat_atdid IN (SELECT req_atdid FROM dbo.request_Details 
WHERE req_depid in (41,148) AND req_inactive = 1) -- ""DTA"" and ""Ready to Admit"" DEP 
AND cat_regdate < DATEADD(MONTH, -2, GETDATE())
)
 


DELETE FROM dbo.Current_Attendance
 WHERE
	 cat_sdid > 0 

and cat_currentlocid = 31 

and cat_dischdate ! = '2200-01-01 00:00:00.000'
 
AND cat_atdid IN (SELECT req_atdid FROM dbo.request_Details
 WHERE req_depid in (41,148) 
AND req_inactive = 1) -- ""DTA"" and ""Ready to Admit"" DEP
	
AND cat_regdate < DATEADD(MONTH, -2, GETDATE())

