-----------------------------------------------
--
-- Patient Unmerge Check Script
-- Checks what the original PID was and 
-- what records were associated with PID
--
-- Author: L.Booth 
-- Version: 1.5 - 12/09/2018 - Created
-- Version: 2.0 - 30/07/2019 - Added NewPAT details and made easier to read
-- Version: 2.5 - 31/07/2019 - Added automatic update to end of script
--
-----------------------------------------------

declare @HospNum INT = 5548 --(select syp_value from SystemProperties where syp_type = 'Gods Number') -- Get the correct main hospital number .
        ,@MinPID INT = 0
        ,@MinPatNum VARCHAR(30) = '5561863' -- Replace Original Minor patient number here.
        ,@MajPID INT = 0
        ,@MajPatNum VARCHAR(30) = 'H436343' -- Replace Major Patient number here.
        ,@NewPID INT = 0
        ,@NewPatNum VARCHAR(30) = '5567712' -- Replace with New Minor Pat number.

-- Get Original Minor PID number 
IF @MinPID=0
    SET @MinPID = (
    SELECT DISTINCT(psi_pid)
    FROM Aud_Patient_System_ids
    WHERE psi_system_id=@MinPatNum and psi_system_name = @HospNum
    )

-- Get Major PID number 
IF @MajPID = 0
    SET @MajPID = (
    SELECT DISTINCT(psi_pid)
    FROM Patient_System_ids
    WHERE psi_system_id=@MajPatNum and psi_system_name = @HospNum
    )
    
-- Get New PID number 
IF @NewPID = 0
	SET @NewPID = (
	SELECT DISTINCT(psi_pid)
    FROM Patient_System_ids
    WHERE psi_system_id=@NewPatNum and psi_system_name = @HospNum
    )
    
-- Check Episodes
DECLARE @MinEPDS TABLE
(
    MinEPD_ID int,
    MinEPD_Num VARCHAR(15),
    MinEPD_CurPID int,
    MinEPD_OldPID int,
    MinEPD_NewPID int
)
INSERT INTO @MinEPDS
SELECT DISTINCT A.epd_id, A.epd_num, C.epd_pid, A.epd_pid, @NewPID
FROM aud_Episodes A
Join Episodes c ON c.epd_id = a.epd_id
WHERE A.epd_pid=@MinPID

-- Check Addresses
DECLARE @MinADDs TABLE
(
    MinAdd_id INT,
    MinAdd_Line1 VARCHAR(255),
    MinAdd_Line2 VARCHAR(255),
    MinAdd_Line3 VARCHAR(255),
    MinAdd_line4 VARCHAR(255),
    MinAdd_line5 VARCHAR(255),
    MinAdd_postcode VARCHAR(255),
    MinAdd_type INT,
    MinAdd_typeName VARCHAR(30),
    MinAdd_CurPID int,
    MinAdd_OldPID int,
    MinAdd_NewPID int
)
INSERT INTO @MinADDs
SELECT DISTINCT a.add_addid,a.add_line1,a.add_line2,a.add_line3,a.add_line4,a.add_line5,a.add_postcode,a.add_type, lkp_name, c.add_linkid, a.add_linkid, @NewPID
FROM Aud_Address A
left JOIN Address C on c.add_addid = a.add_addid
JOIN Lookups on lkp_id = a.add_type
WHERE a.add_linkid=@MinPID
AND a.add_linktype=1

-- Check NOKs
DECLARE @MinNOKs TABLE
(
    MinNOK_ID INT,
    MinNOK_Forename VARCHAR(50),
    MinNOK_Surname VARCHAR(50),
    MinNOK_Relation int,
    MinNOK_CurPID int,
    MinNOK_OldPID int,
    MinNOK_NewPID int
)
INSERT INTO @MinNOKs
SELECT DISTINCT a.nok_nokid, a.nok_forename, a.nok_surname, a.nok_relation, c.nok_pid, a.nok_pid, @NewPID
FROM Aud_NOK A
LEFT JOIN NOK C on c.nok_id = a.nok_nokid
WHERE a.nok_pid=@MinPID

-- Check Patient System IDs
DECLARE @MinPSIs TABLE
(
    MinPSI_id int,
    MinPSI_SysID VARCHAR(50),
    MinPSI_Name int,
    MinPSI_LKP VARCHAR(50),
    MinPSI_CurPID int,
    MinPSI_OldPID int,
    MinPSI_NewPID int
)
INSERT INTO @MinPSIs
SELECT DISTINCT a.psi_id, a.psi_system_id, a.psi_system_name, lkp_name, c.psi_pid, a.psi_pid, @NewPID
FROM Aud_Patient_System_ids a 
JOIN lookups ON lkp_id = psi_system_name
LEFT JOIN Patient_system_ids C on c.psi_id = a.psi_id
WHERE a.psi_pid=@MinPID

SELECT 'Episode' [Table],* FROM @MinEPDS
SELECT 'Address' [Table],* FROM @MinADDs
SELECT 'NOKs' [Table],* FROM @MinNOKs
SELECT 'PSIs' [Table],* FROM @MinPSIs

--------------- DO THE UPDATES -------RUN THE ABOVE FIRST TO ENSURE RESULTS ARE AS EXPECTED--------------
/*
UPDATE Episodes
SET epd_pid=@NewPID
WHERE epd_id IN (SELECT DISTINCT MinEPD_ID FROM @MinEPDS)

UPDATE Patient_system_ids
SET psi_pid = @NewPID
WHERE psi_id IN (SELECT DISTINCT MinPSI_ID FROM @MinPSIs)
*/
-------------- TO DO : Rewrite these to INSERT from Audit ----------------------------
/*
UPDATE Address
SET add_linkid=@NewPID
WHERE add_addid IN (SELECT DISTINCT MinAdd_ID FROM @MinADDs)

UPDATE NOK
SET nok_pid=@NewPID
WHERE nok_id IN (SELECT DISTINCT MinNOK_ID FROM @MinNOKs)
