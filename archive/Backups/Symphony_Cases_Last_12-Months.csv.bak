select dpt_name, count(atd_id) as CountOfAtd from Attendance_Details
inner join episodes on atd_epdid = epd_id
inner join cfg_Dept on epd_deptid = dpt_id 
where epd_created between '20250227 17:15:00.000' and '20250228 17:16:00.000' ----- ADD date
group by dpt_name 
order by CountOfAtd desc




