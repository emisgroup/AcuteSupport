Flag scripts:

select * from cfg_lookupflag order by lkf_created desc

select * from cfg_LkpItemsActivePeriod order by lks_datecreated desc





-- Developer:RN
-- Date: 10012014
-- Reset a flag's active period - Generic
-- V2.0 - LBooth - Allow for multiple flags

SET NOCOUNT ON
declare @FlagID int, @FlagItemID int, @FlagName varchar(100)
declare @date datetime, @counter int, @max int

declare @IDs table( 
	idseed int identity (1,1),
	flagid int)

--IMPORTANT!!
--Specify the Name of the flag here
set @FlagName = 'RAT Clin'
-- End of manual change --

set @date = (select top 1 pat_created from patient order by pat_created asc)

insert into @IDs (flagid)
	select lkf_id
	from CFG_LookupFlag 
	where lkf_name = @FlagName

--select * from @ids

set @max = (select max(idseed) from @IDs)
set @counter = 0

while @Counter < @max
begin

	set @counter = @counter+1
	set @FlagID = (select flagid from @ids where idseed=@counter)
	-- Remove existing activeperiod records if any		
	Delete cfg_LkpItemsActivePeriod  where lks_lkpId = @FlagId  and lks_itemtype = 5 
	-- Create a new activeperiod record for the flag with the earliest date in the db
	insert cfg_LkpItemsActivePeriod(lks_lkpId,lks_Active,lks_itemtype,lks_datecreated)
		values (@FlagId,1,5,@date)			 

end

if @counter >0
	Print cast(@counter as varchar) + ' Active Periods backdated successfully for '+@Flagname
else 
	Print 'Flag ('+@Flagname+') not found'

go

