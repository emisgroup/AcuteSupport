WITH DupeGPs AS (
SELECT
gp_code,
gp_initials,
gp_surname,
ROW_NUMBER() OVER (PARTITION BY gp_code ORDER BY gp_code) AS rownum
FROM GP
)
SELECT gp_code [GP Code], gp_initials+' '+gp_surname [GP Name],  MAX(rownum) [Count] FROM DupeGPs
WHERE rownum>1
GROUP BY gp_code, gp_initials, gp_surname
ORDER BY [Count] desc

