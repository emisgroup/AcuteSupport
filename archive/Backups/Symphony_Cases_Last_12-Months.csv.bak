--select top 10 * from patient_indicators
--where pin_type = 7673
--and pin_indicator = 7704

--select top 10 * from Allergies_view
--where Allergy5 = 'other'

--select * from SystemProperties
--select * from Lookups where lkp_id = 9585

with hosp_nos as (
	select * from Patient_system_ids
	where psi_system_name = 9585
	)
select hosp_nos.psi_system_id as patient, pdt_EF_value as allergy, pdt_ef.* from Patient_Details_ExtraFields_View pdt_ef
join hosp_nos on psi_pid = pdt_EF_pdtpid
where pdt_EF_pdtpid in (
	select pin_pid from patient_indicators
	where pin_type = 7673
	and pin_indicator = 7704
	)
and pdt_EF_Value like '%Pen%'
and pdt_EF_Value like '%min%'

