inner join cfg_Dept on epd_deptid = dpt_id 
inner join Lookups on lkp_id = atd_location
where epd_created between '20250220 17:15:00.000' and '20250228 17:16:00.000' ----- ADD date
and atd_location <> '227' ---1113
and atd_deleted <> '1'
order by 2 desc

