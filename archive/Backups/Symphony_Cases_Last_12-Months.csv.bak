-------------------------------------------...  
--
--------------------------------------------------------------- 
 
-- Edited Attendances
--
-- Returns audit for attendances created and updated by a specific user ID, from a specific date.
--
select atd_num as 'Attendance Number',
atd_id as 'Attendance ID',
atd_arrivaldate as 'Arrival Date',
atd_createdby as 'Created By',
atd_updatedby as 'Updated By',
atd_created as 'Created Date',
atd_update as 'Updated Date'
from Aud_Attendance_Details
where atd_createdby = [Staff User ID] or atd_updatedby = [Staff User ID]
and atd_created > '[Date Range]'
order by atd_created desc
 

 
-- Patient Details Views
--
-- Returns the hospital numbers of patients the identified user has viewed.
--
select psi_system_id as 'Hospital Number',
pda_id as 'Patient Details ID',
pda_UserID as 'Staff ID',
pda_PatientID as 'Patient ID',
pda_Date as 'Date',
pda_Workstation as 'Workstation'
from patdetailsaudit
join Patient_system_ids on pda_PatientID = psi_pid
where pda_UserID = [Staff User ID]
and psi_system_name = 5548 -- Hospital number

Eview views
select psi_system_id as 'Hospital Number',
pat_surname as 'surname',
ea_UserID as 'Staff ID',
ea_PatientID as 'Patient ID',
ea_AttendanceNo as 'Attendance',
ea_Date as 'Date',
ea_Workstation as 'Workstation'
from EViewAudit
join Patient_system_ids on ea_PatientID = psi_pid
join Patient on pat_pid = ea_patientid
where ea_PatientID = 2959693
and psi_system_name = (select syp_value from SystemProperties where syp_type = 'gods number')
--nd ea_Date between '20230101'and '20240118'
order by ea_Date desc

