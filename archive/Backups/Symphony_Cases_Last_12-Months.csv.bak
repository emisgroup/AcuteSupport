;with lkp as (
	select * from Lookups_6Levels_view
	where lkp_id = 7662
	),
map_cds as (
	select * from LookupMappings
	join Notes on flm_value = not_noteid
	where flm_mtid = 6
	),
map_flag as (
	select * from LookupMappings
	join Notes on flm_value = not_noteid
	where flm_mtid = 16
	and flm_MappedType <> 2
	),
map_snomed as (
	select * from LookupMappings
	join Notes on flm_value = not_noteid
	where flm_mtid = 19
	),
map_icd10 as (
	select * from LookupMappings
	join Notes on flm_value = not_noteid
	where flm_mtid = 20
	)
	--select top  10 * forom map_flag
select
	lkp2_name grandparent, lkp3_name parent, lkp4_name lookup,
	map_cds.not_text CDS, map_snomed.not_text SNOMED, map_icd10.not_text ICD10
from lkp
left join map_cds on map_cds.flm_lkpid = lkp4_id
left join map_flag on map_flag.flm_lkpid = lkp4_id
left join map_snomed on map_snomed.flm_lkpid = lkp4_id
left join map_icd10 on map_icd10.flm_lkpid = lkp4_id
order by grandparent, parent, lookup

