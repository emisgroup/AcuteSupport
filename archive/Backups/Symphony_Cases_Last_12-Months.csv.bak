"CS1700964","North West Anglia NHS Foundation Trust","4 - Low","08/12/2025 13:39:54","Closed","Test interface ","09/12/2025 10:48:57","system","Acute Care Symphony Support Level 1","Gareth Evans","08/12/2025 17:00:25 - Gareth Evans (Work notes)
select ser_id, ser_name, ser_description

	, case ser_datamode

		when 1 then 'Dispersal'

		when 2 then 'Acquisition and Dispersal'

		else 'Acquisition'

		end as DataMode

	, case ser_deptid

		when 0 then 'System'

		else 'Department'

		end as ServiceLevel

	, case ser_status

		when 1 then 'Stopped'

		when 2 then 'Disabled'

		else 'Running'

		end as CurrentStatus

--	, con_type

	, case con_type

		when 0 then 'TCP/IP'

		when 18 then 'SOAP'

		when 9 then 'Intranet/Internet'

		when 10 then 'Clipboard'

		when 11 then 'DLL - IMS PAS'

		when 12 then 'DLL - ACHI'

		when 13 then 'DLL - Host Access'

		when 14 then 'DLL - Symphony PAS PMI'

		when 15 then 'DLL - CaMIS'

		when 16 then 'DLL - FW Messenger'

		when 17 then 'DLL - Saved Messages'

		when 19 then 'DLL - CaMIS Timeline'

		when 20 then 'DLL - ICW'

		when 21 then 'DLL - Tallaght GP Updates'

		when 22 then 'DLL - Barwick PAS'

		when 23 then 'DLL - Reflections v8'

		when 26 then 'DLL - iCM Order Comms'

		when 27 then 'DLL - SCI Gateway'

		when 33 then 'PPDSRV32'

		when 44 then 'Talk Objects'

		when 55 then 'E Biz Talk'

		when 66 then 'Direct DB Access'

		when 77 then 'Text File'

		when 88 then 'Microsoft Message Queue'

		else 'Unknown'

		end as 'Connection Type'

	, case con_type

		when 0 then isnull((select cst_value from DAD_Con_Settings where cst_parentid=ser_id and cst_typename='RemoteIP'), '')

		when 15 then isnull((select cst_value from DAD_Con_Settings where cst_parentid=ser_id and cst_typename='RemoteIP'), '')

		when 18 then ISNULL((select cst_value from dad_con_settings where cst_parentid=ser_id and cst_typename='WSDL Filename'), '')

		else ''

		end as 'Target Address'

	, isnull((select cst_value from DAD_Con_Settings where cst_parentid=ser_id and cst_typename='Port'), '') as [Port]

	, case (select cst_value from DAD_Con_Settings where cst_parentid=ser_id and cst_typename='QueueImmediately')

		when 0 then 'False'

		when 1 then 'True'

		else ''

		end as [QueueImmediately]

	, isnull((select cst_value from DAD_Con_Settings where cst_parentid=ser_id and cst_typename='TCPIPConnRetries'), '') as [ConnectionRetries]

	, isnull((select cst_value from DAD_Con_Settings where cst_parentid=ser_id and cst_typename='TCPIPConnTimeout'), '') as [ConnectionTimeout]

from dad_services

	inner join DAD_Ser_Connect on ser_id=con_serviceid

	where ser_id>0

