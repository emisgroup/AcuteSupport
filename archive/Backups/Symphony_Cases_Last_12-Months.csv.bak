06/01/2026 15:38:21 - Shazad Ishaque (Work notes)
Ran the reindexing script below:

SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;

SELECT 'alter index ',ind.name AS IndexName, ' on '

,OBJECT_NAME(ind.OBJECT_ID) AS TableName, ' rebuild'

,indexstats.index_type_desc AS IndexType

,indexstats.avg_fragmentation_in_percent

,indexstats.page_count

FROM sys.dm_db_index_physical_stats(DB_ID(), NULL, NULL, NULL, NULL) indexstats

INNER JOIN sys.indexes ind

ON ind.object_id = indexstats.object_id

AND ind.index_id = indexstats.index_id

WHERE indexstats.avg_fragmentation_in_percent > 3 ---You can specify the percent as you want

AND indexstats.page_count > 400 --Minimum number of pages

AND OBJECT_NAME(ind.OBJECT_ID) like '%mid%'

--and indexstats.index_type_desc <> 'HEAP'

ORDER BY page_count desc--indexstats.avg_fragmentation_in_percent DESC

OPTION (MAXDOP 1)



alter index
IX__Midas__Mid_contextid
on dbo.midas rebuild


alter index
IX__MIDAs__mid_date
on dbo.midas rebuild

 
alter index
IX__MIDAS__mid_deleted
on dbo.midas rebuild



alter index
IX__MIDAS__mid_link
on dbo.midas rebuild


alter index
IX__MIDAS__mid_link_mid_number
on dbo.midas rebuild


alter index
IX__Midas__Mid_contextid
on dbo.midas rebuild


alter index
IX__MIDAs__mid_imagepath
on dbo.midas rebuild

