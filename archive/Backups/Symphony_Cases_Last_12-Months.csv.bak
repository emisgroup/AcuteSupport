with destinations as (
	select lk1.* from Lookups lk1
	where Lkp_ParentID in (
		select Lkp_ID from Lookups
		where Lkp_ParentID = 5682
	)
)
select
	--flm_id map_id, flm_description mapping, destinations.lkp_id dest_id, destinations.Lkp_Name destination, notes.not_text pas_code, *
	destinations.Lkp_Name destination, parent.Lkp_Name parent, notes.not_text pas_code
from LookupMappings
join destinations on flm_lkpid = Lkp_ID
join lookups parent on destinations.Lkp_ParentID = parent.Lkp_ID
join notes on flm_value = notes.not_noteid
where flm_mtid = 4

